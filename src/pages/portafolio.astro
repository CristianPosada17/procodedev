---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import Portfolio from "../components/Portfolio.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Testimonials from "../components/Testimonials.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import { translations } from "../i18n/ui";

const lang = "es";
const t = translations[lang];
const meta = t.pageMeta.portfolio;
---

<Layout lang={lang} page="portfolio" title={meta.title} description={meta.description}>
  <Header lang={lang} page="portfolio" />
  <main>
    <PageHero
      eyebrow={t.portfolio.eyebrow}
      titleA={meta.heroTitleA}
      highlight={meta.heroHighlight}
      subtitle={meta.heroSubtitle}
    />
    <Portfolio lang={lang} />
    <CaseStudy lang={lang} />
    <Testimonials lang={lang} />
    <FinalCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
