---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import LandingHero from "../components/LandingHero.astro";
import VisualPricing from "../components/hero-visuals/VisualPricing.astro";
import Pricing from "../components/Pricing.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import Footer from "../components/Footer.astro";
import { translations, PAGES, relatedLinks } from "../i18n/ui";

const lang = "es";
const t = translations[lang];
const meta = t.pageMeta.pricing;
// Catálogo del JSON-LD alineado con lo visible: cada importe es un precio
// base («Desde») con su periodicidad; los planes sin cifra van sin precio.
const pr = t.pricing;
const offerCatalog = [
  ...pr.packages.map((x) => ({
    title: `${x.name} — ${x.pricePrefix} $${x.price} ${x.currency}`,
    description: x.description,
    minPrice: x.price,
    unit: "one-time" as const,
  })),
  ...pr.monthly.map((x) =>
    x.quoteLabel
      ? { title: `${x.name} — ${x.quoteLabel}`, description: x.description }
      : {
          title: `${x.name} — ${x.pricePrefix} $${x.price} ${x.currency}`,
          description: x.description,
          minPrice: x.price,
          unit: "month" as const,
        },
  ),
  ...pr.extras.map((x) => ({
    title: `${x.name} — ${x.price} ${x.unit}`,
    description: x.description,
    minPrice: x.price.replace(/[^0-9.]/g, ""),
    unit: "one-time" as const,
  })),
];
---

<Layout
  lang={lang}
  page="pricing"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  includeFaq={true}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.pricing, path: PAGES.pricing[lang] },
  ]}
  serviceName="Diseño y desarrollo de páginas web"
  offerCatalog={offerCatalog}
>
  <Header lang={lang} page="pricing" />
  <main>
    <LandingHero
      lang={lang}
      page="pricing"
      eyebrow={t.nav.pricing}
      icon="receipt"
      titleA={meta.heroTitleA}
      highlight={meta.heroHighlight}
      subtitle={meta.heroSubtitle}
      lead={meta.heroLead}
      stats={[
        { label: lang === "es" ? "Proyectos web" : "Web projects", value: `${t.priceAnchor.fromLabel} $349`, note: lang === "es" ? "USD · pago único" : "USD · one-time" },
        { label: lang === "es" ? "Planes mensuales" : "Monthly plans", value: `${t.priceAnchor.fromLabel} $79`, note: lang === "es" ? "USD · al mes" : "USD · per month" },
      ]}
    >
      <VisualPricing slot="visual" lang={lang} />
    </LandingHero>
    <Pricing lang={lang} showHeading={false} />
    <FAQ lang={lang} />
    <RelatedLinks data={relatedLinks[lang].pricing} />
    <FinalCTA lang={lang} page="pricing" />
  </main>
  <Footer lang={lang} />
</Layout>
