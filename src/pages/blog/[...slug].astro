---
import BlogArticle from "../../components/BlogArticle.astro";
import { getCollection } from "astro:content";

// La plantilla vive en BlogArticle.astro (compartida con /en/blog/). Aquí
// solo se generan las rutas y se busca si el artículo tiene versión en
// inglés, para emitir los hreflang de los dos.
export async function getStaticPaths() {
  const [posts, enPosts] = await Promise.all([getCollection("blog"), getCollection("blogEn")]);
  return posts.map((post) => {
    const en = enPosts.find((p) => p.data.translationOf === post.id);
    return {
      params: { slug: post.id },
      props: { post, altPath: en ? `/en/blog/${en.id}/` : undefined },
    };
  });
}

const { post, altPath } = Astro.props;
---

<BlogArticle lang="es" post={post} altPath={altPath} />
