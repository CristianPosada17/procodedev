---
/*
  HUB /en/services/ — presenta las dos líneas y reparte el enlace interno
  hacia /en/services/web-development/ y /en/services/digital-marketing/.

  Intención que persigue: "servicios de desarrollo web y marketing digital".
  El home se queda con "diseño de páginas web para negocios" y cada hija con
  la suya, así que las tres no compiten entre ellas.

  Reestructurado en septiembre de 2026: el bloque de entrada ya no solo
  explica la oferta, ahora ofrece un camino («quiero una recomendación») sin
  salir de la página; los tres caminos van antes que el detalle de cada
  línea, porque la duda real de quien llega aquí es cuál de los dos necesita;
  el portafolio entra como prueba; y el formulario corto cierra la página.
  Salieron `Integrations` y `WhyProCode`: el espacio que se iba en justificar
  por qué solo hay dos servicios ahora contesta «cuál necesito y qué obtengo».
*/
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceCompare from "../../components/ServiceCompare.astro";
import ServiceLines from "../../components/ServiceLines.astro";
import AuditCallout from "../../components/AuditCallout.astro";
import Portfolio from "../../components/Portfolio.astro";
import Process from "../../components/Process.astro";
import FAQ from "../../components/FAQ.astro";
import ServiceLeadForm from "../../components/ServiceLeadForm.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import PageContext from "../../components/PageContext.astro";
import Footer from "../../components/Footer.astro";
import { translations, PAGES } from "../../i18n/ui";
import { serviceLines, servicesHub, SERVICE_KEYS } from "../../i18n/services";

const lang = "en";
const t = translations[lang];
const meta = t.pageMeta.services;
const hub = servicesHub[lang];

// Nodo ItemList: le dice al buscador que esta página es un índice de dos
// servicios y no una landing más, igual que hace /negocios con los giros.
const itemList = SERVICE_KEYS.map((key) => ({
  name: serviceLines[lang][key].title,
  description: serviceLines[lang][key].summary,
  url: PAGES[key][lang],
}));

// hasOfferCatalog del nodo Service: las doce capacidades de las dos líneas.
const offerCatalog = SERVICE_KEYS.flatMap((key) =>
  serviceLines[lang][key].capabilities.map((c) => ({
    title: c.title,
    description: c.description,
  })),
);
---

<Layout
  lang={lang}
  page="services"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.services, path: PAGES.services[lang] },
  ]}
  serviceName="Web development and digital marketing for small businesses"
  offerCatalog={offerCatalog}
  itemList={itemList}
  includeFaq={true}
  faqItems={hub.faq.items}
>
  <Header lang={lang} page="services" />
  <main>
    {/* Propuesta de valor y, en el mismo bloque, la forma de pedir ayuda. */}
    <PageHero
      lang={lang}
      eyebrow={t.services.eyebrow}
      titleA={meta.heroTitleA}
      highlight={meta.heroHighlight}
      subtitle={meta.heroSubtitle}
      ctaLabel={hub.form.ctaLabel}
      ctaHref="#solicitar"
      ctaId="hub-servicios-solicitar"
      ctaSecondaryLabel={t.common.ctaPrimary}
      ctaSecondaryHref={PAGES.contact[lang]}
    />

    {/* Primero cuál necesitas (con «ayúdame a elegir» como tercer camino),
        después qué obtienes con cada uno. */}
    <ServiceCompare lang={lang} />

    {/* La tercera salida para quien sigue sin saber cuál necesita: el
        formulario de abajo es la gratuita, esta es la de pago. */}
    <AuditCallout lang={lang} />

    <ServiceLines lang={lang} variant="hub" />

    {/* Prueba antes que proceso: proyectos reales que se pueden abrir. */}
    <Portfolio lang={lang} />
    <Process lang={lang} />
    <FAQ lang={lang} data={hub.faq} />

    <ServiceLeadForm
      lang={lang}
      heading={hub.form}
      service="Web development and digital marketing for small businesses"
      page="services"
    />
    <FinalCTA lang={lang} />
    <PageContext data={t.pageContext.services} />
  </main>
  <Footer lang={lang} />
</Layout>
