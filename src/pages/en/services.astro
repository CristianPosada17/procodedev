---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/PageHero.astro";
import Services from "../../components/Services.astro";
import Process from "../../components/Process.astro";
import Integrations from "../../components/Integrations.astro";
import WhyProCode from "../../components/WhyProCode.astro";
import FreeAudit from "../../components/FreeAudit.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import Footer from "../../components/Footer.astro";
import { translations } from "../../i18n/ui";

const lang = "en";
const t = translations[lang];
const meta = t.pageMeta.services;
---

<Layout lang={lang} page="services" title={meta.title} description={meta.description}>
  <Header lang={lang} page="services" />
  <main>
    <PageHero
      eyebrow={t.services.eyebrow}
      titleA={meta.heroTitleA}
      highlight={meta.heroHighlight}
      subtitle={meta.heroSubtitle}
    />
    <Services lang={lang} />
    <Process lang={lang} />
    <Integrations lang={lang} />
    <WhyProCode lang={lang} />
    <FreeAudit lang={lang} />
    <FinalCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
