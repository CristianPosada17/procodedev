---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SegmentPage from "../../components/SegmentPage.astro";
import Footer from "../../components/Footer.astro";
import { translations, PAGES, NICHE_PARENT } from "../../i18n/ui";
import { getSegment } from "../../i18n/segments";

// Página de nicho: el contenido vive en src/i18n/niches.ts.
const lang = "en";
const key = "dentists" as const;
const parent = NICHE_PARENT[key];
const t = translations[lang];
const seg = getSegment(lang, key);
---

<Layout
  lang={lang}
  page={key}
  waPage="sectors"
  title={seg.meta.title}
  description={seg.meta.description}
  includeFaq={true}
  faqItems={seg.faq}
  serviceName={seg.intro}
  keywords={seg.meta.keywords}
  offerCatalog={seg.system}
  audience={seg.navLabel}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.sectors, path: PAGES.sectors[lang] },
    { name: getSegment(lang, parent).navLabel, path: PAGES[parent][lang] },
    { name: seg.navLabel, path: PAGES[key][lang] },
  ]}
>
  <Header lang={lang} page={key} />
  <main>
    <SegmentPage lang={lang} segment={key} />
  </main>
  <Footer lang={lang} />
</Layout>
