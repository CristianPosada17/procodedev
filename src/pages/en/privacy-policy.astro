---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import LegalPage from "../../components/LegalPage.astro";
import Footer from "../../components/Footer.astro";
import { legal } from "../../i18n/legal";
import { translations, PAGES } from "../../i18n/ui";

const lang = "en";
const doc = "privacy" as const;
const d = legal[lang][doc];
const t = translations[lang];
---

<Layout
  lang={lang}
  page="privacy"
  waPage="contact"
  title={d.meta.title}
  description={d.meta.description}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: d.title, path: PAGES.privacy[lang] },
  ]}
>
  <Header lang={lang} page="privacy" />
  <main>
    <LegalPage lang={lang} doc={doc} />
  </main>
  <Footer lang={lang} />
</Layout>
