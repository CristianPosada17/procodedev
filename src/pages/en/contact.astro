---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/PageHero.astro";
import Calendly from "../../components/Calendly.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import { translations, PAGES } from "../../i18n/ui";

const lang = "en";
const t = translations[lang];
const meta = t.pageMeta.contact;
---

<Layout lang={lang} page="contact" title={meta.title} description={meta.description} keywords={meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.contact, path: PAGES.contact[lang] },
  ]}
>
  <Header lang={lang} page="contact" />
  <main>
    <PageHero
      eyebrow={t.calendly.eyebrow}
      titleA={meta.heroTitleA}
      highlight={meta.heroHighlight}
      subtitle={meta.heroSubtitle}
    />
    <Calendly lang={lang} showHeading={false} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
