---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import LandingHero from "../../components/LandingHero.astro";
import VisualPortfolio from "../../components/hero-visuals/VisualPortfolio.astro";
import Portfolio from "../../components/Portfolio.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import Testimonials from "../../components/Testimonials.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Footer from "../../components/Footer.astro";
import { translations, PAGES, relatedLinks } from "../../i18n/ui";

const lang = "en";
const t = translations[lang];
const meta = t.pageMeta.portfolio;
---

<Layout lang={lang} page="portfolio" title={meta.title} description={meta.description} keywords={meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.portfolio, path: PAGES.portfolio[lang] },
  ]}
>
  <Header lang={lang} page="portfolio" />
  <main>
    <LandingHero
      lang={lang}
      page="portfolio"
      eyebrow={t.nav.portfolio}
      icon="star"
      titleA={meta.heroTitleA}
      highlight={meta.heroHighlight}
      subtitle={meta.heroSubtitle}
      lead={t.proof.subtitle}
      stats={[
        { label: lang === "es" ? "Clientes en" : "Clients in", value: lang === "es" ? "2 países" : "2 countries", note: lang === "es" ? "EE. UU. y México" : "US & Mexico" },
      ]}
    >
      <VisualPortfolio slot="visual" lang={lang} />
    </LandingHero>
    <Portfolio lang={lang} showHeading={false} />
    <CaseStudy lang={lang} />
    <Testimonials lang={lang} />
    <RelatedLinks data={relatedLinks[lang].portfolio} />
    <FinalCTA lang={lang} page="portfolio" />
  </main>
  <Footer lang={lang} />
</Layout>
