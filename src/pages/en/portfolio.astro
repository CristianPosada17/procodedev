---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PortfolioHero from "../../components/PortfolioHero.astro";
import PortfolioShowcase from "../../components/PortfolioShowcase.astro";
import ClientLogos from "../../components/ClientLogos.astro";
import PortfolioIndustries from "../../components/PortfolioIndustries.astro";
import Testimonials from "../../components/Testimonials.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import LeadForm from "../../components/LeadForm.astro";
import Footer from "../../components/Footer.astro";
import { translations, PAGES, relatedLinks } from "../../i18n/ui";

const lang = "en";
const t = translations[lang];
const meta = t.pageMeta.portfolio;
const p = t.portfolio;
---

{/*
  Portafolio (octubre de 2026), pensado para generar confianza y ventas:
  1 hero breve · 2 todos los proyectos · 3 logos de clientes ·
  4 detalle por industria · 5 testimonios · 6 formulario simple.
  El caso de Mi Conta Universal que antes iba aparte (CaseStudy) quedó
  dentro de su industria, con el mismo nivel de detalle que los demás.
*/}
<Layout lang={lang} page="portfolio" title={meta.title} description={meta.description} keywords={meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.portfolio, path: PAGES.portfolio[lang] },
  ]}
>
  <Header lang={lang} page="portfolio" />
  <main>
    <PortfolioHero lang={lang} />
    <PortfolioShowcase lang={lang} />
    <ClientLogos lang={lang} />
    <PortfolioIndustries lang={lang} />
    <Testimonials lang={lang} />
    <RelatedLinks data={relatedLinks[lang].portfolio} />
    <LeadForm
      lang={lang}
      page="portfolio"
      simple
      heading={{
        eyebrow: p.formEyebrow,
        titleA: p.formTitleA,
        titleHighlight: p.formHighlight,
        subtitle: p.formSubtitle,
      }}
    />
  </main>
  <Footer lang={lang} />
</Layout>
