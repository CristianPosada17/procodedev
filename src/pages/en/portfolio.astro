---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/PageHero.astro";
import Portfolio from "../../components/Portfolio.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import Testimonials from "../../components/Testimonials.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import PageContext from "../../components/PageContext.astro";
import Footer from "../../components/Footer.astro";
import { translations, PAGES } from "../../i18n/ui";

const lang = "en";
const t = translations[lang];
const meta = t.pageMeta.portfolio;
---

<Layout lang={lang} page="portfolio" title={meta.title} description={meta.description} keywords={meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.portfolio, path: PAGES.portfolio[lang] },
  ]}
>
  <Header lang={lang} page="portfolio" />
  <main>
    <PageHero
      eyebrow={t.portfolio.eyebrow}
      titleA={meta.heroTitleA}
      highlight={meta.heroHighlight}
      subtitle={meta.heroSubtitle}
    />
    <Portfolio lang={lang} showHeading={false} />
    <CaseStudy lang={lang} />
    <Testimonials lang={lang} />
    <FinalCTA lang={lang} />
    <PageContext data={t.pageContext.portfolio} />
  </main>
  <Footer lang={lang} />
</Layout>
