---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PageHero from "../../components/PageHero.astro";
import Pricing from "../../components/Pricing.astro";
import FAQ from "../../components/FAQ.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Footer from "../../components/Footer.astro";
import { translations, PAGES, relatedLinks } from "../../i18n/ui";

const lang = "en";
const t = translations[lang];
const meta = t.pageMeta.pricing;
---

<Layout
  lang={lang}
  page="pricing"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  includeFaq={true}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.pricing, path: PAGES.pricing[lang] },
  ]}
  serviceName={meta.heroSubtitle}
>
  <Header lang={lang} page="pricing" />
  <main>
    <PageHero
      eyebrow={t.pricing.eyebrow}
      titleA={meta.heroTitleA}
      highlight={meta.heroHighlight}
      subtitle={meta.heroSubtitle}
    />
    <Pricing lang={lang} showHeading={false} />
    <FAQ lang={lang} />
    <RelatedLinks data={relatedLinks[lang].pricing} />
    <FinalCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
