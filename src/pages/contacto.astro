---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import LandingHero from "../components/LandingHero.astro";
import VisualContact from "../components/hero-visuals/VisualContact.astro";
import Calendly from "../components/Calendly.astro";
import LeadForm from "../components/LeadForm.astro";
import Footer from "../components/Footer.astro";
import { translations, PAGES, conversionHref } from "../i18n/ui";

const lang = "es";
const t = translations[lang];
const meta = t.pageMeta.contact;
---

<!--
  Hallazgo #2 (crítico): ~40 CTAs del sitio dicen «Agendar llamada gratis» y
  apuntan aquí, pero el calendario estaba en y=2272 de una página de 5069px
  móvil — 2.8 pantallas de scroll entre la promesa y su cumplimiento.
  Septiembre de 2026: el calendario dejó de ir primero. Agendar una llamada
  es el paso más caro para quien todavía está comparando proveedores, así
  que ahora abre el formulario corto —abierto, no colapsado— y el Calendly
  va justo debajo, con su propio encabezado, para quien prefiera hablar.
  Sigue sin haber FinalCTA: mandaba a /contacto desde /contacto.
-->
<Layout lang={lang} page="contact" title={meta.title} description={meta.description} keywords={meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.contact, path: PAGES.contact[lang] },
  ]}
>
  <Header lang={lang} page="contact" />
  <main>
    <LandingHero
      lang={lang}
      page="contact"
      eyebrow={t.nav.contact}
      icon="calendar"
      titleA={meta.heroTitleA}
      highlight={meta.heroHighlight}
      subtitle={meta.heroSubtitle}
      lead={t.calendly.subtitle}
      stats={[{ label: lang === "es" ? "Respuesta" : "Reply", value: "< 24 h" }, { label: t.nav.cta, value: "20 min", note: lang === "es" ? "sin costo" : "free" }]}
    >
      <VisualContact slot="visual" lang={lang} />
    </LandingHero>
    <LeadForm lang={lang} page="contact" />
    <Calendly lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
