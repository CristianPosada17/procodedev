---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import GrowthSystem from "../components/GrowthSystem.astro";
import Services from "../components/Services.astro";
import PriceAnchor from "../components/PriceAnchor.astro";
import WhyProCode from "../components/WhyProCode.astro";
import ProofStrip from "../components/ProofStrip.astro";
import Founder from "../components/Founder.astro";
import Integrations from "../components/Integrations.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import { translations } from "../i18n/ui";

const lang = "es";
const meta = translations[lang].pageMeta.home;
---

<Layout
  lang={lang}
  page="home"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  includeFaq={true}
  faqVariant="home"
>
  <Header lang={lang} page="home" />
  <main class="home-flow">
    <Hero lang={lang} />
    <Marquee lang={lang} />
    <GrowthSystem lang={lang} />
    <Services lang={lang} />
    <PriceAnchor lang={lang} />
    <WhyProCode lang={lang} />
    <ProofStrip lang={lang} />
    <Founder lang={lang} />
    <Integrations lang={lang} />
    <Testimonials lang={lang} />
    <FAQ lang={lang} variant="home" />
    <FinalCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<style is:global>
  /*
    Solo móvil: la franja de proyectos reales sube justo después de la tira de
    valores, para que la primera evidencia visual aparezca en la segunda
    pantalla en vez de la sexta. A partir de lg el flex se apaga y el orden
    vuelve exactamente al del DOM, así que el escritorio no cambia.
  */
  @media (max-width: 1023px) {
    main.home-flow {
      display: flex;
      flex-direction: column;
    }
    /* Evita que un hijo con contenido ancho (la tira animada) desborde. */
    main.home-flow > * {
      min-width: 0;
    }
    main.home-flow > #trabajo {
      order: 1;
    }
    main.home-flow > #sistema {
      order: 2;
    }
    main.home-flow > #servicios {
      order: 3;
    }
    main.home-flow > #inversion {
      order: 4;
    }
    main.home-flow > #por-que {
      order: 5;
    }
    main.home-flow > #quien {
      order: 6;
    }
    main.home-flow > #integraciones {
      order: 7;
    }
    main.home-flow > #testimonios {
      order: 8;
    }
    main.home-flow > #dudas {
      order: 9;
    }
    main.home-flow > #final-cta {
      order: 10;
    }
  }
</style>
