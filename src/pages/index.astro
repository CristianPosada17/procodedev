---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import ValueStrip from "../components/ValueStrip.astro";
import Services from "../components/Services.astro";
import PriceAnchor from "../components/PriceAnchor.astro";
import WhyProCode from "../components/WhyProCode.astro";
import ProofStrip from "../components/ProofStrip.astro";
import Founder from "../components/Founder.astro";
import Integrations from "../components/Integrations.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import { translations } from "../i18n/ui";

const lang = "es";
const meta = translations[lang].pageMeta.home;
---

<!--
  Auditoría CRO (agosto 2026):
  #4  Entra ProofStrip con 3 proyectos reales y sale CaseStudy, que ilustraba
      sin probar.
  #10 Entra PriceAnchor con el «desde $349 USD».
  #18 Entra el FAQ de objeciones justo antes del CTA final.

  Análisis de mercado (agosto 2026):
  · Única puerta de entrada: la llamada gratis de 15 min. El Diagnóstico de
    $149 vive solo en /precios como paso 2; fuera AdvisoryBanner y FreeAudit.
  · El H1 nombra al cliente y al oficio (despachos de impuestos en EE. UU.)
    en vez del genérico «sitios web que hacen crecer tu negocio».
-->
<Layout lang={lang} page="home" title={meta.title} description={meta.description}>
  <Header lang={lang} page="home" />
  <main class="home-flow">
    <Hero lang={lang} />
    <Marquee lang={lang} />
    <ValueStrip lang={lang} />
    <Services lang={lang} />
    <PriceAnchor lang={lang} />
    <WhyProCode lang={lang} />
    <ProofStrip lang={lang} />
    <Founder lang={lang} />
    <Integrations lang={lang} />
    <Testimonials lang={lang} />
    <FAQ lang={lang} variant="home" />
    <FinalCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<style is:global>
  /*
    Solo móvil: la franja de proyectos reales sube justo después de la tira de
    valores, para que la primera evidencia visual aparezca en la segunda
    pantalla en vez de la sexta. A partir de lg el flex se apaga y el orden
    vuelve exactamente al del DOM, así que el escritorio no cambia.
  */
  @media (max-width: 1023px) {
    main.home-flow {
      display: flex;
      flex-direction: column;
    }
    /* Evita que un hijo con contenido ancho (la tira animada) desborde. */
    main.home-flow > * {
      min-width: 0;
    }
    main.home-flow > #trabajo {
      order: 1;
    }
    main.home-flow > #servicios {
      order: 2;
    }
    main.home-flow > #inversion {
      order: 3;
    }
    main.home-flow > #por-que {
      order: 4;
    }
    main.home-flow > #quien {
      order: 5;
    }
    main.home-flow > #integraciones {
      order: 6;
    }
    main.home-flow > #testimonios {
      order: 7;
    }
    main.home-flow > #dudas {
      order: 8;
    }
    main.home-flow > #final-cta {
      order: 9;
    }
  }
</style>
