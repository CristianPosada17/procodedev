---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import ValueStrip from "../components/ValueStrip.astro";
import Services from "../components/Services.astro";
import AdvisoryBanner from "../components/AdvisoryBanner.astro";
import WhyProCode from "../components/WhyProCode.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Integrations from "../components/Integrations.astro";
import Testimonials from "../components/Testimonials.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import { translations } from "../i18n/ui";

const lang = "es";
const meta = translations[lang].pageMeta.home;
---

<Layout lang={lang} page="home" title={meta.title} description={meta.description}>
  <Header lang={lang} page="home" />
  <main>
    <Hero lang={lang} />
    <Marquee lang={lang} />
    <ValueStrip lang={lang} />
    <Services lang={lang} />
    <AdvisoryBanner lang={lang} />
    <WhyProCode lang={lang} />
    <CaseStudy lang={lang} />
    <Integrations lang={lang} />
    <Testimonials lang={lang} />
    <FinalCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
