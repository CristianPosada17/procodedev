---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ClientLogos from "../components/ClientLogos.astro";
import GrowthSystem from "../components/GrowthSystem.astro";
import WhyProCode from "../components/WhyProCode.astro";
import Process from "../components/Process.astro";
import CaseStudy from "../components/CaseStudy.astro";
import ProofStrip from "../components/ProofStrip.astro";
import Testimonials from "../components/Testimonials.astro";
import ServiceFit from "../components/ServiceFit.astro";
import Founder from "../components/Founder.astro";
import ServiceLines from "../components/ServiceLines.astro";
import PriceAnchor from "../components/PriceAnchor.astro";
import Integrations from "../components/Integrations.astro";
import FAQ from "../components/FAQ.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import LandingConversion from "../components/LandingConversion.astro";
import Footer from "../components/Footer.astro";
import { translations, relatedLinks } from "../i18n/ui";
import { serviceDetails } from "../i18n/services";

const lang = "es";
const meta = translations[lang].pageMeta.home;
---

{/*
  Estructura común de la página principal y las landings (sep 2026):
  1 hero · 2 beneficios · 3 cómo se trabaja (+ proyectos) · 4 testimonios ·
  5 para quién es · 6 fundador · 7 información práctica · 8 preguntas ·
  9 cierre con agenda (#agendar) y formulario (#contacto).
  «Para quién es» reutiliza el filtro de Desarrollo Web: es el servicio de
  entrada del home (landing desde $349) y su copy ya está publicado.
*/}
<Layout
  lang={lang}
  page="home"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  includeFaq={true}
  faqVariant="home"
>
  <Header lang={lang} page="home" />
  <main>
    {/* 1 · Hero + clientes reales */}
    <Hero lang={lang} />
    <ClientLogos lang={lang} />

    {/* 2 · Beneficios */}
    <GrowthSystem lang={lang} />
    <WhyProCode lang={lang} />

    {/* 3 · Así es como se trabaja, con proyectos reales */}
    <Process lang={lang} />
    <CaseStudy lang={lang} variant="home" />
    <ProofStrip lang={lang} />

    {/* 4 · Testimonios publicados */}
    <Testimonials lang={lang} />

    {/* 5 · Para quién es y para quién no */}
    <ServiceFit lang={lang} fit={serviceDetails[lang].webDev.fit} />

    {/* 6 · El desarrollador y fundador */}
    <Founder lang={lang} page="home" />

    {/* 7 · Información práctica: qué incluye, inversión, herramientas */}
    <ServiceLines lang={lang} />
    <PriceAnchor lang={lang} />
    <Integrations lang={lang} />

    {/* 8 · Preguntas frecuentes */}
    <FAQ lang={lang} variant="home" />
    <RelatedLinks data={relatedLinks[lang].home} />

    {/* 9 · Cierre: agenda y formulario en esta misma página */}
    <LandingConversion lang={lang} page="home" />
  </main>
  <Footer lang={lang} />
</Layout>
