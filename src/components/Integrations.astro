---
import { translations, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import CardRail from "./CardRail.astro";
import MiniUI from "./MiniUI.astro";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const ig = t.integrations;
---

<section id="integraciones" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <SectionHeading eyebrow={ig.eyebrow} align="center" max="max-w-2xl">
      <Fragment slot="title">{ig.title}</Fragment>
      <Fragment slot="subtitle">{ig.subtitle}</Fragment>
    </SectionHeading>

    {/* Son cuatro herramientas: rejilla de cuatro columnas, centrada y con
        ancho máximo. Con seis columnas quedaban dos huecos a la derecha. */}
    <div class="relative mx-auto mt-10 max-w-6xl lg:mt-14">
    <span class="flow-line pointer-events-none absolute inset-x-[8%] top-[4.5rem] hidden h-px bg-[color:var(--border)] lg:block" aria-hidden="true"></span>
    <CardRail grid="md:grid-cols-2 lg:grid-cols-4" peek="normal" gap="gap-4 lg:gap-6">
      {
        ig.items.map((it, i) => (
          <div
            class="card-pro reveal flex flex-col gap-4 rounded-[var(--radius)] p-4 text-center"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <MiniUI kind={it.icon} />
            <div class="px-1 pb-2">
              <h3 class="text-base font-bold text-[var(--text)]">{it.name}</h3>
              <p class="mt-1 text-sm leading-5 text-[var(--muted)]">{it.description}</p>
            </div>
          </div>
        ))
      }
    </CardRail>
    </div>
  </div>
</section>
