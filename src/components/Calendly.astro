---
// Sección de agendamiento con Calendly.
// Arriba: título + texto (centrado). Centro: widget de Calendly (código oficial,
// link directo del evento). Abajo: botones de contacto más grandes.
---

<section id="agendar" class="relative pt-10 pb-16 lg:pt-12 lg:pb-20">
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <!-- ===== Texto arriba (centrado) ===== -->
    <div class="reveal mx-auto max-w-4xl text-center">
      <div
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-blue-300/30 bg-blue-500/15 px-4 py-2 text-xs font-bold uppercase tracking-[0.22em] text-blue-200"
      >
        🗓️ Agenda en línea
      </div>

      <h2
        class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:whitespace-nowrap lg:text-5xl"
      >
        Reserva tu
        <span
          class="bg-gradient-to-r from-blue-400 via-blue-500 to-cyan-300 bg-clip-text text-transparent"
        >
          diagnóstico gratuito
        </span>
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
        Elige el día y la hora que mejor te acomoden. Es una llamada corta, sin
        compromiso, para revisar tu negocio y ver cómo tu web puede ayudarte a
        captar más clientes.
      </p>

      <!-- Beneficios en fila -->
      <div
        class="mt-7 flex flex-wrap items-center justify-center gap-2.5 text-sm"
      >
        <span
          class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-slate-200"
        >
          <span class="text-blue-300">✓</span> Gratis y sin compromiso
        </span>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-slate-200"
        >
          <span class="text-blue-300">⏱️</span> Llamada corta, al grano
        </span>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-slate-200"
        >
          <span class="text-blue-300">💬</span> Atención directa
        </span>
      </div>
    </div>

    <!-- ===== Widget de Calendly (centro) ===== -->
    <div
      class="reveal mt-8 overflow-hidden rounded-2xl"
      style="--reveal-delay: 120ms"
    >
      <!-- Principio del widget integrado de Calendly -->
      <div
        class="calendly-inline-widget"
        data-url="https://calendly.com/procodedev/meeting-procode"
        style="min-width:320px;height:700px;"
      >
      </div>
      <script
        is:inline
        type="text/javascript"
        src="https://assets.calendly.com/assets/external/widget.js"
        async></script>
      <!-- Final del widget integrado de Calendly -->
    </div>

    <!-- ===== Botones abajo (más grandes, centrados) ===== -->
    <div class="reveal mt-8 flex flex-col items-center gap-5 text-center">
      <p class="text-base text-slate-300">
        ¿Prefieres escribirnos antes de agendar?
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="https://wa.me/526142414255"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-400/40 bg-emerald-500/10 px-8 py-4 text-base font-bold text-white transition hover:border-emerald-300/70 hover:bg-emerald-500/20"
        >
          <span>💬</span> Escríbenos por WhatsApp
        </a>
        <a
          href="#contacto"
          class="inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-8 py-4 text-base font-bold text-white transition hover:border-blue-300/50 hover:bg-blue-500/10"
        >
          Enviar un mensaje
        </a>
      </div>
    </div>
  </div>
</section>
