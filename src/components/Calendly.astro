---
import { translations, CONTACT, type Lang } from "../i18n/ui";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const cal = t.calendly;
---

<section id="agendar" class="relative py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div class="reveal mx-auto max-w-3xl text-center">
      <span class="eyebrow">{cal.eyebrow}</span>
      <h2 class="mt-5 text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl lg:text-5xl">
        {cal.titleA}{" "}<span class="grad-text">{cal.titleHighlight}</span>
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-[var(--muted)]">
        {cal.subtitle}
      </p>
    </div>

    <div
      class="reveal mt-10 overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/60 p-2 backdrop-blur-xl"
    >
      <div
        class="calendly-inline-widget rounded-[1.25rem] overflow-hidden"
        data-url={`${CONTACT.calendly}?hide_gdpr_banner=1&background_color=0d1730&text_color=f1f5f9&primary_color=2563eb`}
        style="min-width:320px;height:680px;"
      >
      </div>
      <script
        type="text/javascript"
        src="https://assets.calendly.com/assets/external/widget.js"
        async></script>
    </div>
  </div>
</section>
