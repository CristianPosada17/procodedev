---
import { translations, PAGES, waHref, type Lang, type PageKey } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  lang?: Lang;
  page?: PageKey | "blog";
}
const { lang = "es", page = "home" } = Astro.props as Props;
const t = translations[lang];

// El 80% del tráfico es móvil y ahí el header no muestra ningún CTA (queda
// escondido tras el menú hamburguesa). Con un home de ~20 pantallas, la acción
// tiene que estar disponible siempre, no solo donde el scroll la deposite.
// Solo móvil: en lg+ el header ya tiene su botón y el FAB flotante.
const waLabel = lang === "es" ? "WhatsApp" : "WhatsApp";
const waAria = lang === "es" ? "Escríbeme por WhatsApp" : "Message me on WhatsApp";
---

<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-[color:var(--border-strong)] bg-[var(--bg)]/95 backdrop-blur-xl lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="flex items-center gap-2.5 px-4 py-3">
    <a
      href={PAGES.contact[lang]}
      class="inline-flex min-h-[52px] flex-1 items-center justify-center rounded-xl bg-[var(--brand)] px-5 text-sm font-bold text-white shadow-[0_0_35px_rgba(37,99,235,0.35)] transition active:scale-[0.98]"
    >
      {t.nav.cta}
      <Icon name="arrow-right" class="ml-2 h-4 w-4" />
    </a>

    <a
      href={waHref(page, lang)}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={waAria}
      class="inline-flex h-[52px] w-[52px] flex-none items-center justify-center rounded-xl bg-emerald-500 text-white transition active:scale-[0.98]"
    >
      <Icon name="whatsapp" class="h-6 w-6" />
      <span class="sr-only">{waLabel}</span>
    </a>
  </div>
</div>
