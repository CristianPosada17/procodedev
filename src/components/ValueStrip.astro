---
import { translations, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";
import CardRail from "./CardRail.astro";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
---

<section id="pilares" class="relative pb-8 pt-8 lg:pb-12 lg:pt-12">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <CardRail grid="md:grid-cols-3 lg:grid-cols-6" peek="narrow" gap="gap-3 sm:gap-4">
      {
        t.values.items.map((v, i) => (
          <div
            class="reveal group flex flex-col items-center gap-3 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-5 text-center backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)]"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--brand)]/10 text-[var(--accent)]">
              <Icon name={v.icon as any} class="h-6 w-6" />
            </span>
            <h3 class="text-sm font-bold leading-snug text-[var(--text)] sm:text-base">{v.title}</h3>
            <p class="text-xs leading-5 text-[var(--muted)] sm:text-sm">{v.description}</p>
          </div>
        ))
      }
    </CardRail>
  </div>
</section>
