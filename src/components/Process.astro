---
const steps = [
  {
    number: "01",
    icon: "🔎",
    title: "Descubrimiento",
    description:
      "Entendemos tu negocio, tus objetivos, tu audiencia y el problema digital que necesitas resolver.",
  },
  {
    number: "02",
    icon: "♟",
    title: "Estrategia",
    description:
      "Definimos la estructura, mensajes, secciones y flujo ideal para convertir visitantes en oportunidades.",
  },
  {
    number: "03",
    icon: "</>",
    title: "Diseño y desarrollo",
    description:
      "Construimos una experiencia digital profesional, clara, rápida y alineada con tu marca.",
  },
  {
    number: "04",
    icon: "⚡",
    title: "Integración y lanzamiento",
    description:
      "Conectamos formularios, WhatsApp, calendario, CRM o herramientas necesarias para operar mejor.",
  },
  {
    number: "05",
    icon: "↗",
    title: "Optimización",
    description:
      "Revisamos resultados, detectamos mejoras y mantenemos la estructura digital en evolución.",
  },
];
---

<section id="proceso" class="relative py-20">
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <div class="reveal mx-auto max-w-4xl text-center">
      <div
        class="mb-5 inline-flex rounded-full border border-blue-400/30 bg-blue-500/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.24em] text-blue-300"
      >
        Nuestro proceso
      </div>

      <h2
        class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        Un proceso claro, estratégico y enfocado en
        <span
          class="bg-gradient-to-r from-blue-400 via-blue-500 to-cyan-300 bg-clip-text text-transparent"
        >
          resultados
        </span>
      </h2>

      <p class="mt-5 text-base leading-8 text-slate-300 sm:text-lg">
        No trabajamos al azar. Un proceso claro significa menos vueltas, menos
        tiempo perdido y una web lista para vender más rápido.
      </p>
    </div>

    <div class="relative mt-16">
      <div
        class="absolute left-0 right-0 top-12 hidden h-px bg-gradient-to-r from-transparent via-blue-400/40 to-transparent lg:block"
      >
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-5">
        {
          steps.map((step, index) => (
            <article
              class="reveal relative rounded-3xl border border-blue-400/20 bg-[#061126]/70 p-6 shadow-[0_0_60px_rgba(37,99,235,0.10)] backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-blue-300/50"
              style={`--reveal-delay: ${index * 90}ms`}
            >
              <div class="relative z-10">
                <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl border border-blue-400/25 bg-blue-500/10 text-xl font-bold text-blue-200 shadow-[0_0_40px_rgba(37,99,235,0.18)]">
                  {step.icon}
                </div>

                <p class="text-sm font-black tracking-[0.22em] text-blue-300">
                  {step.number}
                </p>

                <h3 class="mt-3 text-xl font-extrabold text-white">
                  {step.title}
                </h3>

                <p class="mt-4 text-sm leading-7 text-slate-300">
                  {step.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
