---
import { translations, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import CardRail from "./CardRail.astro";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const p = t.process;
---

<section id="proceso" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <SectionHeading eyebrow={p.eyebrow}>
      <Fragment slot="title">
        {p.titleA}{" "}<span class="grad-text">{p.titleHighlight}</span>
      </Fragment>
      <Fragment slot="subtitle">{p.subtitle}</Fragment>
    </SectionHeading>

    <CardRail class="mt-8 lg:mt-12" grid="md:grid-cols-3 lg:grid-cols-5" peek="normal">
      {
        p.steps.map((step, i) => (
          <div
            class="reveal relative flex flex-col rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/70 p-6 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)]"
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <span class="font-mono text-3xl font-bold text-[var(--brand)]/40">
              {step.number}
            </span>
            <h3 class="mt-4 text-base font-bold text-[var(--text)]">
              {step.title}
            </h3>
            <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
              {step.description}
            </p>
          </div>
        ))
      }
    </CardRail>
  </div>
</section>
