---
interface Props {
  eyebrow?: string;
  align?: "left" | "center";
  max?: string;
}
const { eyebrow, align = "left", max = "max-w-3xl" } = Astro.props as Props;
const alignClasses =
  align === "center" ? "mx-auto text-center items-center" : "items-start";
---

<div class:list={["reveal reveal-stagger flex flex-col gap-5", alignClasses, max]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2
    class="section-title text-balance font-bold text-[var(--text)]"
  >
    <slot name="title" />
  </h2>
  <p class="text-pretty text-base leading-8 text-[var(--muted)] sm:text-lg">
    <slot name="subtitle" />
  </p>
</div>
