---
import Icon from "./Icon.astro";

interface Project {
  name: string;
  url: string;
  badge: string;
  description: string;
  tags: readonly string[];
  image?: string;
  kind?: string;
  result?: string;
  /** Qué necesitaba el negocio y qué hizo ProCode, solo con lo documentado. */
  challenge?: string;
  work?: string;
}
interface Props {
  project: Project;
  /** Etiqueta del mini-caso con resultado medible (hallazgo #7). */
  resultLabel?: string;
  /** Etiquetas de «necesidad» y «trabajo» y prefijo del texto alternativo,
   *  en el idioma de la página (antes el alt salía siempre en español). */
  labels?: { challenge: string; work: string; altPrefix: string; viewLive?: string };
  delay?: number;
}
const { project, resultLabel, labels, delay = 0 } = Astro.props as Props;

// Hallazgo #15: antes 3 de 5 thumbnails venían de s.wordpress.com/mshots,
// un servicio gratuito de terceros que devuelve placeholders grises y aplica
// rate-limits. Ahora todos los proyectos tienen screenshot propio en /public.
const img = project.image;
// Variantes responsivas generadas con sharp (2026-09-05). Los originales de
// 1200x600 pesaban hasta 116 KB y se servian enteros a una tarjeta que en
// movil mide ~380 px. `base` es la ruta sin extension; de ahi cuelgan los
// `-400`, `-800` y `-1200` en AVIF y WebP.
const base = img?.replace(/\.(jpg|jpeg|png|webp)$/i, "");
const srcset = (ext: string) =>
  base
    ? [400, 800, 1200].map((w) => `${base}-${w}.${ext} ${w}w`).join(", ")
    : undefined;
// Movil: la tarjeta ocupa el 92% del ancho. md: dos columnas. lg: tres.
const SIZES = "(min-width: 1024px) 31vw, (min-width: 768px) 46vw, 92vw";
// Septiembre de 2026 (30): la tarjeta dejó de enlazar al sitio del cliente
// para no sacar al visitante de ProCode.
// Octubre de 2026: vuelve el enlace, como botón «Ver Sitio Publicado» en
// pestaña nueva: quien duda de cómo trabajamos puede revisar el sitio en vivo
// sin perder el portafolio.
const domain = (() => {
  try {
    return new URL(project.url).hostname.replace(/^www./, "");
  } catch {
    return "";
  }
})();
---

<article
  class="reveal group flex flex-col overflow-hidden rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/70 backdrop-blur-xl transition duration-300 hover:border-[color:var(--border-strong)]"
  style={`--reveal-delay: ${delay}ms`}
>
  <div class="relative aspect-[2/1] overflow-hidden border-b border-[color:var(--border)] bg-[var(--bg-2)]">
    <picture>
      <source type="image/avif" sizes={SIZES} srcset={srcset("avif")} />
      <source type="image/webp" sizes={SIZES} srcset={srcset("webp")} />
      <img
        src={base ? `${base}-800.webp` : img}
        alt={`${labels?.altPrefix ?? "Sitio web de"} ${project.name}`}
        loading="lazy"
        decoding="async"
        width="1200"
        height="600"
        class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
      />
    </picture>
    <span class="absolute left-3 top-3 rounded-full border border-[color:var(--border-strong)] bg-[var(--bg)]/80 px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-[var(--accent)] backdrop-blur">
      {project.badge}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-base font-bold text-[var(--text)]">{project.name}</h3>
    <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
      {project.description}
    </p>
    {
      labels && (project.challenge || project.work) && (
        <dl class="mt-4 grid gap-2 text-[13px] leading-6">
          {project.challenge && (
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-wider text-[var(--accent)]">
                {labels.challenge}
              </dt>
              <dd class="text-[var(--text)]/85">{project.challenge}</dd>
            </div>
          )}
          {project.work && (
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-wider text-[var(--accent)]">
                {labels.work}
              </dt>
              <dd class="text-[var(--text)]/85">{project.work}</dd>
            </div>
          )}
        </dl>
      )
    }
    <div class="flex-1"></div>
    {/* Hallazgo #7: «genera oportunidades» sin un solo número no mueve nada.
        En cuanto haya una cifra real, se llena `result` en src/i18n/ui.ts y
        este bloque aparece solo. Sin dato, no se inventa nada. */}
    {
      project.result && (
        <p class="mt-4 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--brand)]/[0.07] px-4 py-3 text-sm leading-6 text-[var(--text)]/90">
          <span class="mr-1.5 font-mono text-[10px] uppercase tracking-wider text-[var(--accent)]">
            {resultLabel}
          </span>
          {project.result}
        </p>
      )
    }

    <div class="mt-4 flex flex-wrap gap-2">
      {
        project.tags.map((tag) => (
          <span class="rounded-full border border-[color:var(--border)] px-2.5 py-1 text-[11px] text-[var(--muted)]">
            {tag}
          </span>
        ))
      }
    </div>
    {domain && (
      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-[color:var(--border)] pt-5">
        <p class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--muted)]">
          <Icon name="globe" class="h-4 w-4 text-[var(--accent)]" />
          <span class="font-mono text-xs">{domain}</span>
        </p>
        <a
          href={project.url}
          target="_blank"
          rel="noopener"
          data-cta={`portafolio-sitio-${domain.replace(/[^a-z0-9]+/gi, "-")}`}
          class="inline-flex items-center gap-2 rounded-xl border border-[color:var(--border-strong)] bg-[var(--tint)] px-4 py-2.5 text-sm font-bold text-[var(--text)] transition hover:bg-[var(--brand)]/10"
        >
          {labels?.viewLive ?? "Ver Sitio Publicado"}
          <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
      </div>
    )}
  </div>
</article>
