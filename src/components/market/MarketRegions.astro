---
/*
  Regiones de un estado (14 oct 2026): cada una con sus ciudades, su forma
  de buscar y los giros con más demanda. Sustituye a MarketCities en las
  páginas de Texas, Florida y California; el hub de Estados Unidos sigue
  usando `cities` de markets.ts en sus tarjetas.
*/
import Icon from "../Icon.astro";
import type { Regions } from "../../i18n/market-local";

interface Props {
  regions: Regions;
}
const { regions: r } = Astro.props as Props;
---

<section id="regiones" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div class="reveal max-w-3xl">
      <span class="eyebrow">{r.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-bold leading-[1.1] tracking-tight text-[var(--text)] sm:text-4xl lg:text-5xl">{r.title}</h2>
      <p class="mt-5 text-base leading-8 text-[var(--muted)] sm:text-lg">{r.subtitle}</p>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--border)] bg-[color:var(--border)] md:grid-cols-2 xl:grid-cols-3">
      {
        r.items.map((item, i) => (
          <article class="reveal flex flex-col bg-[var(--bg)] p-7" style={`--reveal-delay: ${(i % 3) * 70}ms`}>
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-xl font-bold text-[var(--text)]">{item.name}</h3>
              <span class="font-mono text-[11px] text-[var(--accent)]">{String(i + 1).padStart(2, "0")}</span>
            </div>
            <p class="mt-1.5 flex items-center gap-1.5 text-xs text-[var(--muted)]">
              <Icon name="map-pin" class="h-3.5 w-3.5 flex-none text-[var(--accent)]" />
              {item.area}
            </p>
            <p class="mt-4 flex-1 text-sm leading-7 text-[var(--muted)]">{item.text}</p>
            <p class="mt-5 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]">{r.sectorsLabel}</p>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {item.sectors.map((s) => (
                <li class="rounded-full border border-[color:var(--border)] bg-[var(--surface)]/70 px-2.5 py-1 text-[11px] text-[var(--text)]/85">{s}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
