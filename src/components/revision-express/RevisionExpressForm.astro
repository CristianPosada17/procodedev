---
/*
  Formulario de la Revisión Express — NO es ServiceLeadForm.astro.

  Se usó ServiceLeadForm como referencia técnica (Web3Forms, campos ocultos
  de atribución, pcdFillAttribution/pcdTrack, botcheck), pero necesita un
  campo que aquel no tiene —presencia digital— y un select de "reto
  principal" propio. Por eso vive aislado aquí en vez de tocar el
  componente compartido.

  Campos obligatorios: solo nombre, WhatsApp y presencia digital (esta
  última es imprescindible: sin saber qué sitio/perfil revisar no hay
  Revisión Express que hacer). Negocio, reto y correo/mensaje son
  opcionales — menos fricción para tráfico frío de redes, que llega con
  menos intención que quien ya busca "diseño web" en Google.

  Después de un envío exitoso NO se abre el modal genérico (FormSuccessModal,
  que empuja a WhatsApp): esta oferta necesita un paso siguiente concreto
  —agendar los 15 minutos—, así que la tarjeta del formulario se sustituye
  por un panel propio con ese único CTA y la alternativa de WhatsApp.
*/
import { CONTACT, waHref, type Lang } from "../../i18n/ui";
import Icon from "../Icon.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;

const needOptions = [
  "Mi web no genera suficientes contactos",
  "Quiero conseguir más clientes",
  "Necesito mejorar mi presencia en Google",
  "Estoy pensando invertir en publicidad",
  "Necesito una página web",
  "No sé qué está fallando",
  "Otro",
];

const inputClass =
  "rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)]/70 focus:border-[color:var(--border-strong)]";

const wa = waHref("expressReview", lang);

const script = `
  (function(){
    var form = document.getElementById('revex-lead-form');
    if(!form) return;
    var status = document.getElementById('revex-lead-status');
    var btn = document.getElementById('revex-lead-submit');
    var card = document.getElementById('revex-form-card');
    var success = document.getElementById('revex-success-panel');
    var SENDING = 'Enviando…';
    var OK = 'Solicitud enviada';
    var FAIL = 'No se pudo enviar. Escríbeme por WhatsApp y te atiendo.';
    var LABEL = 'Solicitar mi revisión gratuita';

    function show(msg, ok){
      if(!status) return;
      status.textContent = msg;
      status.classList.remove('hidden');
      status.style.color = ok ? 'var(--ok)' : 'var(--err)';
    }

    form.addEventListener('submit', async function(e){
      e.preventDefault();
      if(btn){ btn.disabled = true; btn.textContent = SENDING; }
      try {
        if(window.pcdFillAttribution) window.pcdFillAttribution(form);
        var data = Object.fromEntries(new FormData(form));
        var res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data)
        });
        var result = await res.json();
        if(result.success){
          show(OK, true);
          if(card) card.hidden = true;
          if(success){ success.hidden = false; success.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
          form.reset();
          if(window.pcdTrack){
            var lead = window.pcdAttribution ? window.pcdAttribution() : {};
            lead.form_name = 'revision_express';
            lead.lead_type = 'formulario';
            lead.service = 'Revisión Express ProCode';
            lead.project_type = data.need || '';
            lead.value = 1;
            lead.currency = 'USD';
            window.pcdTrack('generate_lead', lead, {
              event: 'Lead',
              params: { content_name: 'Revisión Express', content_category: 'revision-express', value: 1, currency: 'USD' }
            });
          } else {
            if(window.fbq) window.fbq('track','Lead');
            if(window.gtag) window.gtag('event','generate_lead',{ origen:'formulario_revision_express' });
          }
        } else {
          show(FAIL, false);
          if(window.pcdTrack) window.pcdTrack('form_error', { form_name:'revision_express', error_type:'rechazado' });
        }
      } catch(err){
        show(FAIL, false);
        if(window.pcdTrack) window.pcdTrack('form_error', { form_name:'revision_express', error_type:'red' });
      }
      finally { if(btn){ btn.disabled = false; btn.textContent = LABEL; } }
    });
  })();
`;
---

<section id="solicitar" class="relative scroll-mt-24 py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[900px] px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">// solicitar revisión express</span>
      <h2 class="mt-5 text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl">
        Dime dónde encontrarte y{" "}
        <span class="grad-text">agendamos tus 15 minutos</span>
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base leading-8 text-[var(--muted)]">
        Sin costo y sin compromiso. Te contactamos por WhatsApp para
        confirmar horario.
      </p>
      <p class="mx-auto mt-4 inline-flex max-w-xl items-center gap-2 rounded-full border border-[color:var(--border)] bg-[var(--tint)] px-4 py-2 font-mono text-[11px] uppercase tracking-[0.1em] text-[var(--accent)]">
        Las reviso yo, a mano · agenda limitada cada semana
      </p>
    </div>

    <div
      id="revex-form-card"
      class="reveal mt-10 rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/60 p-6 backdrop-blur-xl sm:p-10"
    >
      <form id="revex-lead-form" data-form="revision_express" class="grid gap-5">
        <input type="hidden" name="access_key" value={CONTACT.web3formsKey} />
        <input type="hidden" name="servicio" value="Revisión Express ProCode" />
        <input type="hidden" name="lead_origen" value="" />
        <input type="hidden" name="lead_campana" value="" />
        <input type="hidden" name="lead_pagina" value="" />
        <input type="hidden" name="lead_landing" value="" />
        <input type="hidden" name="lead_primer_contacto" value="" />
        <input
          type="hidden"
          name="subject"
          value="Solicitud de Revisión Express — procodedev.com"
        />
        <input type="hidden" name="from_name" value="ProCode Dev — Revisión Express" />
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2">
            <span class="text-sm font-medium text-[var(--text)]">Nombre</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              placeholder="Ej: María González"
              class={inputClass}
            />
          </label>
          <label class="grid gap-2">
            <span class="text-sm font-medium text-[var(--text)]">WhatsApp</span>
            <input
              type="tel"
              name="phone"
              required
              autocomplete="tel"
              placeholder="614 123 4567"
              class={inputClass}
            />
          </label>
        </div>

        <label class="grid gap-2">
          <span class="text-sm font-medium text-[var(--text)]">Página web o redes sociales</span>
          <input
            type="text"
            name="presence"
            required
            placeholder="Tu sitio web, Facebook, Instagram o Google Business"
            class={inputClass}
          />
          <span class="text-xs leading-5 text-[var(--muted)]">
            La necesitamos sí o sí: es lo que vamos a revisar.
          </span>
        </label>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2">
            <span class="flex items-center gap-2 text-sm font-medium text-[var(--text)]">
              Nombre del negocio
              <span class="rounded-full border border-[color:var(--border)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[var(--muted)]">
                opcional
              </span>
            </span>
            <input
              type="text"
              name="business"
              placeholder="Ej: Clínica Dental Sonrisa"
              class={inputClass}
            />
          </label>
          <label class="grid gap-2">
            <span class="flex items-center gap-2 text-sm font-medium text-[var(--text)]">
              Principal reto
              <span class="rounded-full border border-[color:var(--border)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[var(--muted)]">
                opcional
              </span>
            </span>
            <select
              name="need"
              class="rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-sm text-[var(--text)] outline-none transition focus:border-[color:var(--border-strong)]"
            >
              <option value="">Prefiero contártelo en la llamada</option>
              {needOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </label>
        </div>

        <label class="grid gap-2">
          <span class="flex items-center gap-2 text-sm font-medium text-[var(--text)]">
            Correo
            <span class="rounded-full border border-[color:var(--border)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[var(--muted)]">
              opcional
            </span>
          </span>
          <input
            type="email"
            name="email"
            autocomplete="email"
            placeholder="maria@minegocio.com"
            class={inputClass}
          />
        </label>

        <label class="grid gap-2">
          <span class="flex items-center gap-2 text-sm font-medium text-[var(--text)]">
            Mensaje o contexto adicional
            <span class="rounded-full border border-[color:var(--border)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[var(--muted)]">
              opcional
            </span>
          </span>
          <textarea
            name="message"
            rows="3"
            placeholder="Cuéntame lo que quieras que sepa antes de la llamada."
            class:list={["resize-none", inputClass]}></textarea>
        </label>

        <button
          id="revex-lead-submit"
          type="submit"
          class="inline-flex items-center justify-center rounded-xl bg-[var(--brand)] px-6 py-4 text-sm font-bold text-white shadow-[0_0_40px_var(--halo-brand)] transition hover:bg-[var(--brand-strong)] disabled:opacity-60"
        >
          Solicitar mi revisión gratuita
        </button>

        <p id="revex-lead-status" class="hidden text-sm" role="status"></p>
        <p class="text-xs leading-6 text-[var(--muted)]">
          Respondo en menos de 24 horas. Tus datos solo se usan para
          contactarte.
        </p>
      </form>
    </div>

    {/* Siguiente paso tras el envío: agendar, no solo "te contactamos". */}
    <div
      id="revex-success-panel"
      hidden
      class="reveal mt-10 rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/60 p-8 text-center backdrop-blur-xl sm:p-10"
    >
      <div
        class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-[color:var(--border-strong)] bg-[var(--brand)]/10"
      >
        <Icon name="check" class="h-7 w-7 text-[var(--ok)]" />
      </div>
      <p class="mt-5 font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]">
        Tu solicitud está lista. Falta un paso.
      </p>
      <h3 class="mt-3 text-2xl font-bold tracking-tight text-[var(--text)]">
        Agenda ahora tus 15 minutos
      </h3>
      <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-[var(--muted)]">
        Así podemos preparar tu Revisión Express antes de la llamada.
      </p>
      <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="#agendar"
          data-cta="revex-success-agendar"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--brand)] px-6 py-4 text-sm font-bold text-white shadow-[0_0_40px_var(--halo-brand)] transition hover:bg-[var(--brand-strong)]"
        >
          Agendar mis 15 minutos
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a
          href={wa}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="revex-success-whatsapp"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-[color:var(--border-strong)] bg-[var(--tint)] px-6 py-4 text-sm font-bold text-[var(--text)] transition hover:bg-[var(--brand)]/10"
        >
          <Icon name="whatsapp" class="h-4 w-4 text-emerald-400" />
          Prefiero coordinar por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline set:html={script}></script>
