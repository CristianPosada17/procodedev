---
/*
  Formulario de la Revisión Express — NO es LeadForm.astro.

  Usa la misma integración técnica que el formulario del resto del sitio
  (Web3Forms, campos ocultos de atribución, pcdFillAttribution/pcdTrack,
  botcheck), pero vive aislado porque esta landing tiene reglas propias:
  su ancla es `#solicitar` (destino del botón «Más información») y, tras un
  envío correcto, en vez del modal genérico muestra un panel con un único
  siguiente paso: reservar los 20 minutos en la agenda de esta página.

  Septiembre de 2026 (30): solo Nombre y Email. Antes pedía también
  WhatsApp, presencia digital, negocio, reto y mensaje; el enlace de la web
  y el contexto se piden al coordinar la llamada.
*/
import { CONTACT, PAGES, type Lang } from "../../i18n/ui";
import Icon from "../Icon.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;

const inputClass =
  "min-h-[48px] w-full rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-base text-[var(--text)] outline-none transition placeholder:text-[var(--muted)]/70 focus:border-[color:var(--brand)] focus-visible:ring-2 focus-visible:ring-[color:var(--brand)]/40 sm:text-sm";

const copy = {
  sending: "Enviando…",
  ok: "Solicitud enviada",
  fail: `No se pudo enviar. Inténtalo de nuevo en un momento o escríbeme a ${CONTACT.email}.`,
  label: "Enviar y recibir información",
};

const script = `
  (function(){
    var form = document.getElementById('revex-lead-form');
    if(!form) return;
    var status = document.getElementById('revex-lead-status');
    var btn = document.getElementById('revex-lead-submit');
    var card = document.getElementById('revex-form-card');
    var success = document.getElementById('revex-success-panel');
    var SENDING = ${JSON.stringify(copy.sending)};
    var OK = ${JSON.stringify(copy.ok)};
    var FAIL = ${JSON.stringify(copy.fail)};
    var LABEL = ${JSON.stringify(copy.label)};

    function show(msg, ok){
      if(!status) return;
      status.textContent = msg;
      status.classList.remove('hidden');
      status.style.color = ok ? 'var(--ok)' : 'var(--err)';
    }

    form.addEventListener('submit', async function(e){
      e.preventDefault();
      if(form.reportValidity && !form.reportValidity()) return;
      if(btn){ btn.disabled = true; btn.textContent = SENDING; }
      try {
        if(window.pcdFillAttribution) window.pcdFillAttribution(form);
        var data = Object.fromEntries(new FormData(form));
        var res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data)
        });
        var result = await res.json();
        if(result.success){
          show(OK, true);
          if(card) card.hidden = true;
          if(success){ success.hidden = false; success.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
          form.reset();
          if(window.pcdTrack){
            var lead = window.pcdAttribution ? window.pcdAttribution() : {};
            lead.form_name = 'revision_express';
            lead.lead_type = 'formulario';
            lead.service = 'Revisión Express ProCode';
            lead.value = 1;
            lead.currency = 'USD';
            window.pcdTrack('generate_lead', lead, {
              event: 'Lead',
              params: { content_name: 'Revisión Express', content_category: 'revision-express', value: 1, currency: 'USD' }
            });
          } else {
            if(window.fbq) window.fbq('track','Lead');
            if(window.gtag) window.gtag('event','generate_lead',{ origen:'formulario_revision_express' });
          }
        } else {
          show(FAIL, false);
          if(window.pcdTrack) window.pcdTrack('form_error', { form_name:'revision_express', error_type:'rechazado' });
        }
      } catch(err){
        show(FAIL, false);
        if(window.pcdTrack) window.pcdTrack('form_error', { form_name:'revision_express', error_type:'red' });
      }
      finally { if(btn){ btn.disabled = false; btn.textContent = LABEL; } }
    });
  })();
`;
---

<section id="solicitar" class="relative scroll-mt-24 py-12 lg:py-20" aria-labelledby="revex-form-title">
  <div class="mx-auto w-full max-w-[900px] px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">// más información sobre la revisión express</span>
      <h2 id="revex-form-title" class="mt-5 text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl">
        ¿Prefieres que te escribamos primero?{" "}
        <span class="grad-text">Déjanos tu nombre y tu correo</span>
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base leading-8 text-[var(--muted)]">
        Sin costo y sin compromiso. Te respondo por correo en menos de 24
        horas con los detalles de la Revisión Express y, cuando quieras,
        eliges tu horario en la agenda.
      </p>
      <p class="mx-auto mt-4 inline-flex max-w-xl items-center gap-2 rounded-full border border-[color:var(--border)] bg-[var(--tint)] px-4 py-2 font-mono text-[11px] uppercase tracking-[0.1em] text-[var(--accent)]">
        Las reviso yo, a mano · agenda limitada cada semana
      </p>
    </div>

    <div
      id="revex-form-card"
      class="reveal mt-10 rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/60 p-6 backdrop-blur-xl sm:p-10"
    >
      <form id="revex-lead-form" data-form="revision_express" class="grid gap-5">
        <input type="hidden" name="access_key" value={CONTACT.web3formsKey} />
        <input type="hidden" name="servicio" value="Revisión Express ProCode" />
        <input type="hidden" name="lead_origen" value="" />
        <input type="hidden" name="lead_campana" value="" />
        <input type="hidden" name="lead_pagina" value="" />
        <input type="hidden" name="lead_landing" value="" />
        <input type="hidden" name="lead_primer_contacto" value="" />
        <input
          type="hidden"
          name="subject"
          value="Solicitud de información — Revisión Express — procodedev.com"
        />
        <input type="hidden" name="from_name" value="ProCode Dev — Revisión Express" />
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2">
            <span class="text-sm font-medium text-[var(--text)]">Nombre</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              placeholder="Ej: María González"
              class={inputClass}
            />
          </label>
          <label class="grid gap-2">
            <span class="text-sm font-medium text-[var(--text)]">Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder="maria@minegocio.com"
              class={inputClass}
            />
          </label>
        </div>

        <button id="revex-lead-submit" type="submit" class="btn-cta w-full">
          {copy.label}
        </button>

        <p id="revex-lead-status" class="hidden text-sm" role="status" aria-live="polite"></p>
        <p class="text-xs leading-6 text-[var(--muted)]">
          Respondo en menos de 24 horas. Tus datos solo se usan para
          contactarte.{" "}
          <a href={PAGES.privacy[lang]} class="underline underline-offset-2 hover:text-[var(--accent)]">
            Aviso de privacidad
          </a>
        </p>
      </form>
    </div>

    {/* Siguiente paso tras el envío: reservar, no solo "te contactamos". */}
    <div
      id="revex-success-panel"
      hidden
      class="reveal mt-10 rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/60 p-8 text-center backdrop-blur-xl sm:p-10"
    >
      <div
        class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-[color:var(--border-strong)] bg-[var(--brand)]/10"
      >
        <Icon name="check" class="h-7 w-7 text-[var(--ok)]" />
      </div>
      <p class="mt-5 font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]">
        Recibido. Te escribo por correo en menos de 24 horas.
      </p>
      <h3 class="mt-3 text-2xl font-bold tracking-tight text-[var(--text)]">
        ¿Quieres adelantarte? Reserva tus 20 minutos
      </h3>
      <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-[var(--muted)]">
        Así podemos preparar tu Revisión Express antes de la llamada.
      </p>
      <div class="mt-6 flex justify-center">
        <a
          href="#agendar"
          data-cta="revex-success-agendar"
          class="btn-cta"
        >
          Reservar Revisión Express
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline set:html={script}></script>
