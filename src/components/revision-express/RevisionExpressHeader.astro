---
/*
  Header exclusivo de /revision-express/.

  El Header global tiene tres menús desplegables y cinco enlaces: perfecto
  para navegar el sitio, demasiado para una landing de conversión que recibe
  tráfico frío de redes y WhatsApp. Aquí solo hay logo y los dos botones de
  la landing, los dos con destino en esta misma página: reservar (#agendar)
  y más información (#solicitar, solo en sm+; en móvil la barra fija ya lo
  ofrece).

  No se agrega a la navegación principal (Header.astro no se toca): el
  enlace a esta página vive en el tráfico externo, no en el menú del sitio.
*/
import { PAGES, type Lang } from "../../i18n/ui";
import Icon from "../Icon.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
---

<header
  class="sticky top-0 z-50 border-b border-[color:var(--border)] bg-[var(--bg)]/80 backdrop-blur-xl"
>
  <div
    class="mx-auto flex w-full max-w-[1480px] items-center justify-between px-4 py-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <a
      href={PAGES.home[lang]}
      class="flex items-center gap-3"
      aria-label="ProCode Dev"
    >
      <div class="flex h-11 w-11 items-center justify-center">
        <img
          src="/Logo.webp"
          alt="Logotipo de ProCode Dev"
          width="44"
          height="44"
          class="h-full w-full object-contain"
        />
      </div>
      <span class="text-base font-bold tracking-tight text-[var(--text)] sm:text-lg">
        ProCode <span class="text-[var(--accent)]">Dev</span>
      </span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        data-theme-toggle
        aria-label="Cambiar tema"
        class="inline-flex h-[38px] w-[38px] items-center justify-center rounded-lg border border-[color:var(--border)] bg-[var(--tint)] text-[var(--muted)] transition hover:border-[color:var(--border-strong)] hover:text-[var(--accent)]"
      >
        <span class="theme-icon-sun inline-flex">
          <Icon name="sun" class="h-4 w-4" />
        </span>
        <span class="theme-icon-moon inline-flex">
          <Icon name="moon" class="h-4 w-4" />
        </span>
      </button>

      <a
        href="#solicitar"
        data-cta="header-revex-info"
        class="btn-secondary hidden min-h-[44px] px-4 py-2.5 sm:inline-flex"
      >
        Más información
      </a>
      <a
        href="#agendar"
        data-cta="header-revex-reservar"
        class="btn-cta min-h-[44px] px-4 py-2.5 text-xs sm:px-5 sm:text-sm"
      >
        Reservar<span class="hidden sm:inline">&nbsp;Revisión Express</span>
      </a>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      (window as any).pcdToggleTheme?.();
    });
  });
</script>
