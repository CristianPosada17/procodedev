---
/*
  CTA final de la landing. No reutiliza FinalCTA.astro: esta landing tiene
  sus propios dos botones —Reservar Revisión Express (#agendar) y Más
  información (#solicitar)—, los dos con destino en esta misma página.
*/
import type { Lang } from "../../i18n/ui";
import Icon from "../Icon.astro";

interface Props {
  lang?: Lang;
}
---

<section class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div
      class="reveal relative overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-gradient-to-br from-[var(--brand)]/20 via-[var(--surface)]/60 to-[var(--bg-2)] p-8 text-center backdrop-blur-xl lg:p-16"
    >
      <div class="tech-grid absolute inset-0 opacity-30"></div>
      <div class="relative mx-auto max-w-3xl">
        <span class="eyebrow">
          // 20 minutos pueden darte más claridad que meses de improvisación
        </span>
        <h2 class="mt-5 text-3xl font-bold leading-[1.15] tracking-tight text-[var(--text)] sm:text-4xl lg:text-5xl">
          Antes de invertir más, descubre dónde está la fricción.
        </h2>
        <p class="mt-5 text-base leading-8 text-[var(--muted)]">
          Revisamos contigo los puntos más importantes de tu presencia
          digital y te mostramos qué debería tener prioridad.
        </p>
        <div class="mt-9 flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href="#agendar"
            data-cta="revex-cta-final-reservar"
            class="btn-cta px-7"
          >
            Reservar Revisión Express
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a
            href="#solicitar"
            data-cta="revex-cta-final-info"
            class="btn-secondary px-7"
          >
            Más información
          </a>
        </div>
        <p class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--muted)]">
          20 minutos · Sin costo · Sin compromiso
        </p>
        <p class="mt-2 text-xs font-semibold text-[var(--accent)]">
          Las reviso yo, a mano — agenda limitada cada semana.
        </p>
      </div>
    </div>
  </div>
</section>
