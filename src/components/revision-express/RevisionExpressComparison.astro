---
/*
  «Revisión Express ≠ Auditoría completa.»

  Reutiliza el copy de `audit.ts.versus` (freeTitle/freeItems, paidTitle/
  paidItems): es exactamente la comparación que ya existe en la página de la
  Auditoría, escrita para diferenciar las dos ofertas. Reescribirla aquí
  crearía dos versiones que se desincronizan a la primera edición.

  A diferencia de `AuditVersus.astro` (que vive en /servicios/auditoria/ y
  manda el CTA gratis a /contacto), aquí el visitante YA está en la página de
  la oferta gratis: su CTA baja a la agenda de esta misma página, y el de
  la auditoría sí sale a su landing propia.

  Nota de orden: esta sección vive DESPUÉS del formulario y de Calendly (no
  antes), a propósito — mostrar la alternativa de pago antes de que alguien
  convierta en lo gratis competía con el CTA principal.
*/
import { PAGES, type Lang } from "../../i18n/ui";
import { audit } from "../../i18n/audit";
import SectionHeading from "../SectionHeading.astro";
import Icon from "../Icon.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const v = audit[lang].versus;
---

<section id="revision-vs-auditoria" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1100px] px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow="// revisión express ≠ auditoría completa" align="center" max="mx-auto max-w-3xl">
      <Fragment slot="title">{v.title}</Fragment>
      <Fragment slot="subtitle">{v.subtitle}</Fragment>
    </SectionHeading>

    <div class="mx-auto mt-12 grid max-w-4xl gap-5 lg:grid-cols-2">
      {/* Gratis: la oferta de esta misma página */}
      <article
        class="reveal flex flex-col rounded-[var(--radius)] border border-[color:var(--border-strong)] bg-[var(--surface)]/60 p-7 backdrop-blur-xl shadow-[0_30px_90px_-50px_var(--halo-card-strong)]"
      >
        <h3 class="text-lg font-bold leading-snug text-[var(--text)]">
          {v.freeTitle}
        </h3>
        <ul class="mt-6 grid flex-1 gap-2.5">
          {
            v.freeItems.map((item) => (
              <li class="flex items-start gap-2.5 text-[13px] leading-6 text-[var(--text)]/85">
                <span class="mt-1 flex h-4 w-4 flex-none items-center justify-center rounded bg-[var(--brand)]/15 text-[var(--accent)]">
                  <Icon name="check" class="h-2.5 w-2.5" strokeWidth={3} />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
        <a
          href="#agendar"
          data-cta="revex-comparacion-gratis"
          class="btn-cta mt-7 justify-between"
        >
          {v.freeCta}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </article>

      {/* De pago: manda a su propia landing, no a este formulario */}
      <article
        class="reveal flex flex-col rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/50 p-7 backdrop-blur-xl"
        style="--reveal-delay: 80ms"
      >
        <h3 class="text-lg font-bold leading-snug text-[var(--text)]">
          {v.paidTitle}
        </h3>
        <ul class="mt-6 grid flex-1 gap-2.5">
          {
            v.paidItems.map((item) => (
              <li class="flex items-start gap-2.5 text-[13px] leading-6 text-[var(--text)]/85">
                <span class="mt-1 flex h-4 w-4 flex-none items-center justify-center rounded bg-[var(--tint-2)] text-[var(--muted)]">
                  <Icon name="check" class="h-2.5 w-2.5" strokeWidth={3} />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
        <a
          href={PAGES.audit[lang]}
          data-cta="revex-comparacion-auditoria"
          class="mt-7 inline-flex items-center justify-between gap-2 rounded-xl border border-[color:var(--border-strong)] bg-[var(--tint)] px-5 py-3 text-sm font-bold text-[var(--text)] transition hover:bg-[var(--brand)]/12"
        >
          {v.paidCta}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </article>
    </div>
  </div>
</section>
