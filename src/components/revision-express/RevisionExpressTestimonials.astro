---
/*
  Prueba social de la landing.

  OJO — decisión deliberada: se reutilizan los testimonios REALES de
  Fernanda Silva y Constructora Izcalli que YA existen y están publicados
  en `translations.testimonials` (home). No se inventó ninguna cita nueva
  atribuida a ellos, aunque el negocio dé permiso interno para "lo que se
  necesite": un testimonio inventado sigue siendo publicidad engañosa hacia
  quien lo LEE (el prospecto que confía en que es un relato real), sin
  importar el permiso entre familiares. Lo que sí es nuevo es el encabezado
  y el marco de esta sección, escritos para esta landing.

  Se presentan como prueba general de trabajar con ProCode (no como gente
  que usó la Revisión Express puntualmente, porque eso sí sería una
  afirmación falsa y verificable).
*/
import { translations, type Lang } from "../../i18n/ui";
import SectionHeading from "../SectionHeading.astro";
import Icon from "../Icon.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const items = translations[lang].testimonials.items.filter((t) =>
  ["Fernanda Silva", "Constructora Izcalli"].includes(t.name),
);
---

<section id="testimonios" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1100px] px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow="// esto pasa cuando tu web hace el trabajo por ti" align="center" max="mx-auto max-w-2xl">
      <Fragment slot="title">
        Negocios reales que ya{" "}
        <span class="grad-text">trabajan con ProCode</span>
      </Fragment>
      <Fragment slot="subtitle">
        No son actores de stock: son negocios de servicios como el tuyo.
      </Fragment>
    </SectionHeading>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        items.map((item, i) => (
          <figure
            class="reveal flex flex-col rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/70 p-7 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)]"
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <div class="font-mono text-3xl text-[var(--brand)]/50">“</div>
            <blockquote class="flex-1 text-sm leading-7 text-[var(--text)]/90">
              {item.quote}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-[color:var(--border)] pt-5">
              <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-[var(--brand)]/15 font-mono text-sm font-bold text-[var(--accent)]">
                {item.initials}
              </span>
              <div>
                <p class="text-sm font-bold text-[var(--text)]">{item.name}</p>
                <p class="text-xs text-[var(--muted)]">{item.role}</p>
              </div>
            </figcaption>
            {/* El dominio queda visible para verificarlo, sin enlace externo. */}
            {item.urlLabel && (
              <p class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--muted)]">
                <Icon name="globe" class="h-3.5 w-3.5 text-[var(--accent)]" />
                <span class="font-mono text-[11px]">{item.urlLabel}</span>
              </p>
            )}
          </figure>
        ))
      }
    </div>
  </div>
</section>
