---
/*
  «Para quién es y para quién no.»

  Decir a quién NO le sirve el servicio es el bloque que más confianza gana
  y el que menos agencias escriben. Además filtra al prospecto equivocado
  antes de la llamada, que es tiempo que no se recupera.
*/
import type { Lang } from "../i18n/ui";
import type { ServiceDetail } from "../i18n/services";

interface Props {
  fit: ServiceDetail["fit"];
  lang?: Lang;
}
const { fit } = Astro.props as Props;
---

<section id="para-quien" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1100px] px-4 sm:px-6 lg:px-8">
    <div class="reveal max-w-2xl">
      <span class="eyebrow">{fit.eyebrow}</span>
      <h2
        class="section-title mt-5 text-balance font-bold text-[var(--text)]"
      >
        {fit.title}
      </h2>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2">
      <div
        class="band-ink reveal rounded-[var(--radius-lg)] p-8 shadow-[0_50px_120px_-60px_rgba(37,99,235,0.7)] lg:p-10"
      >
        <h3 class="flex items-center gap-3 text-xl font-bold text-[var(--text)]">
          <span class="h-8 w-1.5 rounded-full bg-gradient-to-b from-[var(--accent)] to-[var(--brand)]" aria-hidden="true"></span>
          {fit.yesTitle}
        </h3>
        <ul class="mt-5 grid gap-3.5">
          {
            fit.yes.map((y) => (
              <li class="flex items-start gap-3 text-sm leading-7 text-[var(--text)]/90">
                <span class="mt-[0.7rem] h-[3px] w-4 flex-none rounded-full bg-gradient-to-r from-[var(--accent)] to-[var(--brand)]" />
                {y}
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="card-pro reveal rounded-[var(--radius-lg)] p-8 lg:p-10"
        style="--reveal-delay: 90ms"
      >
        <h3 class="flex items-center gap-3 text-xl font-bold text-[var(--text)]">
          <span class="h-8 w-1.5 rounded-full bg-[var(--border-strong)]" aria-hidden="true"></span>
          {fit.noTitle}
        </h3>
        <ul class="mt-5 grid gap-3.5">
          {
            fit.no.map((n) => (
              <li class="flex items-start gap-3 text-sm leading-7 text-[var(--muted)]">
                <span class="mt-[0.7rem] h-[3px] w-4 flex-none rounded-full bg-[var(--muted)]/40" />
                {n}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
