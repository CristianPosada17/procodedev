---
import { waHref, type Lang, type PageKey } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  lang?: Lang;
  page?: PageKey | "blog";
}
const { lang = "es", page = "home" } = Astro.props as Props;

// El mensaje precargado cambia según la página para no perder el contexto
// de lo que el prospecto estaba viendo al escribir (hallazgo #17).
const href = waHref(page, lang);
const label = lang === "es" ? "Escríbeme por WhatsApp" : "Message me on WhatsApp";
---

<a
  href={href}
  data-cta="whatsapp-flotante"
  data-zone="flotante"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class="group fixed bottom-5 right-5 z-50 hidden h-14 w-14 items-center justify-center rounded-full bg-emerald-500 shadow-[0_10px_30px_-8px_rgba(16,185,129,0.7)] transition hover:scale-110 lg:flex"
>
  <span
    class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-50"
  ></span>
  <Icon name="whatsapp" class="relative h-7 w-7 text-white" />
</a>
