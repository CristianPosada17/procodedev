---
/*
  Ilustración de cada tarjeta de servicio. Son SVG en línea con los tokens de
  marca: pesan casi nada, se ven nítidos en cualquier pantalla y no dependen
  de fotografías de banco de imágenes.
*/
interface Props {
  variant?: string;
  class?: string;
}
const { variant = "site", class: cls = "" } = Astro.props as Props;
---

<div
  class:list={[
    "relative w-full overflow-hidden rounded-[1rem] border border-[color:var(--border)] bg-[var(--bg-2)]",
    cls,
  ]}
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_30%_0%,rgba(56,189,248,0.16),transparent_60%)]"
  >
  </div>
  <svg
    viewBox="0 0 400 200"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="relative block h-auto w-full"
    aria-hidden="true"
  >
    {
      variant === "site" && (
        <g>
          <rect x="24" y="18" width="352" height="164" rx="12" fill="#0d1730" stroke="rgba(96,165,250,0.28)" />
          <path d="M24 46h352" stroke="rgba(148,163,184,0.2)" />
          <circle cx="44" cy="32" r="4" fill="#f87171" />
          <circle cx="58" cy="32" r="4" fill="#fbbf24" />
          <circle cx="72" cy="32" r="4" fill="#34d399" />
          <rect x="44" y="62" width="150" height="12" rx="6" fill="#60a5fa" />
          <rect x="44" y="82" width="110" height="8" rx="4" fill="rgba(148,163,184,0.45)" />
          <rect x="44" y="102" width="72" height="20" rx="8" fill="#2563eb" />
          <rect x="232" y="62" width="124" height="60" rx="10" fill="rgba(56,189,248,0.16)" stroke="rgba(96,165,250,0.35)" />
          <rect x="44" y="138" width="96" height="30" rx="8" fill="rgba(148,163,184,0.12)" stroke="rgba(148,163,184,0.22)" />
          <rect x="152" y="138" width="96" height="30" rx="8" fill="rgba(148,163,184,0.12)" stroke="rgba(148,163,184,0.22)" />
          <rect x="260" y="138" width="96" height="30" rx="8" fill="rgba(56,189,248,0.18)" stroke="rgba(96,165,250,0.4)" />
        </g>
      )
    }

    {
      variant === "search" && (
        <g>
          <rect x="40" y="26" width="320" height="34" rx="17" fill="#0d1730" stroke="rgba(96,165,250,0.35)" />
          <circle cx="64" cy="43" r="7" stroke="#38bdf8" stroke-width="2.5" />
          <path d="m69 48 6 6" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
          <rect x="86" y="38" width="150" height="10" rx="5" fill="rgba(148,163,184,0.5)" />
          <rect x="40" y="76" width="320" height="44" rx="10" fill="rgba(56,189,248,0.12)" stroke="rgba(96,165,250,0.4)" />
          <path d="M66 88c-7 0-12 5-12 12 0 8 12 18 12 18s12-10 12-18c0-7-5-12-12-12Z" fill="#38bdf8" />
          <circle cx="66" cy="100" r="4" fill="#0d1730" />
          <rect x="94" y="88" width="128" height="9" rx="4.5" fill="#e2e8f0" />
          <rect x="94" y="104" width="86" height="7" rx="3.5" fill="rgba(148,163,184,0.55)" />
          <g fill="#fbbf24">
            <circle cx="248" cy="99" r="4" />
            <circle cx="262" cy="99" r="4" />
            <circle cx="276" cy="99" r="4" />
            <circle cx="290" cy="99" r="4" />
            <circle cx="304" cy="99" r="4" />
          </g>
          <rect x="40" y="134" width="320" height="40" rx="10" fill="rgba(148,163,184,0.08)" stroke="rgba(148,163,184,0.2)" />
          <rect x="60" y="146" width="120" height="8" rx="4" fill="rgba(148,163,184,0.4)" />
          <rect x="60" y="160" width="78" height="6" rx="3" fill="rgba(148,163,184,0.25)" />
        </g>
      )
    }

    {
      variant === "form" && (
        <g>
          <rect x="52" y="16" width="296" height="168" rx="14" fill="#0d1730" stroke="rgba(96,165,250,0.28)" />
          <rect x="76" y="40" width="90" height="9" rx="4.5" fill="#38bdf8" />
          <rect x="76" y="62" width="248" height="26" rx="8" fill="rgba(148,163,184,0.1)" stroke="rgba(148,163,184,0.22)" />
          <rect x="76" y="96" width="118" height="26" rx="8" fill="rgba(148,163,184,0.1)" stroke="rgba(148,163,184,0.22)" />
          <rect x="206" y="96" width="118" height="26" rx="8" fill="rgba(148,163,184,0.1)" stroke="rgba(148,163,184,0.22)" />
          <rect x="76" y="130" width="118" height="34" rx="8" fill="rgba(56,189,248,0.12)" stroke="rgba(96,165,250,0.4)" stroke-dasharray="5 4" />
          <path d="M135 140v14M128 147h14" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
          <rect x="206" y="130" width="118" height="34" rx="10" fill="#2563eb" />
          <path d="m252 147 6 7 12-14" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      )
    }

    {
      variant === "flow" && (
        <g>
          <path d="M96 60h60M244 60h60M96 140h60M244 140h60M200 84v32" stroke="rgba(96,165,250,0.5)" stroke-width="2" stroke-dasharray="6 5" stroke-linecap="round" />
          <g>
            <rect x="26" y="38" width="72" height="44" rx="10" fill="#0d1730" stroke="rgba(96,165,250,0.4)" />
            <rect x="42" y="52" width="40" height="6" rx="3" fill="rgba(148,163,184,0.5)" />
            <rect x="42" y="64" width="26" height="6" rx="3" fill="rgba(148,163,184,0.3)" />
          </g>
          <rect x="164" y="38" width="72" height="44" rx="10" fill="rgba(56,189,248,0.16)" stroke="rgba(96,165,250,0.5)" />
          <path d="M182 52h36v18l-8-4h-28z" fill="#38bdf8" />
          <g>
            <rect x="302" y="38" width="72" height="44" rx="10" fill="#0d1730" stroke="rgba(96,165,250,0.4)" />
            <rect x="316" y="50" width="44" height="20" rx="4" stroke="#60a5fa" stroke-width="2" />
            <path d="M316 57h44M328 46v6M348 46v6" stroke="#60a5fa" stroke-width="2" stroke-linecap="round" />
          </g>
          <rect x="164" y="118" width="72" height="44" rx="10" fill="#2563eb" />
          <path d="M184 132h32M184 140h24M184 148h28" stroke="#fff" stroke-width="2.5" stroke-linecap="round" />
          <g>
            <rect x="26" y="118" width="72" height="44" rx="10" fill="#0d1730" stroke="rgba(96,165,250,0.4)" />
            <circle cx="62" cy="140" r="12" stroke="#38bdf8" stroke-width="2.5" />
            <path d="M62 133v8l5 4" stroke="#38bdf8" stroke-width="2.5" stroke-linecap="round" />
          </g>
          <g>
            <rect x="302" y="118" width="72" height="44" rx="10" fill="#0d1730" stroke="rgba(96,165,250,0.4)" />
            <path d="M318 150l12-14 10 8 14-18" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </g>
        </g>
      )
    }

    {
      variant === "ai" && (
        <g>
          <rect x="40" y="26" width="212" height="66" rx="14" fill="#0d1730" stroke="rgba(96,165,250,0.3)" />
          <path d="M64 92v16l20-16z" fill="#0d1730" stroke="rgba(96,165,250,0.3)" />
          <rect x="62" y="46" width="152" height="9" rx="4.5" fill="rgba(148,163,184,0.5)" />
          <rect x="62" y="64" width="106" height="9" rx="4.5" fill="rgba(148,163,184,0.3)" />
          <rect x="148" y="112" width="212" height="66" rx="14" fill="rgba(37,99,235,0.22)" stroke="rgba(96,165,250,0.5)" />
          <path d="M336 112v-16l-20 16z" fill="rgba(37,99,235,0.22)" stroke="rgba(96,165,250,0.5)" />
          <rect x="170" y="130" width="140" height="9" rx="4.5" fill="#bfdbfe" />
          <rect x="170" y="148" width="92" height="9" rx="4.5" fill="rgba(191,219,254,0.6)" />
          <circle cx="330" cy="153" r="14" fill="#0d1730" stroke="rgba(96,165,250,0.5)" />
          <path d="M330 145l2.6 5.4 5.4 2.6-5.4 2.6-2.6 5.4-2.6-5.4-5.4-2.6 5.4-2.6z" fill="#38bdf8" />
          <path d="M300 40l2.4 5 5 2.4-5 2.4-2.4 5-2.4-5-5-2.4 5-2.4z" fill="#38bdf8" />
          <path d="M336 66l1.7 3.6 3.6 1.7-3.6 1.7-1.7 3.6-1.7-3.6-3.6-1.7 3.6-1.7z" fill="rgba(56,189,248,0.6)" />
        </g>
      )
    }

    {
      variant === "chart" && (
        <g>
          <path d="M44 168h312" stroke="rgba(148,163,184,0.25)" />
          <path d="M44 124h312M44 80h312M44 36h312" stroke="rgba(148,163,184,0.1)" />
          <rect x="66" y="122" width="34" height="46" rx="6" fill="rgba(96,165,250,0.35)" />
          <rect x="122" y="102" width="34" height="66" rx="6" fill="rgba(96,165,250,0.5)" />
          <rect x="178" y="112" width="34" height="56" rx="6" fill="rgba(96,165,250,0.45)" />
          <rect x="234" y="74" width="34" height="94" rx="6" fill="#2563eb" />
          <rect x="290" y="48" width="34" height="120" rx="6" fill="#38bdf8" />
          <path d="M83 116 139 96l56 10 56-38 56-26" stroke="#e2e8f0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="7 6" />
          <circle cx="307" cy="42" r="7" fill="#0d1730" stroke="#38bdf8" stroke-width="3" />
        </g>
      )
    }
  </svg>
</div>
