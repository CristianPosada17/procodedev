---
/*
  Página completa de un mercado (un estado).

  Las seis páginas (tres estados × dos idiomas) comparten esta composición;
  el contenido, que es lo que las hace distintas entre sí, vive en
  src/i18n/markets.ts.

  Orden por defecto (sep 2026, lo conserva México): portada → por qué este
  mercado es distinto → cómo se trabaja en remoto + proyectos → testimonios
  → giros → fundador → zonas y precios → dudas → cierre. Desde el 14 oct
  2026 Texas, Florida y California declaran su propio orden y secciones
  propias en src/i18n/market-local.ts.
*/
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import LandingHero from "./LandingHero.astro";
import VisualMarket from "./hero-visuals/VisualMarket.astro";
import { LANDING_TAG } from "./landing-theme";
import ServiceIntro from "./ServiceIntro.astro";
import ServiceStandards from "./ServiceStandards.astro";
import MarketIndustries from "./MarketIndustries.astro";
import MarketCities from "./MarketCities.astro";
import ProofStrip from "./ProofStrip.astro";
import PriceAnchor from "./PriceAnchor.astro";
import FAQ from "./FAQ.astro";
import Testimonials from "./Testimonials.astro";
import Founder from "./Founder.astro";
import LandingConversion from "./LandingConversion.astro";
import Footer from "./Footer.astro";
import MarketRegions from "./market/MarketRegions.astro";
import MarketSignature from "./market/MarketSignature.astro";
import MarketClients from "./market/MarketClients.astro";
import { translations, PAGES, type Lang } from "../i18n/ui";
import { markets, type MarketKey } from "../i18n/markets";
import { marketLocal, MARKET_LAYOUT, DEFAULT_MARKET_LAYOUT } from "../i18n/market-local";

interface Props {
  lang: Lang;
  market: MarketKey;
}
const { lang, market } = Astro.props as Props;
const t = translations[lang];
const m = markets[lang][market];
// 14 oct 2026: Texas, Florida y California tienen orden, regiones, sección
// firma y proyectos propios (src/i18n/market-local.ts). México conserva el
// orden de siempre.
const local = marketLocal[lang][market];
const layout = local ? (MARKET_LAYOUT[market] ?? DEFAULT_MARKET_LAYOUT) : DEFAULT_MARKET_LAYOUT;

// El nodo Service declara el estado como `areaServed`, que es la forma
// correcta de decir «atiendo este territorio» sin fingir una dirección
// física ahí. El catálogo son los giros de ese mercado.
const offerCatalog = m.industries.items.map((i) => ({
  title: i.title,
  description: i.description,
}));
---

<Layout
  lang={lang}
  page={market}
  title={m.meta.title}
  description={m.meta.description}
  keywords={m.meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.markets, path: PAGES.markets[lang] },
    { name: m.name, path: PAGES[market][lang] },
  ]}
  serviceName={m.meta.heroTitleA}
  areaServed={m.name}
  audience={m.navHint}
  offerCatalog={offerCatalog}
  includeFaq={true}
  faqItems={m.faq.items}
>
  <Header lang={lang} page={market} />
  <main>
    {/* 1 · Hero: propuesta para el estado, a quién atiende y los dos CTAs.
        El visual son las ciudades del estado, con su color propio. */}
    <LandingHero
      lang={lang}
      page={market}
      eyebrow={m.name}
      icon="map-pin"
      titleA={m.meta.heroTitleA}
      highlight={m.meta.heroHighlight}
      subtitle={m.meta.heroSubtitle}
      lead={m.meta.description}
      stats={[{
        label: t.priceAnchor.fromLabel,
        value: `$${t.priceAnchor.amount}`,
        note: `${t.priceAnchor.currency} · ${t.priceAnchor.amountNote}`,
      }]}
    >
      <VisualMarket slot="visual" lang={lang} market={m} tag={LANDING_TAG[market] ?? ""} />
    </LandingHero>

    {/* Secciones intermedias: el orden lo decide cada estado (layout). */}
    {
      layout.map((section) => {
        switch (section) {
          case "intro":
            return <ServiceIntro lang={lang} intro={m.intro} icon="map-pin" />;
          case "context":
            return <ServiceStandards lang={lang} standards={m.context} id="lo-que-cambia" />;
          case "remote":
            return <ServiceStandards lang={lang} standards={m.remote} id="en-remoto" />;
          case "proof":
            return <ProofStrip lang={lang} />;
          case "testimonials":
            return <Testimonials lang={lang} />;
          case "industries":
            return <MarketIndustries lang={lang} industries={m.industries} />;
          case "founder":
            return <Founder lang={lang} page={market} />;
          case "cities":
            return <MarketCities lang={lang} market={m} />;
          case "price":
            return <PriceAnchor lang={lang} />;
          case "faq":
            return <FAQ lang={lang} data={m.faq} id="dudas-mercado" />;
          case "regions":
            return local ? <MarketRegions regions={local.regions} /> : null;
          case "signature":
            return local ? <MarketSignature lang={lang} sig={local.signature} /> : null;
          case "clients":
            return local?.clients ? <MarketClients lang={lang} clients={local.clients} /> : null;
          default:
            return null;
        }
      })
    }

    {/* 9 · Cierre: agenda y formulario (Nombre + Email) en esta página */}
    <LandingConversion
      lang={lang}
      page={market}
      close={{ eyebrow: `// ${m.name}`, title: m.meta.heroSubtitle }}
      service={m.meta.heroTitleA}
    />
  </main>
  <Footer lang={lang} />
</Layout>
