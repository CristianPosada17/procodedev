---
import { translations, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
interface Props {
  lang?: Lang;
  /** En /servicios el H1 de PageHero ya dice esto: no repetirlo (hallazgo #13). */
  showHeading?: boolean;
}
const { lang = "es", showHeading = true } = Astro.props as Props;
const t = translations[lang];
const s = t.services;
---

<section id="servicios" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    {
      showHeading && (
        <SectionHeading eyebrow={s.eyebrow}>
          <Fragment slot="title">
            {s.titleA}{" "}<span class="grad-text">{s.titleHighlight}</span>{s.titleB && " " + s.titleB}
          </Fragment>
          <Fragment slot="subtitle">{s.subtitle}</Fragment>
        </SectionHeading>
      )
    }

    <div class:list={[showHeading ? "mt-12" : "mt-2", "grid gap-5 md:grid-cols-2 lg:grid-cols-3"]}>
      {
        s.items.map((item, i) => (
          <article
            class="reveal group flex flex-col rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/70 p-7 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)] hover:shadow-[0_20px_60px_-30px_rgba(37,99,235,0.5)]"
            style={`--reveal-delay: ${i * 70}ms`}
          >
            <div class="flex items-center justify-between">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--brand)]/10 text-[var(--accent)]">
                <Icon name={item.icon as any} class="h-6 w-6" />
              </span>
              <span class="font-mono text-[10px] uppercase tracking-widest text-[var(--muted)]">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>
            <p class="mt-5 font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]">
              {item.category}
            </p>
            <h3 class="mt-2 text-lg font-bold leading-snug text-[var(--text)]">
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-7 text-[var(--muted)]">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
