---
import { translations, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";
import CardRail from "./CardRail.astro";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const w = t.why;
---

<section id="por-que" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-16">
      <div class="reveal lg:sticky lg:top-28">
        <span class="eyebrow">{w.eyebrow}</span>
        <h2 class="mt-5 text-3xl font-bold leading-[1.1] tracking-tight text-[var(--text)] sm:text-4xl lg:text-5xl">
          {w.titleA}{" "}<span class="grad-text">{w.titleHighlight}</span>{w.titleB && " " + w.titleB}
        </h2>
        <p class="mt-6 text-base leading-8 text-[var(--muted)]">
          {w.subtitle}
        </p>
      </div>

      {/* El bloque «En una frase» se retiró: repetía en un párrafo largo lo
          que estas cinco tarjetas ya dicen en cinco líneas. */}
      <CardRail grid="md:grid-cols-2" peek="wide">
        {
          w.items.map((b, i) => (
            <div
              class="reveal flex flex-col gap-3 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/70 p-6 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)]"
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--brand)]/10 text-[var(--accent)]">
                <Icon name={b.icon as any} class="h-6 w-6" />
              </span>
              <h3 class="text-base font-bold leading-snug text-[var(--text)]">{b.title}</h3>
              <p class="text-sm leading-6 text-[var(--muted)]">{b.description}</p>
            </div>
          ))
        }
      </CardRail>
    </div>
  </div>
</section>
