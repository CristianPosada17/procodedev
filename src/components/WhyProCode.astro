---
import { translations, type Lang } from "../i18n/ui";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const w = t.why;
---

<section id="por-que" class="relative py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="reveal lg:sticky lg:top-28">
        <span class="eyebrow">{w.eyebrow}</span>
        <h2 class="mt-5 text-3xl font-bold leading-[1.1] tracking-tight text-[var(--text)] sm:text-4xl lg:text-5xl">
          {w.titleA}{" "}<span class="grad-text">{w.titleHighlight}</span>{" "}{w.titleB}
        </h2>
        <p class="mt-6 text-base leading-8 text-[var(--muted)]">
          {w.subtitle}
        </p>

        <div class="mt-8 rounded-[var(--radius)] border border-[color:var(--border-strong)] bg-[var(--brand)]/[0.06] p-6">
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]">
            {w.philosophyTitle}
          </p>
          <p class="mt-3 text-sm leading-7 text-[var(--text)]/90">
            {w.philosophyText}
          </p>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          w.items.map((b, i) => (
            <div
              class="reveal flex flex-col gap-3 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/70 p-6 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)]"
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--brand)]/10 text-lg">
                {b.icon}
              </span>
              <h3 class="text-base font-bold text-[var(--text)]">{b.title}</h3>
              <p class="text-sm leading-6 text-[var(--muted)]">{b.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
