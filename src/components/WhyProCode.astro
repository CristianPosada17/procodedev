---
import { translations, type Lang } from "../i18n/ui";
import ShotStack from "./ShotStack.astro";
import CardRail from "./CardRail.astro";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const w = t.why;
---

<section id="por-que" class="band-mist relative py-16 lg:py-28">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start lg:gap-16">
      <div class="reveal lg:sticky lg:top-28">
        <span class="eyebrow">{w.eyebrow}</span>
        <h2 class="section-title mt-5 text-balance font-bold text-[var(--text)]">
          {w.titleA}{" "}<span class="grad-text">{w.titleHighlight}</span>{w.titleB && " " + w.titleB}
        </h2>
        <p class="mt-6 text-base leading-8 text-[var(--muted)]">
          {w.subtitle}
        </p>
        {/* Nov 2026: sitios reales publicados en lugar de iconos. */}
        <ShotStack class="mt-10 hidden lg:block" shots={["proyecto-izcalli", "proyecto-miconta", "proyecto-fersilva"]} />
      </div>

      {/* El bloque «En una frase» se retiró: repetía en un párrafo largo lo
          que estas cinco tarjetas ya dicen en cinco líneas. */}
      <CardRail grid="md:grid-cols-2" peek="wide">
        {
          w.items.map((b, i) => (
            <div
              class:list={[
                "card-pro reveal group relative flex flex-col gap-3 overflow-hidden rounded-[var(--radius)] p-7",
                i === 0 && "md:col-span-2 md:min-h-[13rem] md:justify-end",
              ]}
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <span class:list={["num-ghost pointer-events-none absolute right-5 top-3 select-none", i === 0 ? "text-[7rem]" : "text-[4.5rem]"]} aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="h-1 w-10 rounded-full bg-gradient-to-r from-[var(--brand)] to-[var(--accent)] transition-all duration-500 group-hover:w-20" aria-hidden="true"></span>
              <h3 class:list={["relative max-w-[26ch] font-bold leading-snug text-[var(--text)]", i === 0 ? "text-2xl" : "text-lg"]}>{b.title}</h3>
              <p class="relative text-sm leading-6 text-[var(--muted)]">{b.description}</p>
            </div>
          ))
        }
      </CardRail>
    </div>
  </div>
</section>
