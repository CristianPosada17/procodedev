---
import { translations, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import CardRail from "./CardRail.astro";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const tt = t.testimonials;
---

<section id="testimonios" class="band-mist relative py-16 lg:py-28">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <SectionHeading eyebrow={tt.eyebrow} max="max-w-3xl">
      <Fragment slot="title">
        {tt.titleA}{" "}<span class="grad-text">{tt.titleHighlight}</span>{tt.titleB && " " + tt.titleB}
      </Fragment>
      <Fragment slot="subtitle">{tt.subtitle}</Fragment>
    </SectionHeading>

    <CardRail class="mt-8 lg:mt-12" grid="md:grid-cols-3" peek="wide">
      {
        tt.items.map((item, i) => (
          <figure
            class="card-pro reveal relative flex flex-col overflow-hidden rounded-[var(--radius-lg)] p-8"
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <div class="num-mark -mb-2 h-14 text-[5.5rem] leading-none" aria-hidden="true">“</div>
            <blockquote class="flex-1 text-[15px] leading-7 text-[var(--text)]/90">
              {item.quote}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-[color:var(--border)] pt-5">
              <span class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-gradient-to-br from-[var(--brand)] to-[var(--accent)] p-[2px]">
                <span class="flex h-full w-full items-center justify-center rounded-full bg-[var(--surface)] font-mono text-sm font-bold text-[var(--accent)]">
                {item.initials}
                </span>
              </span>
              <div>
                <p class="text-sm font-bold text-[var(--text)]">{item.name}</p>
                <p class="text-xs text-[var(--muted)]">{item.role}</p>
              </div>
            </figcaption>
            <p class="mt-3 font-mono text-[10px] uppercase tracking-wider text-[var(--muted)]">
              {item.service}
            </p>

            {/* Hallazgo #5: un testimonio sin nada verificable pesa poco. El
                dominio sigue a la vista para que se pueda comprobar, pero ya
                no es un enlace: la conversión no debe sacar a nadie del sitio. */}
            {item.urlLabel && (
              <p class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--muted)]">
                <span class="ui-dot-live" aria-hidden="true"></span>
                <span class="font-mono text-[11px]">{item.urlLabel}</span>
              </p>
            )}
          </figure>
        ))
      }
    </CardRail>
  </div>
</section>
