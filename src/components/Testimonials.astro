---
import Icon from "./Icon.astro";
import { translations, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import CardRail from "./CardRail.astro";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const tt = t.testimonials;
---

<section id="testimonios" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <SectionHeading eyebrow={tt.eyebrow} max="max-w-3xl">
      <Fragment slot="title">
        {tt.titleA}{" "}<span class="grad-text">{tt.titleHighlight}</span>{tt.titleB && " " + tt.titleB}
      </Fragment>
      <Fragment slot="subtitle">{tt.subtitle}</Fragment>
    </SectionHeading>

    <CardRail class="mt-8 lg:mt-12" grid="md:grid-cols-3" peek="wide">
      {
        tt.items.map((item, i) => (
          <figure
            class="reveal flex flex-col rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/70 p-7 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)]"
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <div class="font-mono text-3xl text-[var(--brand)]/50">“</div>
            <blockquote class="flex-1 text-sm leading-7 text-[var(--text)]/90">
              {item.quote}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-[color:var(--border)] pt-5">
              <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-[var(--brand)]/15 font-mono text-sm font-bold text-[var(--accent)]">
                {item.initials}
              </span>
              <div>
                <p class="text-sm font-bold text-[var(--text)]">{item.name}</p>
                <p class="text-xs text-[var(--muted)]">{item.role}</p>
              </div>
            </figcaption>
            <p class="mt-3 font-mono text-[10px] uppercase tracking-wider text-[var(--muted)]">
              {item.service}
            </p>

            {/* Hallazgo #5: un testimonio sin nada verificable pesa poco.
                Enlazar el sitio en vivo lo convierte en prueba comprobable. */}
            {item.url && (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--accent)] transition hover:underline"
              >
                {tt.visitSite}
                <span class="font-mono text-[10px] text-[var(--muted)]">
                  {item.urlLabel}
                </span>
                <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
              </a>
            )}
          </figure>
        ))
      }
    </CardRail>
  </div>
</section>
