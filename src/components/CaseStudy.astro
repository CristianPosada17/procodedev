---
import { translations, PAGES, conversionHref, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  lang?: Lang;
  /**
   * "page" (portafolio): caso completo. "home": título y resumen propios y
   * solo las primeras cuatro viñetas, para no duplicar el bloque del
   * portafolio palabra por palabra.
   */
  variant?: "page" | "home";
}
const { lang = "es", variant = "page" } = Astro.props as Props;
const t = translations[lang];
const c = t.caseStudy;
const isHome = variant === "home";
const eyebrow = isHome ? c.homeEyebrow : c.eyebrow;
const titleA = isHome ? c.homeTitleA : c.titleA;
const highlight = isHome ? c.homeHighlight : c.titleHighlight;
const summary = isHome ? c.homeSummary : c.summary;
const solution = isHome ? c.solution.slice(0, 4) : c.solution;
// Enlace interno a la página del giro del caso (p. ej. /contabilidad-e-impuestos/).
const segmentHref = PAGES[c.segmentPage as keyof typeof PAGES]?.[lang];
// Mismas variantes responsivas que PortfolioCard (2026-09-05). Aqui la
// captura ocupa media pantalla en escritorio y el ancho completo en movil.
const base = c.image?.replace(/\.(jpg|jpeg|png|webp)$/i, "");
const srcset = (ext: string) =>
  base
    ? [400, 800, 1200].map((w) => `${base}-${w}.${ext} ${w}w`).join(", ")
    : undefined;
const SIZES = "(min-width: 1024px) 48vw, 100vw";
---

{/*
  El bloque «proyecto destacado» llevaba meses sin destacar ningún proyecto:
  describía en abstracto lo que lleva dentro un buen sitio. Ahora es un caso
  concreto, con captura, dominio, problema, solución y stack. Septiembre de
  2026 (30): el dominio queda escrito pero sin enlace, para que la página no
  saque al visitante del sitio.
*/}
<section id="destacado" class="relative py-12 lg:py-20">
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <SectionHeading eyebrow={eyebrow}>
      <Fragment slot="title">
        {titleA}{" "}<span class="grad-text">{highlight}</span>
      </Fragment>
      <Fragment slot="subtitle">{summary}</Fragment>
    </SectionHeading>

    <div
      class="reveal mt-10 overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/70 backdrop-blur-xl"
    >
      <div class="grid gap-0 lg:grid-cols-[1.05fr_0.95fr]">
        {/* ── Captura del proyecto ── */}
        <div
          class="flex items-center border-b border-[color:var(--border)] bg-[var(--bg-2)] lg:border-b-0 lg:border-r lg:p-8"
        >
        <div
          class="relative block aspect-[2/1] w-full overflow-hidden lg:rounded-[var(--radius)] lg:border lg:border-[color:var(--border)] lg:shadow-[var(--shadow-media)]"
        >
          <picture>
            <source type="image/avif" sizes={SIZES} srcset={srcset("avif")} />
            <source type="image/webp" sizes={SIZES} srcset={srcset("webp")} />
            <img
              src={base ? `${base}-800.webp` : c.image}
              alt={c.imageAlt}
              loading="lazy"
              decoding="async"
              width="1200"
              height="600"
              class="h-full w-full object-cover object-top"
            />
          </picture>
          <span
            class="absolute left-4 top-4 rounded-full border border-[color:var(--border-strong)] bg-[var(--bg)]/85 px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-[var(--accent)] backdrop-blur"
          >
            {c.badge}
          </span>
          {/* Dominio escrito, no enlazado: ningún enlace de conversión saca
              al visitante del sitio (septiembre de 2026). */}
          <span
            class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full bg-[var(--bg)]/85 px-4 py-2 font-mono text-[11px] text-[var(--text)] backdrop-blur"
          >
            <Icon name="globe" class="h-3.5 w-3.5 text-[var(--accent)]" />
            {c.urlLabel}
          </span>
        </div>
        </div>

        {/* ── Lectura del caso ── */}
        <div class="p-8 lg:p-12">
          <h3 class="text-2xl font-bold tracking-tight text-[var(--text)]">
            {c.name}
          </h3>

          <p
            class="mt-6 font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]"
          >
            {c.challengeTitle}
          </p>
          <p class="mt-3 text-sm leading-7 text-[var(--muted)]">
            {c.challengeBody}
          </p>

          <p
            class="mt-8 font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]"
          >
            {c.solutionTitle}
          </p>
          <ul class="mt-4 grid gap-3">
            {
              solution.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-6 text-[var(--text)]/90">
                  <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-md bg-[var(--brand)]/15 text-[var(--accent)]">
                    <Icon name="check" class="h-3.5 w-3.5" strokeWidth={2.4} />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>

          <p
            class="mt-8 font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]"
          >
            {c.stackTitle}
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              c.stack.map((tech) => (
                <span class="rounded-full border border-[color:var(--border)] px-3 py-1 text-[11px] text-[var(--muted)]">
                  {tech}
                </span>
              ))
            }
          </div>

          {
            segmentHref && (
              <a
                href={segmentHref}
                class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-[var(--accent)] underline-offset-4 transition hover:underline"
              >
                {c.segmentLinkLabel}
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            )
          }
        </div>
      </div>

      {/* ── Cifras verificables (nada estimado, nada inventado) ── */}
      <div
        class="grid gap-px border-t border-[color:var(--border)] bg-[color:var(--border)] sm:grid-cols-3"
      >
        {
          c.facts.map((fact) => (
            <div class="bg-[var(--bg-2)] px-6 py-6 text-center">
              <p class="font-mono text-3xl font-bold text-[var(--accent)]">
                {fact.value}
              </p>
              <p class="mt-1 text-xs leading-5 text-[var(--muted)]">
                {fact.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="reveal mt-10 flex flex-col justify-center gap-4 sm:flex-row">
      <a
        href={conversionHref(isHome ? "home" : "portfolio", lang, "book")}
        data-cta="caso-agendar"
        class="btn-cta"
      >
        {c.cta}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <a
        href={conversionHref(isHome ? "home" : "portfolio", lang, "info")}
        data-cta="caso-info"
        class="btn-secondary"
      >
        {t.contact.ctaInfo}
      </a>
    </div>
  </div>
</section>
