---
import { translations, PAGES, type Lang } from "../i18n/ui";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const c = t.caseStudy;
---

<section class="relative py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div
      class="reveal overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/70 backdrop-blur-xl"
    >
      <div class="grid gap-0 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="p-8 lg:p-12">
          <span class="eyebrow">{c.eyebrow}</span>
          <h2 class="mt-5 text-3xl font-bold leading-[1.1] tracking-tight text-[var(--text)] sm:text-4xl">
            {c.titleA}{" "}<span class="grad-text">{c.titleHighlight}</span>
          </h2>
          <p class="mt-5 text-base leading-8 text-[var(--muted)]">
            {c.subtitle}
          </p>

          <p class="mt-8 font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]">
            {c.includesTitle}
          </p>
          <ul class="mt-4 grid gap-3">
            {
              c.includes.map((it) => (
                <li class="flex items-start gap-3 text-sm text-[var(--text)]/90">
                  <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-md bg-[var(--brand)]/15 text-xs text-[var(--accent)]">
                    ✓
                  </span>
                  {it}
                </li>
              ))
            }
          </ul>

          <a
            href={PAGES.contact[lang]}
            class="mt-8 inline-flex items-center justify-center rounded-xl bg-[var(--brand)] px-6 py-3.5 text-sm font-bold text-white transition hover:bg-[var(--brand-strong)]"
          >
            {c.cta} <span class="ml-2">→</span>
          </a>
        </div>

        <div class="relative border-t border-[color:var(--border)] bg-[var(--bg-2)] p-8 lg:border-l lg:border-t-0 lg:p-12">
          <div class="tech-grid absolute inset-0 opacity-30"></div>
          <div class="relative grid gap-4">
            <div class="rounded-2xl border border-[color:var(--border-strong)] bg-gradient-to-br from-[var(--brand)]/20 to-transparent p-6">
              <p class="font-mono text-[10px] uppercase tracking-widest text-[var(--muted)]">
                01
              </p>
              <h3 class="mt-2 text-lg font-bold text-[var(--text)]">
                {lang === "es" ? "Presencia profesional" : "Professional presence"}
              </h3>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
                {lang === "es"
                  ? "Tu negocio visible, claro y listo para convertir."
                  : "Your business visible, clear and ready to convert."}
              </p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="rounded-2xl border border-[color:var(--border)] bg-white/[0.04] p-5">
                <p class="font-mono text-2xl font-bold text-[var(--accent)]">24/7</p>
                <p class="mt-1 text-xs text-[var(--muted)]">
                  {lang === "es" ? "Captación activa" : "Active capture"}
                </p>
              </div>
              <div class="rounded-2xl border border-[color:var(--border)] bg-white/[0.04] p-5">
                <p class="font-mono text-2xl font-bold text-[var(--text)]">CRM</p>
                <p class="mt-1 text-xs text-[var(--muted)]">
                  {lang === "es" ? "Seguimiento" : "Follow-up"}
                </p>
              </div>
            </div>
            <div class="rounded-2xl border border-[color:var(--border)] bg-white/[0.04] p-5">
              <p class="text-xs text-[var(--muted)]">
                {lang === "es" ? "Agenda tu cita" : "Book your appointment"}
              </p>
              <p class="mt-1 text-sm text-[var(--text)]/90">
                {lang === "es"
                  ? "Formulario conectado a WhatsApp o CRM."
                  : "Form connected to WhatsApp or CRM."}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
