---
import Icon from "./Icon.astro";
import { translations, CONTACT, PAGES, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import CardRail from "./CardRail.astro";
interface Props {
  lang?: Lang;
  /** En /precios el H1 de PageHero ya dice esto: no repetirlo (hallazgo #13). */
  showHeading?: boolean;
}
const { lang = "es", showHeading = true } = Astro.props as Props;
const t = translations[lang];
const p = t.pricing;
const adv = p.advisory;
const waLink = (text: string) =>
  `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(text)}`;

// Identificador estable para medición: los nombres comerciales llevan
// acentos, espacios y guiones largos que ensucian los informes de GA4.
const ctaSlug = (name: string) =>
  name
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

// Septiembre de 2026: el sitio dejó de mostrar precios en pesos. El mercado
// es el negocio de servicios latino en EE. UU. y la facturación siempre fue en
// dólares, así que el selector de moneda y la equivalencia en MXN se
// eliminaron: dos números por tarjeta hacían dudar de cuál era el precio real.
---

<section id="pricing" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    {
      showHeading && (
        <SectionHeading eyebrow={p.eyebrow} max="max-w-3xl">
          <Fragment slot="title">
            {p.titleA}{" "}<span class="grad-text">{p.titleHighlight}</span>{p.titleB && " " + p.titleB}
          </Fragment>
          <Fragment slot="subtitle">{p.subtitle}</Fragment>
        </SectionHeading>
      )
    }

    {/* ── Auditoría Digital · el producto de entrada de pago ──
        Sustituye al Diagnóstico de $149, que se acreditaba entero al
        proyecto. Aquí solo va el resumen y el precio: la explicación
        completa vive en su propia landing, /servicios/auditoria/. */}
    <div
      class="reveal relative mt-12 overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface-2)]/80 p-8 backdrop-blur-xl shadow-[0_30px_80px_-40px_var(--halo-card)] lg:p-10"
    >
      <div
        class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-[var(--brand)]/10 blur-3xl"
      >
      </div>
      <div class="relative grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:items-start">
        <div>
          <span
            class="inline-flex items-center rounded-full border border-[color:var(--border-strong)] bg-[var(--brand)]/15 px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-[var(--accent)]"
          >
            {adv.badge}
          </span>
          <h2 class="mt-4 text-2xl font-bold text-[var(--text)]">{adv.name}</h2>
          <div class="mt-4 flex items-end gap-1.5">
            <span class="font-mono text-4xl font-bold text-[var(--text)]">
              ${adv.price}
            </span>
            <span class="mb-1.5 text-xs text-[var(--muted)]">{adv.currency}</span>
          </div>
          <p class="mt-1 text-xs text-[var(--muted)]">{adv.priceNote}</p>
          <p class="mt-5 text-base font-bold text-[var(--text)]">{adv.hook}</p>
          <p class="mt-3 text-sm leading-6 text-[var(--muted)]">
            {adv.description}
          </p>
          <div
            class="mt-6 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-4"
          >
            <p class="text-sm leading-6 text-[var(--text)]/90">{adv.creditNote}</p>
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            {/* El primario lleva a la landing, no a WhatsApp: hay una
                página entera explicando qué se audita y qué se entrega, y
                mandar a un chat obligaba a preguntarlo. */}
            <a
              href={PAGES.audit[lang]}
              data-cta="precios-auditoria"
              class="inline-flex items-center justify-center rounded-xl bg-[var(--brand)] px-6 py-3.5 text-sm font-bold text-white transition hover:bg-[var(--brand-strong)]"
            >
              {adv.cta}
            </a>
            <a
              href={waLink(adv.waText)}
              data-cta="precios-auditoria-whatsapp"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-[color:var(--border-strong)] bg-[var(--tint)] px-6 py-3.5 text-sm font-bold text-[var(--text)] transition hover:bg-[var(--brand)]/12"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              {t.common.ctaWhatsapp}
            </a>
          </div>
        </div>

        <div>
          <p
            class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--accent)]"
          >
            {adv.stepsTitle}
          </p>
          <ol class="mt-5 grid gap-4">
            {
              adv.steps.map((s, i) => (
                <li class="flex items-start gap-4 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-5">
                  <span class="flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-[var(--brand)]/15 font-mono text-sm font-bold text-[var(--accent)]">
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="text-sm font-bold text-[var(--text)]">{s.name}</h3>
                    <p class="mt-1 text-sm leading-6 text-[var(--muted)]">
                      {s.description}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    {/* ── Paquetes principales ── */}
    <CardRail class="mt-8 lg:mt-12" grid="lg:grid-cols-3" peek="wide" gap="gap-5 lg:gap-6">
      {
        p.packages.map((pkg, i) => (
          <div
            class:list={[
              "reveal relative flex flex-col rounded-[var(--radius-lg)] border p-8 backdrop-blur-xl transition duration-300 hover:-translate-y-1",
              pkg.highlighted
                ? "border-[color:var(--border-strong)] bg-[var(--surface-2)]/80 shadow-[0_30px_80px_-40px_var(--halo-card-strong)]"
                : "border-[color:var(--border)] bg-[var(--surface)]/60",
            ]}
            style={`--reveal-delay: ${i * 90}ms`}
          >
            {pkg.highlighted && (
              <span class="absolute -top-3 left-8 rounded-full bg-[var(--brand)] px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-white">
                {p.popular}
              </span>
            )}
            <h3 class="text-lg font-bold text-[var(--text)]">{pkg.name}</h3>
            <p class="mt-1 text-sm text-[var(--accent)]">{pkg.tagline}</p>
            <div class="mt-5 flex items-end gap-1.5">
              {pkg.pricePrefix && (
                <span class="mb-1.5 text-xs font-medium text-[var(--muted)]">
                  {pkg.pricePrefix}
                </span>
              )}
              <span class="font-mono text-4xl font-bold text-[var(--text)]">
                ${pkg.price}
              </span>
              <span class="mb-1.5 text-xs text-[var(--muted)]">{pkg.currency}</span>
            </div>
            <p class="mt-4 text-sm leading-6 text-[var(--muted)]">
              {pkg.description}
            </p>
            <ul class="mt-6 grid flex-1 gap-3">
              {pkg.features.map((f) => (
                <li class="flex items-start gap-3 text-sm text-[var(--text)]/90">
                  <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-md bg-[var(--brand)]/15 text-[var(--accent)]">
                    <Icon name="check" class="h-3.5 w-3.5" strokeWidth={2.4} />
                  </span>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href={waLink(pkg.waText)}
              data-cta={`precios-paquete-${ctaSlug(pkg.name)}`}
              target="_blank"
              rel="noopener"
              class:list={[
                "mt-8 inline-flex items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold transition",
                pkg.highlighted
                  ? "bg-[var(--brand)] text-white hover:bg-[var(--brand-strong)]"
                  : "border border-[color:var(--border-strong)] bg-[var(--tint)] text-[var(--text)] hover:bg-[var(--brand)]/10",
              ]}
            >
              {pkg.cta}
            </a>
          </div>
        ))
      }
    </CardRail>

    {/* ── Servicios adicionales ── */}
    <div class="reveal mt-14">
      <h2 class="text-lg font-bold text-[var(--text)]">{p.extrasTitle}</h2>
      <p class="mt-1 text-sm text-[var(--muted)]">{p.extrasSubtitle}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          p.extras.map((ex) => (
            <div class="rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-6">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="text-sm font-bold text-[var(--text)]">{ex.name}</h3>
                <span class="font-mono text-xs text-[var(--accent)]">
                  {ex.price}
                </span>
              </div>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{ex.description}</p>
              <p class="mt-2 font-mono text-[10px] uppercase tracking-wider text-[var(--muted)]">
                {ex.unit}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    {/* ── Escalera de planes mensuales: Soporte → Crecimiento+ → Todo incluido ──
        Antes había un único plan de mantenimiento, así que el cliente no tenía
        a dónde subir. Estos tres crean el techo de expansión que pedía el
        análisis de mercado. */}
    <div class="reveal mt-16">
      <h2 class="text-2xl font-bold text-[var(--text)]">{p.monthlyTitle}</h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--muted)]">
        {p.monthlySubtitle}
      </p>
    </div>

    <CardRail class="mt-8" grid="lg:grid-cols-3" peek="wide" gap="gap-5 lg:gap-6">
      {
        p.monthly.map((plan, i) => (
          <div
            class:list={[
              "reveal relative flex flex-col rounded-[var(--radius-lg)] border p-8 backdrop-blur-xl transition duration-300 hover:-translate-y-1",
              plan.highlighted
                ? "border-[color:var(--border-strong)] bg-[var(--surface-2)]/80 shadow-[0_30px_80px_-40px_var(--halo-card-strong)]"
                : "border-[color:var(--border)] bg-[var(--surface)]/60",
            ]}
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <span
              class:list={[
                "inline-flex w-fit items-center rounded-full border px-3 py-1 font-mono text-[10px] uppercase tracking-wider",
                plan.highlighted
                  ? "border-[color:var(--border-strong)] bg-[var(--brand)]/20 text-[var(--accent)]"
                  : "border-[color:var(--border)] bg-[var(--tint)] text-[var(--muted)]",
              ]}
            >
              {plan.badge}
            </span>
            <h3 class="mt-4 text-xl font-bold text-[var(--text)]">{plan.name}</h3>
            <p class="mt-1 text-sm text-[var(--accent)]">{plan.tagline}</p>
            <div class="mt-5 flex flex-wrap items-end gap-1.5">
              {plan.pricePrefix && (
                <span class="mb-1.5 text-xs font-medium text-[var(--muted)]">
                  {plan.pricePrefix}
                </span>
              )}
              <span class="font-mono text-4xl font-bold text-[var(--text)]">
                ${plan.price}
              </span>
              <span class="mb-1.5 text-xs text-[var(--muted)]">
                {plan.currency}
              </span>
            </div>
            <p class="mt-1 text-xs text-[var(--muted)]">{plan.priceNote}</p>
            {plan.commitmentNote && (
              <p class="mt-3 flex items-start gap-2 rounded-xl border border-[color:var(--border)] bg-[var(--tint)] px-3 py-2 text-xs leading-5 text-[var(--muted)]">
                <Icon
                  name="calendar"
                  class="mt-0.5 h-3.5 w-3.5 flex-none text-[var(--accent)]"
                />
                {plan.commitmentNote}
              </p>
            )}
            <p class="mt-5 text-sm leading-6 text-[var(--muted)]">
              {plan.description}
            </p>
            <ul class="mt-6 grid flex-1 gap-3">
              {plan.features.map((f) => (
                <li class="flex items-start gap-3 text-sm leading-6 text-[var(--text)]/90">
                  <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-md bg-[var(--brand)]/15 text-[var(--accent)]">
                    <Icon name="check" class="h-3.5 w-3.5" strokeWidth={2.4} />
                  </span>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href={waLink(plan.waText)}
              data-cta={`precios-plan-${ctaSlug(plan.name)}`}
              target="_blank"
              rel="noopener"
              class:list={[
                "mt-8 inline-flex items-center justify-center rounded-xl px-6 py-3.5 text-sm font-bold transition",
                plan.highlighted
                  ? "bg-[var(--brand)] text-white hover:bg-[var(--brand-strong)]"
                  : "border border-[color:var(--border-strong)] bg-[var(--tint)] text-[var(--text)] hover:bg-[var(--brand)]/10",
              ]}
            >
              {plan.cta}
            </a>
          </div>
        ))
      }
    </CardRail>

    <p class="reveal mt-6 max-w-3xl text-xs leading-6 text-[var(--muted)]">
      {p.monthlyNote}
    </p>

    {/* Todos los precios en USD: ya no hay selector de moneda, así que la
        nota de moneda vive con la letra pequeña del final. */}
    <p class="reveal mt-6 max-w-3xl text-xs leading-6 text-[var(--muted)]">
      {p.currencyNoteUsd}
    </p>

    <p class="reveal mt-8 max-w-3xl text-xs leading-6 text-[var(--muted)]">
      {p.note}
    </p>
  </div>
</section>

