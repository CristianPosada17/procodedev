---
import Icon from "./Icon.astro";
import { translations, CONTACT, PAGES, type Lang, type PageKey } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import CardRail from "./CardRail.astro";
interface Props {
  lang?: Lang;
  /** En /precios el H1 de PageHero ya dice esto: no repetirlo (hallazgo #13). */
  showHeading?: boolean;
}
const { lang = "es", showHeading = true } = Astro.props as Props;
const t = translations[lang];
const p = t.pricing;
const adv = p.advisory;
const waLink = (text: string) =>
  `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(text)}`;
const pageHref = (key: string) =>
  key ? PAGES[key as PageKey][lang] : "";

// Identificador estable para medición: los nombres comerciales llevan
// acentos, espacios y guiones largos que ensucian los informes de GA4.
const ctaSlug = (name: string) =>
  name
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

// Septiembre de 2026: el sitio dejó de mostrar precios en pesos. El mercado
// es el negocio de servicios latino en EE. UU. y la facturación siempre fue en
// dólares, así que el selector de moneda y la equivalencia en MXN se
// eliminaron: dos números por tarjeta hacían dudar de cuál era el precio real.
//
// Septiembre de 2026 (29): la página se reordenó para que el visitante vea
// primero las opciones y sus precios base —todos «Desde»— y después el
// resto: mensuales, adicionales, la Auditoría Estratégica (antes iba arriba
// de todo, con su explicación larga) y las condiciones. La explicación
// extensa de cada servicio vive en su propia página; aquí solo lo necesario
// para comparar.
const cardBase =
  "reveal relative flex flex-col rounded-[var(--radius-lg)] border p-7 backdrop-blur-xl transition duration-300 hover:-translate-y-1";
const cardTone = (strong: boolean) =>
  strong
    ? "border-[color:var(--border-strong)] bg-[var(--surface-2)]/80 shadow-[0_30px_80px_-40px_var(--halo-card-strong)]"
    : "border-[color:var(--border)] bg-[var(--surface)]/60";
---

<div id="pricing" class="relative">
  {
    showHeading && (
      <div class="mx-auto w-full max-w-[1480px] px-4 pt-12 sm:px-6 lg:px-10 lg:pt-20 2xl:max-w-[1600px]">
        <SectionHeading eyebrow={p.eyebrow} max="max-w-3xl">
          <Fragment slot="title">
            {p.titleA}{" "}<span class="grad-text">{p.titleHighlight}</span>{p.titleB && " " + p.titleB}
          </Fragment>
          <Fragment slot="subtitle">{p.subtitle}</Fragment>
        </SectionHeading>
      </div>
    )
  }

  {/* ── 1. Desarrollo web: pago único ── */}
  <section id="desarrollo-web" class="relative py-10 lg:py-14">
    <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
      <div class="reveal max-w-3xl">
        <h2 class="text-2xl font-bold text-[var(--text)]">{p.summaryTitle}</h2>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{p.summarySubtitle}</p>
      </div>

      <CardRail class="mt-8" grid="lg:grid-cols-3" peek="wide" gap="gap-5 lg:gap-6">
        {
          p.packages.map((pkg, i) => (
            <article class:list={[cardBase, cardTone(pkg.highlighted)]} style={`--reveal-delay: ${i * 90}ms`}>
              {pkg.highlighted && (
                <span class="absolute -top-3 left-7 rounded-full bg-[var(--brand)] px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-white">
                  {p.popular}
                </span>
              )}
              <h3 class="text-lg font-bold text-[var(--text)]">{pkg.name}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
                <span class="sr-only">{p.forWhoLabel}: </span>{pkg.forWho}
              </p>
              <p class="mt-5 flex flex-wrap items-end gap-x-1.5">
                <span class="mb-1.5 text-xs font-semibold text-[var(--muted)]">{pkg.pricePrefix}</span>
                <span class="font-mono text-4xl font-bold text-[var(--text)]">${pkg.price}</span>
                <span class="mb-1.5 text-xs text-[var(--muted)]">{pkg.currency}</span>
              </p>
              <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--muted)]">
                {pkg.priceNote}
              </p>
              <ul class="mt-5 grid flex-1 gap-2.5 border-t border-[color:var(--border)] pt-5">
                {pkg.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm leading-6 text-[var(--text)]/90">
                    <span class="mt-1 flex h-4 w-4 flex-none items-center justify-center rounded bg-[var(--brand)]/15 text-[var(--accent)]">
                      <Icon name="check" class="h-2.5 w-2.5" strokeWidth={3} />
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
              <a
                href={waLink(pkg.waText)}
                data-cta={`precios-paquete-${ctaSlug(pkg.name)}`}
                target="_blank"
                rel="noopener"
                class:list={[
                  "mt-7 inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-sm font-bold transition",
                  pkg.highlighted
                    ? "bg-[var(--brand)] text-white hover:bg-[var(--brand-strong)]"
                    : "border border-[color:var(--border-strong)] bg-[var(--tint)] text-[var(--text)] hover:bg-[var(--brand)]/10",
                ]}
              >
                <Icon name="whatsapp" class="h-4 w-4" />
                {pkg.cta}
              </a>
              <a
                href={pageHref(pkg.href)}
                data-cta={`precios-detalle-${ctaSlug(pkg.name)}`}
                class="mt-3 inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-[var(--accent)] hover:underline"
              >
                {p.detailsLabel}
                <Icon name="arrow-right" class="h-3.5 w-3.5" />
              </a>
            </article>
          ))
        }
      </CardRail>
    </div>
  </section>

  {/* ── 2. Servicios mensuales ── */}
  <section id="mensuales" class="relative py-10 lg:py-14">
    <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
      <div class="reveal max-w-3xl">
        <h2 class="text-2xl font-bold text-[var(--text)]">{p.monthlySummaryTitle}</h2>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{p.monthlySubtitle}</p>
      </div>

      <CardRail class="mt-8" grid="lg:grid-cols-3" peek="wide" gap="gap-5 lg:gap-6">
        {
          p.monthly.map((plan, i) => (
            <article class:list={[cardBase, cardTone(plan.highlighted)]} style={`--reveal-delay: ${i * 90}ms`}>
              <span
                class:list={[
                  "inline-flex w-fit items-center rounded-full border px-3 py-1 font-mono text-[10px] uppercase tracking-wider",
                  plan.highlighted
                    ? "border-[color:var(--border-strong)] bg-[var(--brand)]/20 text-[var(--accent)]"
                    : "border-[color:var(--border)] bg-[var(--tint)] text-[var(--muted)]",
                ]}
              >
                {plan.badge}
              </span>
              <h3 class="mt-4 text-lg font-bold text-[var(--text)]">{plan.name}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
                <span class="sr-only">{p.forWhoLabel}: </span>{plan.forWho}
              </p>
              {/* Crecimiento+ y Marketing Digital no llevan cifra: se cotizan
                  después de la reunión inicial. Cuando el plan trae
                  `quoteLabel`, ese texto sustituye al precio. */}
              <p class="mt-5 flex flex-wrap items-end gap-x-1.5">
                {plan.quoteLabel ? (
                  <span class="text-2xl font-bold tracking-tight text-[var(--text)]">
                    {plan.quoteLabel}
                  </span>
                ) : (
                  <>
                    <span class="mb-1.5 text-xs font-semibold text-[var(--muted)]">{plan.pricePrefix}</span>
                    <span class="font-mono text-4xl font-bold text-[var(--text)]">${plan.price}</span>
                    <span class="mb-1.5 text-xs text-[var(--muted)]">{plan.currency}</span>
                  </>
                )}
              </p>
              <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--muted)]">
                {plan.priceNote}
              </p>
              {plan.commitmentNote && (
                <p class="mt-3 flex items-start gap-2 rounded-xl border border-[color:var(--border)] bg-[var(--tint)] px-3 py-2 text-xs leading-5 text-[var(--muted)]">
                  <Icon name="calendar" class="mt-0.5 h-3.5 w-3.5 flex-none text-[var(--accent)]" />
                  {plan.commitmentNote}
                </p>
              )}
              <ul class="mt-5 grid flex-1 gap-2.5 border-t border-[color:var(--border)] pt-5">
                {plan.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm leading-6 text-[var(--text)]/90">
                    <span class="mt-1 flex h-4 w-4 flex-none items-center justify-center rounded bg-[var(--brand)]/15 text-[var(--accent)]">
                      <Icon name="check" class="h-2.5 w-2.5" strokeWidth={3} />
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
              <a
                href={waLink(plan.waText)}
                data-cta={`precios-plan-${ctaSlug(plan.name)}`}
                target="_blank"
                rel="noopener"
                class:list={[
                  "mt-7 inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-sm font-bold transition",
                  plan.highlighted
                    ? "bg-[var(--brand)] text-white hover:bg-[var(--brand-strong)]"
                    : "border border-[color:var(--border-strong)] bg-[var(--tint)] text-[var(--text)] hover:bg-[var(--brand)]/10",
                ]}
              >
                <Icon name="whatsapp" class="h-4 w-4" />
                {plan.cta}
              </a>
              <a
                href={pageHref(plan.href)}
                data-cta={`precios-detalle-${ctaSlug(plan.name)}`}
                class="mt-3 inline-flex items-center justify-center gap-1.5 text-sm font-semibold text-[var(--accent)] hover:underline"
              >
                {p.detailsLabel}
                <Icon name="arrow-right" class="h-3.5 w-3.5" />
              </a>
            </article>
          ))
        }
      </CardRail>

      <div class="reveal mt-8 grid gap-3 text-sm leading-6 text-[var(--muted)] lg:grid-cols-2">
        <p class="rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--bg-2)]/60 p-5">
          {p.monthlyNote}
        </p>
        <p class="rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--bg-2)]/60 p-5">
          {p.quotedScopeNote}
        </p>
      </div>
    </div>
  </section>

  {/* ── 3. Servicios adicionales ── */}
  <section id="adicionales" class="relative py-10 lg:py-14">
    <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
      <div class="reveal max-w-3xl">
        <h2 class="text-2xl font-bold text-[var(--text)]">{p.extrasTitle}</h2>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{p.extrasSubtitle}</p>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          p.extras.map((ex) => (
            <article class="reveal flex flex-col rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-6">
              <h3 class="text-base font-bold text-[var(--text)]">{ex.name}</h3>
              <p class="mt-2 font-mono text-lg font-bold text-[var(--text)]">{ex.price}</p>
              <p class="font-mono text-[10px] uppercase tracking-wider text-[var(--muted)]">{ex.unit}</p>
              <p class="mt-3 text-sm leading-6 text-[var(--muted)]">
                <span class="sr-only">{p.forWhoLabel}: </span>{ex.forWho}
              </p>
              <p class="mt-2 flex-1 text-sm leading-6 text-[var(--muted)]">{ex.description}</p>
              {ex.href && (
                <a
                  href={pageHref(ex.href)}
                  data-cta={`precios-detalle-${ctaSlug(ex.name)}`}
                  class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--accent)] hover:underline"
                >
                  {p.detailsLabel}
                  <Icon name="arrow-right" class="h-3.5 w-3.5" />
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── 4. Auditoría Estratégica ──
      Resumen corto: la explicación completa (doce áreas, fases, accesos)
      vive en /servicios/auditoria/. */}
  <section id="auditoria" class="relative py-10 lg:py-14">
    <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
      <div class="reveal max-w-3xl">
        <h2 class="text-2xl font-bold text-[var(--text)]">{p.auditTitle}</h2>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{p.auditSubtitle}</p>
      </div>
      <article class="reveal mt-6 grid gap-6 rounded-[var(--radius-lg)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-7 backdrop-blur-xl lg:grid-cols-[1fr_1.4fr] lg:items-start lg:p-9">
        <div>
          <span class="inline-flex items-center rounded-full border border-[color:var(--border-strong)] bg-[var(--brand)]/15 px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-[var(--accent)]">
            {adv.badge}
          </span>
          <h3 class="mt-4 text-lg font-bold text-[var(--text)]">{adv.name}</h3>
          <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
            <span class="sr-only">{p.forWhoLabel}: </span>{adv.forWho}
          </p>
          <p class="mt-4 text-2xl font-bold tracking-tight text-[var(--text)]">{adv.priceQuote}</p>
          <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--muted)]">
            {adv.billing} · {adv.priceNote}
          </p>
        </div>
        <div>
          <p class="text-sm leading-7 text-[var(--muted)]">{adv.description}</p>
          <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{adv.prereq}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            {/* El primario lleva a la landing, no a WhatsApp: ahí se explica
                qué se audita y qué se entrega. */}
            <a
              href={PAGES.audit[lang]}
              data-cta="precios-auditoria"
              class="inline-flex items-center justify-center rounded-xl bg-[var(--brand)] px-6 py-3.5 text-sm font-bold text-white transition hover:bg-[var(--brand-strong)]"
            >
              {adv.cta}
            </a>
            <a
              href={waLink(adv.waText)}
              data-cta="precios-auditoria-whatsapp"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-[color:var(--border-strong)] bg-[var(--tint)] px-6 py-3.5 text-sm font-bold text-[var(--text)] transition hover:bg-[var(--brand)]/12"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              {t.common.ctaWhatsapp}
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  {/* ── 5. Condiciones generales ──
      Antes era «letra pequeña» oculta en móvil. Con precios «Desde», qué
      mueve el total y qué se paga aparte tiene que verse en cualquier
      pantalla, antes de las preguntas frecuentes. */}
  <section id="condiciones" class="relative py-10 lg:py-14">
    <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
      <div class="reveal rounded-[var(--radius-lg)] border border-[color:var(--border)] bg-[var(--bg-2)]/60 p-7 lg:p-9">
        <h2 class="text-2xl font-bold text-[var(--text)]">{p.termsTitle}</h2>
        <ul class="mt-5 grid gap-3 lg:grid-cols-2 lg:gap-x-10">
          {
            [...p.terms, p.currencyNoteUsd].map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-6 text-[var(--muted)]">
                <span class="mt-1 flex h-4 w-4 flex-none items-center justify-center rounded bg-[var(--brand)]/15 text-[var(--accent)]">
                  <Icon name="check" class="h-2.5 w-2.5" strokeWidth={3} />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</div>
