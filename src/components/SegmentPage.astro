---
import { type Lang, type LandingKey } from "../i18n/ui";
import { getSegment } from "../i18n/segments";
import { IDENTITY, signatures } from "../i18n/landing-identity";
import { specialties } from "../i18n/specialties";
import Icon from "./Icon.astro";
import LandingHero from "./LandingHero.astro";
import VisualSegment from "./hero-visuals/VisualSegment.astro";
import SegmentProject from "./SegmentProject.astro";
import SegmentCrossLinks from "./SegmentCrossLinks.astro";
import Process from "./Process.astro";
import Testimonials from "./Testimonials.astro";
import Founder from "./Founder.astro";
import PriceAnchor from "./PriceAnchor.astro";
import LandingConversion from "./LandingConversion.astro";
import SegSignature from "./segment/SegSignature.astro";
import SegSpecialties from "./segment/SegSpecialties.astro";
import SegSystem from "./segment/SegSystem.astro";
import SegPains from "./segment/SegPains.astro";
import SegCycle from "./segment/SegCycle.astro";

interface Props {
  lang: Lang;
  segment: LandingKey;
}
const { lang, segment } = Astro.props as Props;
const x = getSegment(lang, segment);
const id = IDENTITY[segment];
const sig = signatures[lang][segment];
const spec = specialties[lang][segment as keyof (typeof specialties)[Lang]];
---

{/*
  Plantilla de las páginas de giro. Hasta el 13 de octubre de 2026 todas
  seguían el mismo orden y la misma presentación; desde el 14, cada una
  declara en src/i18n/landing-identity.ts qué secciones lleva, en qué orden,
  cómo se presenta cada bloque y cuál es su sección firma (un gráfico o una
  animación que solo existe en esa página). El copy vive en segments.ts,
  niches.ts y specialties.ts.

  Fijos en todas: el hero arriba y el cierre con agenda y formulario abajo.
  Lo de en medio cambia por página.
*/}

<LandingHero
  lang={lang}
  page={segment}
  eyebrow={x.navLabel}
  icon={x.icon}
  titleA={x.heroTitleA}
  highlight={x.heroHighlight}
  subtitle={x.heroSubtitle}
  lead={x.intro}
>
  <VisualSegment slot="visual" lang={lang} segment={segment} />
</LandingHero>

{
  id.layout.map((section) => {
    switch (section) {
      case "signature":
        return <SegSignature sig={sig} />;
      case "specialties":
        return spec ? <SegSpecialties block={spec} variant={id.specialtiesStyle ?? "tabs"} /> : null;
      case "system":
        return <SegSystem title={x.systemTitle} subtitle={x.systemSubtitle} items={x.system} variant={id.systemStyle} />;
      case "project":
        return <SegmentProject lang={lang} segment={segment} />;
      case "pains":
        return <SegPains title={x.painTitle} subtitle={x.painSubtitle} items={x.pains} variant={id.painStyle} />;
      case "cycle":
        return <SegCycle title={x.cycleTitle} body={x.cycleBody} months={x.cycleMonths} variant={id.cycleStyle} />;
      case "process":
        return <Process lang={lang} />;
      case "testimonials":
        return <Testimonials lang={lang} />;
      case "founder":
        return <Founder lang={lang} page={segment} />;
      case "price":
        return <PriceAnchor lang={lang} />;
      case "cross":
        return <SegmentCrossLinks lang={lang} current={segment} />;
      case "faq":
        return (
          <section id="preguntas" class="relative py-12 lg:py-16">
            <div class="mx-auto w-full max-w-[900px] px-4 sm:px-6 lg:px-8">
              <h2 class="reveal text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl">{x.faqTitle}</h2>
              <div class="mt-8 grid gap-3">
                {x.faq.map((item, i) => (
                  <details
                    class="reveal group rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-5 backdrop-blur-xl transition hover:border-[color:var(--border-strong)] open:border-[color:var(--border-strong)]"
                    style={`--reveal-delay: ${i * 50}ms`}
                  >
                    <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-semibold text-[var(--text)] marker:content-['']">
                      {item.question}
                      <span class="flex-none text-[var(--accent)] transition group-open:rotate-45">
                        <Icon name="plus" class="h-4 w-4" strokeWidth={2.2} />
                      </span>
                    </summary>
                    <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{item.answer}</p>
                  </details>
                ))}
              </div>
            </div>
          </section>
        );
      default:
        return null;
    }
  })
}

<LandingConversion
  lang={lang}
  page={segment}
  close={{ eyebrow: `// ${x.navLabel}`, title: x.ctaTitle, subtitle: x.ctaBody }}
  service={x.navLabel}
/>
