---
import { type Lang, type SegmentKey } from "../i18n/ui";
import { getSegment } from "../i18n/segments";
import Icon from "./Icon.astro";
import CardRail from "./CardRail.astro";
import LandingHero from "./LandingHero.astro";
import VisualSegment from "./hero-visuals/VisualSegment.astro";
import SegmentProject from "./SegmentProject.astro";
import SegmentCrossLinks from "./SegmentCrossLinks.astro";
import Process from "./Process.astro";
import Testimonials from "./Testimonials.astro";
import Founder from "./Founder.astro";
import PriceAnchor from "./PriceAnchor.astro";
import LandingConversion from "./LandingConversion.astro";

interface Props {
  lang: Lang;
  segment: SegmentKey;
}
const { lang, segment } = Astro.props as Props;
const x = getSegment(lang, segment);
---

{/*
  Plantilla única para las cinco páginas de giro. El contenido vive en
  src/i18n/segments.ts: la estructura se comparte, el copy no.

  Orden común de las landings (septiembre de 2026):
  1 hero · 2 beneficios (lo que construyo para el giro) · 3 cómo se trabaja
  + proyecto del giro · 4 testimonios · 5 para quién es (los dolores que
  reconoce el dueño y su calendario) · 6 fundador · 7 inversión · 8 dudas ·
  9 cierre con agenda (#agendar) y formulario (#contacto) en esta página.
*/}

{/* Si dos segmentos terminaran diciendo lo mismo, la culpa sería del texto,
    no de esta plantilla — y sería motivo para fusionar las dos páginas. */}

<!-- ── 1 · Hero ── -->
{/*
  Mismo esquema que Desarrollo Web (texto + visual), pero el visual es el
  proyecto real del giro, con la paleta de ProCode (azul y cyan): dos
  páginas de giro seguidas no se parecen entre sí.
*/}
<LandingHero
  lang={lang}
  page={segment}
  eyebrow={x.navLabel}
  icon={x.icon}
  titleA={x.heroTitleA}
  highlight={x.heroHighlight}
  subtitle={x.heroSubtitle}
  lead={x.intro}
>
  <VisualSegment slot="visual" lang={lang} segment={segment} />
</LandingHero>

<!-- ── 2 · Beneficios: lo que construyo para este oficio ── -->
<section id="beneficios" class="relative py-10 lg:py-16">
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <div class="reveal max-w-3xl">
      <h2
        class="text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl lg:text-4xl"
      >
        {x.systemTitle}
      </h2>
      <p class="mt-4 text-base leading-8 text-[var(--muted)]">
        {x.systemSubtitle}
      </p>
    </div>

    <CardRail class="mt-8" grid="md:grid-cols-2 lg:grid-cols-3" peek="wide">
      {
        x.system.map((block, i) => (
          <article
            class="reveal flex flex-col rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/70 p-7 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)]"
            style={`--reveal-delay: ${i * 70}ms`}
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--brand)]/10 text-[var(--accent)]">
              <Icon name={block.icon as any} class="h-6 w-6" />
            </span>
            <h3 class="mt-5 text-base font-bold leading-snug text-[var(--text)]">
              {block.title}
            </h3>
            <p class="mt-3 text-sm leading-7 text-[var(--muted)]">
              {block.description}
            </p>
          </article>
        ))
      }
    </CardRail>
  </div>
</section>

<!-- ── 3 · Así es como se trabaja + proyecto real del giro ── -->
<Process lang={lang} />
<SegmentProject lang={lang} segment={segment} />

<!-- ── 4 · Testimonios publicados ── -->
<Testimonials lang={lang} />

<!-- ── 5 · Para quién es: lo que el dueño reconoce de su día a día ── -->
<section id="para-quien" class="relative py-10 lg:py-16">
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <div class="reveal max-w-3xl">
      <h2
        class="text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl lg:text-4xl"
      >
        {x.painTitle}
      </h2>
      <p class="mt-4 text-base leading-8 text-[var(--muted)]">
        {x.painSubtitle}
      </p>
    </div>

    <ul class="mt-8 grid gap-3 md:grid-cols-2">
      {
        x.pains.map((pain, i) => (
          <li
            class="reveal flex items-start gap-4 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/50 p-5 backdrop-blur-xl"
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <span
              class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-lg bg-[var(--tint-2)] text-[var(--muted)]"
              aria-hidden="true"
            >
              <Icon name="minus" class="h-3.5 w-3.5" />
            </span>
            <p class="text-sm leading-6 text-[var(--text)]/85">{pain}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section
  class="relative py-10 lg:py-14"
>
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <div
      class="reveal rounded-[var(--radius-lg)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-7 backdrop-blur-xl lg:p-9"
    >
      <div class="grid gap-6 lg:grid-cols-[minmax(0,340px)_1fr] lg:items-center lg:gap-12">
        <div class="flex items-start gap-4">
          <span
            class="lt-soft flex h-11 w-11 flex-none items-center justify-center rounded-xl"
          >
            <Icon name="calendar" class="h-6 w-6" />
          </span>
          <div>
            <h2 class="text-base font-bold leading-snug text-[var(--text)]">
              {x.cycleTitle}
            </h2>
            <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
              {x.cycleBody}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          {
            x.cycleMonths.map((m) => (
              <div class="rounded-xl border border-[color:var(--border)] bg-[var(--tint)] p-4">
                <p
                  class="font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--accent)]"
                >
                  {m.label}
                </p>
                <p class="mt-1.5 text-xs leading-5 text-[var(--muted)]">
                  {m.note}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── 6 · El desarrollador y fundador ── -->
<Founder lang={lang} page={segment} />

<!-- ── 7 · Información práctica: precios base publicados ── -->
<PriceAnchor lang={lang} />

<!-- ── 8 · Preguntas frecuentes del oficio ── -->
<section id="preguntas" class="relative py-10 lg:py-16">
  <div class="mx-auto w-full max-w-[900px] px-4 sm:px-6 lg:px-8">
    <h2
      class="reveal text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl"
    >
      {x.faqTitle}
    </h2>
    <div class="mt-8 grid gap-3">
      {
        x.faq.map((item, i) => (
          <details
            class="reveal group rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-5 backdrop-blur-xl transition hover:border-[color:var(--border-strong)] open:border-[color:var(--border-strong)]"
            style={`--reveal-delay: ${i * 50}ms`}
          >
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-semibold text-[var(--text)] marker:content-['']">
              {item.question}
              <span class="flex-none text-[var(--accent)] transition group-open:rotate-45">
                <Icon name="plus" class="h-4 w-4" strokeWidth={2.2} />
              </span>
            </summary>
            <p class="mt-3 text-sm leading-7 text-[var(--muted)]">
              {item.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<SegmentCrossLinks lang={lang} current={segment} />

<!-- ── 9 · Cierre: agenda y formulario en esta misma página ── -->
<LandingConversion
  lang={lang}
  page={segment}
  close={{ eyebrow: `// ${x.navLabel}`, title: x.ctaTitle, subtitle: x.ctaBody }}
  service={x.navLabel}
/>
