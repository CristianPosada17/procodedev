---
/*
  Página completa de una línea de servicio.

  Las cuatro páginas (dos servicios × dos idiomas) comparten esta
  composición: el contenido vive en src/i18n/services.ts y aquí solo se
  decide el orden de los bloques y qué datos estructurados se emiten.

  Orden (revisado en septiembre de 2026 para acortar el recorrido de venta):

  DESARROLLO WEB — hero con el problema comercial y el precio → trabajos
  reales (Portfolio) antes de cualquier detalle técnico → por
  qué a la medida → qué incluye → paquetes, cada uno con su propio botón →
  proceso → estándares técnicos (la tecnología respalda, no encabeza) →
  filtro honesto → dudas → FORMULARIO → puente al otro servicio.

  MARKETING — hero con la promesa de captación → por qué → la oferta pieza
  por pieza, con el plazo de cada una → qué incluye → planes, sin el
  mantenimiento de $79 → integraciones → qué se mide → filtro → dudas →
  FORMULARIO → puente.

  La regla que cambió: ninguna página de servicio manda a otra URL para
  poder solicitar. El formulario corto va dentro, y los botones de paquete
  conservan el plan elegido al llegar a él.
*/
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import ServiceHero from "./ServiceHero.astro";
import ServiceIntro from "./ServiceIntro.astro";
import ServiceCapabilities from "./ServiceCapabilities.astro";
import ServicePackages from "./ServicePackages.astro";
import ServiceStandards from "./ServiceStandards.astro";
import ServiceFit from "./ServiceFit.astro";
import ServiceCross from "./ServiceCross.astro";
import ServiceOffer from "./ServiceOffer.astro";
import ServiceLeadForm from "./ServiceLeadForm.astro";
import AuditCallout from "./AuditCallout.astro";
import Portfolio from "./Portfolio.astro";
import Integrations from "./Integrations.astro";
import Process from "./Process.astro";
import FAQ from "./FAQ.astro";
import FinalCTA from "./FinalCTA.astro";
import Footer from "./Footer.astro";
import { translations, PAGES, type Lang } from "../i18n/ui";
import { serviceLines, serviceDetails, type ServiceKey } from "../i18n/services";

interface Props {
  lang: Lang;
  service: ServiceKey;
}
const { lang, service } = Astro.props as Props;
const t = translations[lang];
const line = serviceLines[lang][service];
const d = serviceDetails[lang][service];
const other: ServiceKey =
  service === "webDev" ? "digitalMarketing" : "webDev";

// Nodo Service → hasOfferCatalog: las seis capacidades más los paquetes.
// Es lo que permite que un buscador con IA conteste «qué incluye» y «cuánto
// cuesta» sin tener que interpretar el diseño de la página.
const offerCatalog = [
  ...line.capabilities.map((c) => ({
    title: c.title,
    description: c.description,
  })),
  ...d.packages.items.map((p) => ({
    title: `${p.name} — $${p.price} ${p.currency}`,
    description: p.description,
  })),
];
---

<Layout
  lang={lang}
  page={service}
  title={d.meta.title}
  description={d.meta.description}
  keywords={d.meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.services, path: PAGES.services[lang] },
    { name: line.title, path: PAGES[service][lang] },
  ]}
  serviceName={line.title}
  audience={line.tagline}
  offerCatalog={offerCatalog}
  includeFaq={true}
  faqItems={d.faq.items}
>
  <Header lang={lang} page={service} />
  <main>
    <ServiceHero
      lang={lang}
      line={line}
      meta={d.meta}
      ctaLabel={d.form.ctaLabel}
    />

    {/* Desarrollo web: la prueba va antes que el argumento. Quien busca a
        quién contratar quiere ver trabajo hecho, no leer sobre Astro.

        Aquí va `Portfolio` y NO `ProofStrip`: los dos salen de
        `t.portfolio.projects` y ProofStrip es un recorte de los tres
        primeros clientes, así que juntos repetían las mismas tarjetas en la
        misma página. Portfolio se queda porque separa clientes reales de
        demos, que es la distinción que hace creíble el bloque. */}
    {service === "webDev" && <Portfolio lang={lang} />}

    <ServiceIntro
      lang={lang}
      intro={d.intro}
      icon={service === "webDev" ? "cpu" : "trending-up"}
    />

    {/* Marketing: tres trabajos con plazos distintos, separados a
        propósito para que no se lean como una sola promesa. */}
    {d.offer && <ServiceOffer lang={lang} offer={d.offer} />}

    <ServiceCapabilities
      lang={lang}
      heading={d.capabilities}
      items={line.capabilities}
    />
    <ServicePackages lang={lang} packages={d.packages} />

    {/* El bloque `Process` describe los cinco pasos de un proyecto de
        desarrollo («diseño y desarrollo», «conecto formularios, agenda y
        CRM»): en la página de marketing sonaba a otro servicio, así que ahí
        va la prueba de integraciones en su lugar. */}
    {
      service === "webDev" ? (
        <Process lang={lang} />
      ) : (
        <Integrations lang={lang} />
      )
    }

    {/* La tecnología (o el «qué se mide») respalda la oferta: va después de
        precio, proceso y prueba, no antes. */}
    <ServiceStandards lang={lang} standards={d.standards} />

    {/* Salida para quien llegó a esta página y ya no está seguro de que sea
        la suya. Va antes del filtro honesto a propósito: ahí es justo donde
        aparece la duda. */}
    <AuditCallout lang={lang} />

    <ServiceFit lang={lang} fit={d.fit} />
    <FAQ lang={lang} data={d.faq} id="dudas-servicio" />

    {/* Solicitar sin salir de la página. Los botones de cada paquete
        aterrizan aquí con el plan ya seleccionado. */}
    <ServiceLeadForm
      lang={lang}
      heading={d.form}
      service={line.title}
      page={service}
    />

    <ServiceCross lang={lang} cross={d.cross} target={other} />
    <FinalCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
