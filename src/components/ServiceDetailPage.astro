---
/*
  Página completa de una línea de servicio.

  Las cuatro páginas (dos servicios × dos idiomas) comparten esta
  composición: el contenido vive en src/i18n/services.ts y aquí solo se
  decide el orden de los bloques y qué datos estructurados se emiten.

  Orden común de las landings (septiembre de 2026):
  1 hero · 2 beneficios · 3 cómo se trabaja (+ trabajos reales) ·
  4 testimonios · 5 para quién es · 6 fundador · 7 qué incluye y paquetes ·
  8 dudas · 9 cierre con agenda (#agendar) y formulario (#contacto).

  Ninguna página de servicio manda a otra URL para convertir: agenda y
  formulario van dentro, y los botones de paquete conservan el plan elegido
  al llegar al formulario.
*/
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import ServiceHero from "./ServiceHero.astro";
import ServiceIntro from "./ServiceIntro.astro";
import ServiceCapabilities from "./ServiceCapabilities.astro";
import ServicePackages from "./ServicePackages.astro";
import ServiceStandards from "./ServiceStandards.astro";
import ServiceFit from "./ServiceFit.astro";
import ServiceCross from "./ServiceCross.astro";
import ServiceOffer from "./ServiceOffer.astro";
import AuditCallout from "./AuditCallout.astro";
import Portfolio from "./Portfolio.astro";
import Integrations from "./Integrations.astro";
import Process from "./Process.astro";
import Testimonials from "./Testimonials.astro";
import Founder from "./Founder.astro";
import FAQ from "./FAQ.astro";
import LandingConversion from "./LandingConversion.astro";
import RelatedLinks from "./RelatedLinks.astro";
import Footer from "./Footer.astro";
import { translations, PAGES, relatedLinks, type Lang } from "../i18n/ui";
import { serviceLines, serviceDetails, type ServiceKey } from "../i18n/services";

interface Props {
  lang: Lang;
  service: ServiceKey;
}
const { lang, service } = Astro.props as Props;
const t = translations[lang];
const line = serviceLines[lang][service];
const d = serviceDetails[lang][service];
const other: ServiceKey =
  service === "webDev" ? "digitalMarketing" : "webDev";

// Nodo Service → hasOfferCatalog: las seis capacidades más los paquetes.
// Es lo que permite que un buscador con IA conteste «qué incluye» y «cuánto
// cuesta» sin tener que interpretar el diseño de la página.
const isMonthly = (note: string) => /\bmes\b|month|\/mo\b/i.test(note);

const offerCatalog = [
  ...line.capabilities.map((c) => ({
    title: c.title,
    description: c.description,
  })),
  ...d.packages.items.map((p) => ({
    title: p.quoteLabel
      ? `${p.name} — ${p.quoteLabel}`
      : `${p.name} — ${p.pricePrefix ? p.pricePrefix + " " : ""}$${p.price} ${p.currency}`,
    description: p.description,
    ...(p.quoteLabel || !p.price
      ? {}
      : { minPrice: p.price, unit: isMonthly(p.priceNote) ? ("month" as const) : ("one-time" as const) }),
  })),
];

// El `price` del Offer sale del primer paquete con cifra de esta página
// (en Marketing Digital, Crecimiento+ desde $499 al mes), con su periodicidad.
const pricedPackage = d.packages.items.find((p) => !p.quoteLabel && p.price);
const offerPrice = pricedPackage ? pricedPackage.price.replace(/,/g, "") : "";
const offerUnit = pricedPackage && isMonthly(pricedPackage.priceNote) ? "month" : "one-time";
---

<Layout
  lang={lang}
  page={service}
  title={d.meta.title}
  description={d.meta.description}
  keywords={d.meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.services, path: PAGES.services[lang] },
    { name: line.title, path: PAGES[service][lang] },
  ]}
  serviceName={line.title}
  audience={line.tagline}
  offerCatalog={offerCatalog}
  offerPrice={offerPrice}
  offerUnit={offerUnit}
  includeFaq={true}
  faqItems={d.faq.items}
>
  <Header lang={lang} page={service} />
  <main>
    {/* 1 · Hero: propuesta, para quién, precio y plazo, y los dos CTAs */}
    <ServiceHero lang={lang} line={line} meta={d.meta} />

    {/* 2 · Beneficios: por qué así (y, en marketing, qué se mide) */}
    <ServiceIntro
      lang={lang}
      intro={d.intro}
      icon={service === "webDev" ? "cpu" : "trending-up"}
    />
    <ServiceStandards lang={lang} standards={d.standards} />

    {/* 3 · Así es como se trabaja. Desarrollo web: los cinco pasos y los
        trabajos reales (Portfolio separa clientes de demos). Marketing: la
        oferta pieza por pieza con su plazo y las integraciones — el
        `Process` describe un proyecto de desarrollo y ahí sonaba a otro
        servicio. */}
    {
      service === "webDev" ? (
        <>
          <Process lang={lang} />
          <Portfolio lang={lang} page={service} />
        </>
      ) : (
        <>
          {d.offer && <ServiceOffer lang={lang} offer={d.offer} />}
          <Integrations lang={lang} />
        </>
      )
    }

    {/* 4 · Testimonios publicados */}
    <Testimonials lang={lang} />

    {/* 5 · Para quién es y para quién no, y la salida para quien duda */}
    <ServiceFit lang={lang} fit={d.fit} />
    <AuditCallout lang={lang} />

    {/* 6 · El desarrollador y fundador */}
    <Founder lang={lang} page={service} />

    {/* 7 · Información práctica: qué incluye y paquetes publicados. Los
        botones de cada paquete bajan al formulario con el plan elegido. */}
    <ServiceCapabilities
      lang={lang}
      heading={d.capabilities}
      items={line.capabilities}
    />
    <ServicePackages lang={lang} packages={d.packages} />

    {/* 8 · Preguntas frecuentes */}
    <FAQ lang={lang} data={d.faq} id="dudas-servicio" />

    <ServiceCross lang={lang} cross={d.cross} target={other} />
    {/* Enlazado interno de la matriz SEO: desde Desarrollo Web salen las
        tres puertas con demanda propia (landing, web con SEO, mantenimiento). */}
    {service === "webDev" && <RelatedLinks data={relatedLinks[lang].services} />}

    {/* 9 · Cierre: agenda y formulario (Nombre + Email) en esta página */}
    <LandingConversion
      lang={lang}
      page={service}
      close={{ eyebrow: `// ${line.title}`, title: line.tagline }}
      formHeading={d.form}
      service={line.title}
    />
  </main>
  <Footer lang={lang} />
</Layout>
