---
/*
  Firma de /salud-y-bienestar/: una semana de consulta que se llena sola.
  Cada cita aparece en cascada (CSS) al entrar en vista; la última del
  sábado lleva la etiqueta de «reservada un domingo por la noche», que es
  el argumento entero de la agenda en línea.
*/
import Icon from "../Icon.astro";
import type { BookingWeekSig } from "../../i18n/landing-identity";

interface Props {
  sig: BookingWeekSig;
}
const { sig } = Astro.props as Props;
const legendOf = Object.fromEntries(sig.legend.map((l) => [l.key, l.label]));
const tone = {
  new: "bg-[var(--brand)] text-white",
  follow: "bg-[var(--brand)]/25 text-[var(--text)]",
  online: "border border-dashed border-[color:var(--accent)] bg-[var(--accent)]/10 text-[var(--accent)]",
} as const;
const lastSlot = sig.slots[sig.slots.length - 1];
---

<section id="agenda-en-linea" class="relative py-12 lg:py-20">
  <div class="mx-auto grid w-full max-w-[1480px] gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-14 lg:px-10 2xl:max-w-[1600px]">
    <div class="reveal">
      <span class="eyebrow">{sig.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-bold leading-[1.1] tracking-tight text-[var(--text)] sm:text-4xl">{sig.title}</h2>
      <p class="mt-5 text-base leading-8 text-[var(--muted)]">{sig.subtitle}</p>
      <ul class="mt-8 grid gap-5">
        {
          sig.points.map((p) => (
            <li class="flex gap-4">
              <span class="lt-soft flex h-9 w-9 flex-none items-center justify-center rounded-xl">
                <Icon name="check" class="h-4 w-4" />
              </span>
              <div>
                <p class="text-sm font-bold text-[var(--text)]">{p.title}</p>
                <p class="mt-1 text-sm leading-6 text-[var(--muted)]">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="reveal lt-panel relative overflow-hidden rounded-[var(--radius-lg)] p-4 sm:p-6" aria-hidden="true">
      <div class="flex flex-wrap items-center gap-4 border-b border-[color:var(--border)] pb-4">
        <Icon name="calendar" class="h-5 w-5 text-[var(--accent)]" />
        {
          sig.legend.map((l) => (
            <span class="inline-flex items-center gap-2 text-xs text-[var(--muted)]">
              <span class:list={["h-3 w-3 rounded", tone[l.key]]}></span>
              {l.label}
            </span>
          ))
        }
      </div>
      <div class="mt-4 grid grid-cols-[3rem_repeat(6,minmax(0,1fr))] gap-1.5 text-[10px] sm:gap-2">
        <span></span>
        {sig.days.map((d) => <span class="pb-1 text-center font-mono uppercase tracking-wider text-[var(--muted)]">{d}</span>)}
        {
          sig.hours.map((h, row) => (
            <>
              <span class="flex items-center font-mono text-[var(--muted)]">{h}</span>
              {sig.days.map((_, day) => {
                const idx = sig.slots.findIndex(([d, r]) => d === day && r === row);
                const slot = idx >= 0 ? sig.slots[idx] : null;
                return slot ? (
                  <span
                    class:list={["sig-pop flex h-9 items-center justify-center truncate rounded-md px-1 font-semibold sm:h-11", tone[slot[2]]]}
                    style={`--d: ${idx * 110}ms`}
                  >
                    <span class="hidden truncate sm:inline">{legendOf[slot[2]]}</span>
                  </span>
                ) : (
                  <span class="h-9 rounded-md bg-[var(--tint)] sm:h-11"></span>
                );
              })}
            </>
          ))
        }
      </div>
      <p
        class="sig-pop lt-panel absolute bottom-4 right-4 hidden items-center gap-2 rounded-full px-3.5 py-2 text-[11px] font-semibold text-[var(--text)] sm:inline-flex"
        style={`--d: ${sig.slots.length * 110 + 200}ms`}
      >
        <span class="lt-ping h-2 w-2 rounded-full bg-[var(--accent)]"></span>
        {sig.nightLabel}
      </p>
    </div>
  </div>
</section>
