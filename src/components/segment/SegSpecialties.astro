---
/*
  Los oficios fusionados dentro de su giro (14 oct 2026). Cada oficio es una
  sección con ancla (`id`): /dentistas/ responde 301 a /salud-y-bienestar/
  #dentistas y aquí cae justo en su panel.

  Tres presentaciones, una por giro que tiene oficios dentro:
  · tabs     pestañas (salud: cinco especialidades). Sin JS se ven todos
             los paneles uno tras otro; con JS, uno a la vez, y el ancla de
             la URL abre el suyo.
  · split    dos paneles lado a lado (abogados / agentes de seguros)
  · compare  dos columnas enfrentadas (inmobiliaria / asesor independiente)

  Todo el contenido está en el HTML desde el servidor: las pestañas solo
  ocultan con CSS, así Google lee los cinco oficios.
*/
import Icon from "../Icon.astro";
import type { SpecialtyBlock } from "../../i18n/specialties";

interface Props {
  block: SpecialtyBlock;
  variant: "tabs" | "split" | "compare";
}
const { block, variant } = Astro.props as Props;
const wrap = "mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]";
---

<section id="especialidades" class="relative py-12 lg:py-20">
  <div class={wrap}>
    <div class="reveal max-w-3xl">
      <span class="eyebrow">{block.eyebrow}</span>
      <h2 class="mt-4 text-3xl font-bold leading-[1.1] tracking-tight text-[var(--text)] sm:text-4xl lg:text-5xl">
        {block.title}
      </h2>
      <p class="mt-5 text-base leading-8 text-[var(--muted)] sm:text-lg">{block.subtitle}</p>
    </div>

    {
      variant === "tabs" && (
        <div class="mt-10 scroll-mt-28" data-spec-tabs>
          <div
            class="spec-tablist -mx-4 flex gap-2 overflow-x-auto px-4 pb-2 sm:mx-0 sm:flex-wrap sm:px-0"
            role="tablist"
            aria-label={block.title}
            hidden
          >
            {block.items.map((s, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${s.id}`}
                aria-controls={s.id}
                aria-selected={i === 0 ? "true" : "false"}
                data-spec-tab={s.id}
                class="spec-tab inline-flex min-h-[44px] flex-none items-center gap-2 rounded-full border border-[color:var(--border)] bg-[var(--surface)]/60 px-4 text-sm font-semibold text-[var(--muted)] transition hover:border-[color:var(--border-strong)] hover:text-[var(--text)]"
              >
                <Icon name={s.icon as any} class="h-4 w-4" />
                {s.label}
              </button>
            ))}
          </div>

          <div class="mt-6 grid gap-6">
            {block.items.map((s) => (
              <article
                id={s.id}
                role="tabpanel"
                aria-labelledby={`tab-${s.id}`}
                data-spec-panel={s.id}
                class="spec-panel scroll-mt-28 rounded-[var(--radius-lg)] border border-[color:var(--border)] bg-[var(--surface)]/70 p-6 backdrop-blur-xl sm:p-9"
              >
                <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
                  <div>
                    <span class="lt-soft inline-flex h-12 w-12 items-center justify-center rounded-2xl">
                      <Icon name={s.icon as any} class="h-6 w-6" />
                    </span>
                    <h3 class="mt-5 text-2xl font-bold leading-tight text-[var(--text)] sm:text-3xl">{s.title}</h3>
                    <p class="mt-4 text-[15px] leading-8 text-[var(--muted)]">{s.lead}</p>
                    <p class="mt-7 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]">{block.searchesLabel}</p>
                    <ul class="mt-3 flex flex-wrap gap-2">
                      {s.searches.map((q) => (
                        <li class="inline-flex items-center gap-1.5 rounded-full border border-[color:var(--border)] bg-[var(--bg-2)] px-3 py-1.5 text-xs text-[var(--text)]/85">
                          <Icon name="search" class="h-3.5 w-3.5 text-[var(--accent)]" />
                          {q}
                        </li>
                      ))}
                    </ul>
                    {s.note && <p class="mt-6 text-xs leading-6 text-[var(--muted)]">{s.note}</p>}
                  </div>
                  <div>
                    <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]">{block.includesLabel}</p>
                    <ul class="mt-4 grid gap-3">
                      {s.includes.map((inc) => (
                        <li class="flex gap-3 text-sm leading-7 text-[var(--text)]/90">
                          <span class="mt-1 flex h-5 w-5 flex-none items-center justify-center rounded-md bg-[var(--brand)]/10 text-[var(--accent)]">
                            <Icon name="check" class="h-3.5 w-3.5" />
                          </span>
                          {inc}
                        </li>
                      ))}
                    </ul>
                    {s.faq.map((f) => (
                      <details class="group mt-6 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--bg-2)]/60 p-4">
                        <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-semibold text-[var(--text)] marker:content-['']">
                          {f.question}
                          <span class="flex-none text-[var(--accent)] transition group-open:rotate-45">
                            <Icon name="plus" class="h-4 w-4" strokeWidth={2.2} />
                          </span>
                        </summary>
                        <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{f.answer}</p>
                      </details>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      )
    }

    {
      (variant === "split" || variant === "compare") && (
        <div class="relative mt-10 grid gap-5 lg:grid-cols-2">
          {variant === "compare" && (
            <span
              class="lt-panel absolute left-1/2 top-12 z-10 hidden h-14 w-14 -translate-x-1/2 items-center justify-center rounded-full font-mono text-xs font-bold text-[var(--accent)] lg:flex"
              aria-hidden="true"
            >
              VS
            </span>
          )}
          {block.items.map((s, i) => (
            <article
              id={s.id}
              class:list={[
                "reveal scroll-mt-28 flex flex-col rounded-[var(--radius-lg)] border p-7 backdrop-blur-xl sm:p-9",
                variant === "compare" && i === 1
                  ? "border-[color:var(--border-strong)] bg-[var(--brand)]/[0.06]"
                  : "border-[color:var(--border)] bg-[var(--surface)]/70",
              ]}
              style={`--reveal-delay: ${i * 90}ms`}
            >
              <div class="flex items-center gap-3">
                <span class="lt-soft flex h-11 w-11 flex-none items-center justify-center rounded-xl">
                  <Icon name={s.icon as any} class="h-5 w-5" />
                </span>
                <span class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--accent)]">{s.label}</span>
              </div>
              <h3 class="mt-5 text-2xl font-bold leading-tight text-[var(--text)]">{s.title}</h3>
              <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{s.lead}</p>

              <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]">{block.includesLabel}</p>
              <ul class="mt-3 grid gap-2.5">
                {s.includes.map((inc) => (
                  <li class="flex gap-3 text-sm leading-6 text-[var(--text)]/90">
                    <Icon name={variant === "compare" ? "arrow-right" : "check"} class="mt-1 h-4 w-4 flex-none text-[var(--accent)]" />
                    {inc}
                  </li>
                ))}
              </ul>

              <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]">{block.searchesLabel}</p>
              <p class="mt-2 text-sm leading-7 text-[var(--muted)]">
                {s.searches.map((q, k) => (
                  <>
                    <span class="text-[var(--text)]/85">«{q}»</span>
                    {k < s.searches.length - 1 ? " · " : ""}
                  </>
                ))}
              </p>

              {s.note && <p class="mt-5 text-xs leading-6 text-[var(--muted)]">{s.note}</p>}

              <div class="mt-auto">
                {s.faq.map((f) => (
                  <details class="group mt-6 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--bg-2)]/60 p-4">
                    <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-semibold text-[var(--text)] marker:content-['']">
                      {f.question}
                      <span class="flex-none text-[var(--accent)] transition group-open:rotate-45">
                        <Icon name="plus" class="h-4 w-4" strokeWidth={2.2} />
                      </span>
                    </summary>
                    <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{f.answer}</p>
                  </details>
                ))}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  // Pestañas de especialidades. Sin JS se ven todos los paneles; con JS,
  // uno a la vez. El ancla de la URL (las URLs viejas de cada oficio llegan
  // con #dentistas, #abogados…) abre su panel y lo lleva a la vista.
  document.querySelectorAll<HTMLElement>("[data-spec-tabs]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-spec-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-spec-panel]"));
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    if (!tabs.length || !list) return;
    list.hidden = false;
    root.classList.add("is-tabbed");

    const show = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.specTab === id;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => (p.hidden = p.dataset.specPanel !== id));
    };

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => {
        show(t.dataset.specTab!);
        history.replaceState(null, "", `#${t.dataset.specTab}`);
      });
      t.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        show(next.dataset.specTab!, true);
      });
    });

    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const panel = panels.find((p) => p.dataset.specPanel === id);
      if (!panel) return false;
      show(id);
      // El salto nativo al ancla ocurrió con el panel aún oculto (o el
      // navegador restaura el scroll al cargar): se repite ya visible.
      const go = () => setTimeout(() => root.scrollIntoView({ block: "start", behavior: "instant" }), 0);
      if (document.readyState === "complete") go();
      else window.addEventListener("load", go, { once: true });
      return true;
    };
    if (!fromHash()) show(tabs[0].dataset.specTab!);
    window.addEventListener("hashchange", fromHash);
  });
</script>
