---
/*
  Los dolores que reconoce el dueño, en tres presentaciones:
  · list   lista en dos columnas (la de siempre)
  · chat   burbujas de mensaje: para los giros cuyo dolor ES contestar
           mensajes (contratistas, preparadores de impuestos)
  · split  titular grande a la izquierda y renglones numerados a la derecha
*/
import Icon from "../Icon.astro";

interface Props {
  title: string;
  subtitle: string;
  items: string[];
  variant: "list" | "chat" | "split";
}
const { title, subtitle, items, variant } = Astro.props as Props;
const wrap = "mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]";
---

<section id="para-quien" class="relative py-12 lg:py-20">
  <div class={wrap}>
    {
      variant === "split" ? (
        <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
          <div class="reveal">
            <h2 class="text-3xl font-bold leading-[1.1] tracking-tight text-[var(--text)] sm:text-4xl">{title}</h2>
            <p class="mt-5 text-base leading-8 text-[var(--muted)]">{subtitle}</p>
          </div>
          <ol class="grid gap-3">
            {items.map((pain, i) => (
              <li
                class="reveal flex items-baseline gap-5 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/50 px-6 py-5"
                style={`--reveal-delay: ${i * 60}ms`}
              >
                <span class="font-mono text-xs font-bold text-[var(--accent)]">{String(i + 1).padStart(2, "0")}</span>
                <p class="text-[15px] leading-7 text-[var(--text)]/90">{pain}</p>
              </li>
            ))}
          </ol>
        </div>
      ) : (
        <>
          <div class="reveal max-w-3xl">
            <h2 class="text-3xl font-bold leading-[1.1] tracking-tight text-[var(--text)] sm:text-4xl">{title}</h2>
            <p class="mt-4 text-base leading-8 text-[var(--muted)]">{subtitle}</p>
          </div>

          {variant === "chat" && (
            <div class="reveal mt-10 max-w-3xl rounded-[var(--radius-lg)] border border-[color:var(--border)] bg-[var(--bg-2)]/70 p-5 sm:p-8">
              <div class="flex flex-col gap-3">
                {items.map((pain, i) => (
                  <p
                    class:list={[
                      "sig-pop max-w-[85%] rounded-2xl px-5 py-3.5 text-sm leading-6",
                      i % 2 === 0
                        ? "self-start rounded-bl-md border border-[color:var(--border)] bg-[var(--surface)] text-[var(--text)]/90"
                        : "self-end rounded-br-md bg-[var(--brand)]/14 text-[var(--text)]",
                    ]}
                    style={`--d: ${i * 140}ms`}
                  >
                    {pain}
                  </p>
                ))}
              </div>
            </div>
          )}

          {variant === "list" && (
            <ul class="mt-10 grid gap-3 md:grid-cols-2">
              {items.map((pain, i) => (
                <li
                  class="reveal flex items-start gap-4 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/50 p-5 backdrop-blur-xl"
                  style={`--reveal-delay: ${i * 60}ms`}
                >
                  <span class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-lg bg-[var(--tint-2)] text-[var(--muted)]" aria-hidden="true">
                    <Icon name="minus" class="h-3.5 w-3.5" />
                  </span>
                  <p class="text-sm leading-6 text-[var(--text)]/85">{pain}</p>
                </li>
              ))}
            </ul>
          )}
        </>
      )
    }
  </div>
</section>
