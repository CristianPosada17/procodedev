---
import { translations, PAGES, CONTACT, type Lang } from "../i18n/ui";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const fc = t.finalCta;
const waMsg = encodeURIComponent(
  lang === "es"
    ? "Hola Cristian 👋 Quiero agendar la llamada gratis de 15 minutos."
    : "Hi Cristian 👋 I'd like to book the free 15-minute call.",
);
---

<section id="final-cta" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div
      class="reveal relative overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-gradient-to-br from-[var(--brand)]/20 via-[var(--surface)]/60 to-[var(--bg-2)] p-8 text-center backdrop-blur-xl lg:p-16"
    >
      <div class="tech-grid absolute inset-0 opacity-30"></div>
      <div class="relative mx-auto max-w-3xl">
        <span class="eyebrow">{fc.eyebrow}</span>
        <h2 class="mt-5 text-3xl font-bold leading-[1.15] tracking-tight text-[var(--text)] sm:text-4xl lg:text-5xl">
          {fc.title}
        </h2>
        <p class="mt-5 text-base leading-8 text-[var(--muted)]">{fc.subtitle}</p>
        <div class="mt-9 flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href={PAGES.contact[lang]}
            class="inline-flex items-center justify-center rounded-xl bg-[var(--brand)] px-7 py-4 text-sm font-bold text-white shadow-[0_0_40px_rgba(37,99,235,0.4)] transition hover:-translate-y-0.5 hover:bg-[var(--brand-strong)]"
          >
            {fc.ctaPrimary} <span class="ml-2">→</span>
          </a>
          <a
            href={`https://wa.me/${CONTACT.whatsapp}?text=${waMsg}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-xl border border-[color:var(--border-strong)] bg-white/5 px-7 py-4 text-sm font-bold text-[var(--text)] transition hover:-translate-y-0.5 hover:bg-[var(--brand)]/10"
          >
            {fc.ctaWhatsapp}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
