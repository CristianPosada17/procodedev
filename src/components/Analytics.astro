---
// ============================================================
// ANALYTICS — Arranque de medición (va en <head>)
// ------------------------------------------------------------
// 1. Consent Mode v2 de Google, con default por región.
// 2. Google Analytics 4 (gtag) con agrupación de contenido.
// 3. Meta Pixel, respetando el mismo consentimiento.
//
// El motor de eventos (clics, scroll, formularios, Calendly) vive en
// AnalyticsEvents.astro, al final del <body>: aquí solo se deja el terreno
// listo para que `gtag` y `fbq` existan desde el primer milisegundo.
//
// Convención del proyecto: los scripts se arman como cadena en el
// frontmatter y se inyectan con `set:html` (los template literals directos
// en `set:html` rompen el parser de Astro).
// ============================================================
import type { Lang, PageKey } from "../i18n/ui";
import {
  MEASUREMENT,
  CONSENT_REGIONS,
  contentGroupFor,
} from "../lib/measurement";

interface Props {
  lang?: Lang;
  page?: PageKey | "blog";
}
const { lang = "es", page = "home" } = Astro.props as Props;

const GA = MEASUREMENT.ga4;
const PIXEL = MEASUREMENT.metaPixel;
const group = contentGroupFor(page);

const cfg = JSON.stringify({
  ga: GA,
  pixel: PIXEL,
  lang,
  page,
  group,
  regions: CONSENT_REGIONS,
});

// Sin IDs no se inyecta nada: un sitio sin medir es preferible a un sitio
// que carga scripts de terceros para nada.
const bootstrap =
  GA || PIXEL
    ? `
(function(){
  var CFG = ${cfg};
  var STORE = 'pcd_consent_v2';

  // ---------- 0. Estado guardado ----------
  var saved = null;
  try { saved = window.localStorage.getItem(STORE); } catch (e) {}
  if (saved !== 'granted' && saved !== 'denied') saved = null;
  window.__pcdConsent = saved;

  // Heurística de región para el Pixel: Consent Mode resuelve la región del
  // lado de Google, pero Meta no tiene equivalente. La zona horaria es la
  // señal más barata y fiable disponible antes de cargar nada.
  var euZone = false;
  try {
    var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    euZone = tz.indexOf('Europe/') === 0;
  } catch (e) {}
  window.__pcdEuZone = euZone;
  // Se pide decisión a todo el mundo (transparencia), pero solo se bloquea
  // la medición por defecto donde la ley lo exige.
  window.__pcdNeedsChoice = !saved;

  // ---------- 1. Consent Mode v2 ----------
  window.dataLayer = window.dataLayer || [];
  function gtag(){ window.dataLayer.push(arguments); }
  window.gtag = gtag;

  var ALL = ['ad_storage','ad_user_data','ad_personalization','analytics_storage','functionality_storage','personalization_storage'];
  function consentObj(value, extra){
    var o = {};
    for (var i=0;i<ALL.length;i++) o[ALL[i]] = value;
    o.security_storage = 'granted';
    if (extra) for (var k in extra) o[k] = extra[k];
    return o;
  }

  // Default global: concedido. El público es EE. UU. y México, donde no rige
  // el consentimiento previo; medir desde el primer segundo es lo correcto.
  gtag('consent', 'default', consentObj('granted'));
  // Default por región: en el EEE, Reino Unido y Suiza se espera decisión.
  gtag('consent', 'default', consentObj('denied', { region: CFG.regions, wait_for_update: 500 }));

  // Si ya hubo una decisión explícita, manda sobre cualquier default.
  if (saved) gtag('consent', 'update', consentObj(saved));

  gtag('set', 'ads_data_redaction', saved === 'denied');
  gtag('set', 'url_passthrough', true);

  // ---------- 2. Modo depuración ----------
  // ?pcd_debug=1 imprime cada evento en la consola y enciende DebugView de
  // GA4 para esta sesión. Se recuerda en sessionStorage para poder navegar.
  try {
    if (location.search.indexOf('pcd_debug=1') > -1) window.sessionStorage.setItem('pcd_debug', '1');
    if (location.search.indexOf('pcd_debug=0') > -1) window.sessionStorage.removeItem('pcd_debug');
    window.__pcdDebug = window.sessionStorage.getItem('pcd_debug') === '1';
  } catch (e) { window.__pcdDebug = false; }

  // ---------- 3. Google Analytics 4 ----------
  if (CFG.ga) {
    gtag('js', new Date());
    gtag('set', 'user_properties', {
      site_language: CFG.lang,
      content_group: CFG.group
    });
    gtag('config', CFG.ga, {
      send_page_view: true,
      content_group: CFG.group,
      page_key: CFG.page,
      site_language: CFG.lang,
      debug_mode: window.__pcdDebug
    });
    var g = document.createElement('script');
    g.async = true;
    g.src = 'https://www.googletagmanager.com/gtag/js?id=' + CFG.ga;
    document.head.appendChild(g);
  }

  // ---------- 4. Meta Pixel ----------
  if (CFG.pixel) {
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    // El Pixel tiene su propio interruptor de consentimiento y hay que
    // accionarlo ANTES de init para que no escriba cookies mientras tanto.
    var blockPixel = saved === 'denied' || (!saved && euZone);
    if (blockPixel) window.fbq('consent', 'revoke');
    window.fbq('init', CFG.pixel);
    window.fbq('track', 'PageView');
    // Si el Pixel arrancó revocado, la vista queda pendiente: se emite en
    // cuanto la persona acepta (lo hace ConsentBanner llamando a pcdConsent).
    window.__pcdPixelPending = blockPixel;
  }

})();
`
    : "";

const pixelNoscript = PIXEL
  ? `<img height="1" width="1" alt="" aria-hidden="true" style="display:none" src="https://www.facebook.com/tr?id=${PIXEL}&ev=PageView&noscript=1"/>`
  : "";
---

{bootstrap && <script is:inline set:html={bootstrap} />}
{pixelNoscript && <noscript set:html={pixelNoscript} />}
