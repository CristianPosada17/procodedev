---
/**
 * Sistema de iconos — ProCode Dev
 * ------------------------------------------------------------------
 * Reemplaza los emojis y los glifos tipográficos («▣», «✓», «→», «☰»,
 * «🌐»…) que se usaban antes como iconos. Un emoji se renderiza distinto
 * en cada sistema operativo, no hereda el color de la marca y le resta
 * seriedad a un sitio que se vende a firmas fiscales y contables.
 *
 * Todos los iconos son SVG inline, de trazo, 24×24, y heredan
 * `currentColor`, así que se pintan con la clase de texto del contenedor.
 * Los logos de marca (WhatsApp, redes, Google) van rellenos.
 *
 * Uso:  <Icon name="calendar" class="h-5 w-5" />
 */
import type { IconName } from "./icon-names";


interface Props {
  name: IconName;
  class?: string;
  id?: string;
  /** Solo para iconos que comunican información por sí mismos. */
  label?: string;
  strokeWidth?: number;
}

const {
  name,
  id,
  class: className = "h-5 w-5",
  label,
  strokeWidth = 1.7,
} = Astro.props as Props;

const BRANDS: IconName[] = [
  "whatsapp",
  "instagram",
  "linkedin",
  "facebook",
  "google",
];
const isBrand = BRANDS.includes(name);
---

