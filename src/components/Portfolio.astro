---
import { translations, PAGES, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import PortfolioCard from "./PortfolioCard.astro";
import CardRail from "./CardRail.astro";
interface Props {
  lang?: Lang;
  /** En /portafolio el H1 de PageHero ya dice esto: no repetirlo (hallazgo #13). */
  showHeading?: boolean;
}
const { lang = "es", showHeading = true } = Astro.props as Props;
const t = translations[lang];
const p = t.portfolio;

// Hallazgo #6: mezclar 2 demos y la marca personal del fundador con los
// clientes reales hacía que 5 casos se leyeran como 2 verificables.
// Ahora van en dos grupos rotulados, sin ambigüedad.
const clients = p.projects.filter((proj) => proj.kind !== "demo");
const demos = p.projects.filter((proj) => proj.kind === "demo");
---

<section id="portafolio" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    {
      showHeading && (
        <SectionHeading eyebrow={p.eyebrow}>
          <Fragment slot="title">
            {p.titleA}{" "}<span class="grad-text">{p.titleHighlight}</span>
          </Fragment>
          <Fragment slot="subtitle">{p.subtitle}</Fragment>
        </SectionHeading>
      )
    }

    {/* ── Clientes reales ── */}
    <div class:list={[showHeading ? "mt-12" : "mt-2"]}>
      <div class="reveal flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <h2 class="text-xl font-bold tracking-tight text-[var(--text)]">
          {p.clientsTitle}
        </h2>
        <p class="text-sm text-[var(--muted)]">{p.clientsNote}</p>
      </div>

      <CardRail class="mt-6" grid="md:grid-cols-2 lg:grid-cols-3" peek="wide" gap="gap-5 lg:gap-6">
        {
          clients.map((proj, i) => (
            <PortfolioCard project={proj} viewProject={p.viewProject} resultLabel={p.resultLabel} delay={i * 90} />
          ))
        }
      </CardRail>
    </div>

    {/* ── Demos y conceptos ── */}
    {
      demos.length > 0 && (
        <div class="mt-14 border-t border-[color:var(--border)] pt-12">
          <div class="reveal flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h2 class="text-xl font-bold tracking-tight text-[var(--text)]">
              {p.demosTitle}
            </h2>
            <span class="rounded-full border border-[color:var(--border-strong)] px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[var(--muted)]">
              demo
            </span>
          </div>
          <p class="reveal mt-2 max-w-2xl text-sm leading-7 text-[var(--muted)]">
            {p.demosNote}
          </p>

          <div class="mt-6 grid max-w-[980px] gap-6 sm:grid-cols-2">
            {demos.map((proj, i) => (
              <PortfolioCard
                project={proj}
                viewProject={p.viewProject} resultLabel={p.resultLabel}
                delay={i * 90}
              />
            ))}
          </div>
        </div>
      )
    }

    <div class="reveal mt-12 text-center">
      <a
        href={PAGES.contact[lang]}
        class="inline-flex items-center justify-center rounded-xl border border-[color:var(--border-strong)] bg-[var(--brand)]/10 px-6 py-3.5 text-sm font-bold text-[var(--text)] transition hover:bg-[var(--brand)]/20"
      >
        {p.cta} <Icon name="arrow-right" class="ml-2 h-4 w-4" />
      </a>
    </div>
  </div>
</section>
