---
import { translations, PAGES, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const p = t.portfolio;

const shot = (url: string) =>
  `https://s.wordpress.com/mshots/v1/${encodeURIComponent(url)}?w=900&h=560`;
---

<section id="portafolio" class="relative py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <SectionHeading eyebrow={p.eyebrow}>
      <Fragment slot="title">
        {p.titleA}{" "}<span class="grad-text">{p.titleHighlight}</span>
      </Fragment>
      <Fragment slot="subtitle">{p.subtitle}</Fragment>
    </SectionHeading>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        p.projects.map((proj, i) => (
          <a
            href={proj.url}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal group flex flex-col overflow-hidden rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/70 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)] hover:shadow-[0_24px_70px_-30px_rgba(37,99,235,0.55)]"
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <div class="relative aspect-[16/10] overflow-hidden border-b border-[color:var(--border)] bg-[var(--bg-2)]">
              <img
                src={shot(proj.url)}
                alt={proj.name}
                loading="lazy"
                class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
              />
              <span class="absolute left-3 top-3 rounded-full border border-[color:var(--border-strong)] bg-[var(--bg)]/80 px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-[var(--accent)] backdrop-blur">
                {proj.badge}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-base font-bold text-[var(--text)]">{proj.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-6 text-[var(--muted)]">
                {proj.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                {proj.tags.map((tag) => (
                  <span class="rounded-full border border-[color:var(--border)] px-2.5 py-1 text-[11px] text-[var(--muted)]">
                    {tag}
                  </span>
                ))}
              </div>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-[var(--accent)]">
                {p.viewProject}
                <span class="transition group-hover:translate-x-0.5">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="reveal mt-10 text-center">
      <a
        href={PAGES.contact[lang]}
        class="inline-flex items-center justify-center rounded-xl border border-[color:var(--border-strong)] bg-[var(--brand)]/10 px-6 py-3.5 text-sm font-bold text-[var(--text)] transition hover:bg-[var(--brand)]/20"
      >
        {p.cta} <span class="ml-2">→</span>
      </a>
    </div>
  </div>
</section>
