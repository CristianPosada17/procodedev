---
/*
  Tipos de proyecto (desarrollo web) o planes mensuales (marketing), con el
  precio a la vista. Los precios ya están publicados en /precios; repetirlos
  aquí evita que el visitante tenga que salir de la página de servicio justo
  cuando está decidiendo.

  Cada tarjeta lleva su propio botón (`data-plan`): antes los CTA colectivos
  mandaban a /precios o a /contacto y el visitante perdía por el camino el
  paquete que estaba mirando. Ahora el botón salta al formulario de la misma
  página y el plan elegido viaja con él hasta el correo.
*/
import { translations, PAGES, CONTACT, type Lang } from "../i18n/ui";
import type { ServiceDetail } from "../i18n/services";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

interface Props {
  packages: ServiceDetail["packages"];
  lang?: Lang;
}
const { packages: p, lang = "es" } = Astro.props as Props;
const t = translations[lang];
// La rejilla se ajusta al número real de tarjetas. Con `lg:grid-cols-3`
// fijas, los dos planes de marketing dejaban una tercera columna vacía a la
// derecha y la página parecía a medio cargar.
const count = p.items.length;
const cols =
  count >= 4 ? "lg:grid-cols-4" : count === 3 ? "lg:grid-cols-3" : "lg:grid-cols-2";
// Con dos tarjetas, además, se centran: a todo lo ancho quedan enormes.
const gridWidth = count === 2 ? "mx-auto max-w-4xl" : "";
---

<section id="paquetes" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <SectionHeading eyebrow={p.eyebrow} align="center" max="max-w-3xl">
      <Fragment slot="title">{p.title}</Fragment>
      <Fragment slot="subtitle">{p.subtitle}</Fragment>
    </SectionHeading>

    <div class:list={["mt-12 grid gap-5 sm:grid-cols-2", cols, gridWidth]}>
      {
        p.items.map((item, i) => (
          <article
            class:list={[
              "reveal relative flex flex-col rounded-[var(--radius)] border bg-[var(--surface)]/60 p-6 pt-7 backdrop-blur-xl transition duration-300 hover:-translate-y-1",
              item.highlighted
                ? "border-[color:var(--border-strong)] shadow-[0_30px_90px_-50px_var(--halo-card-strong)]"
                : "border-[color:var(--border)] hover:border-[color:var(--border-strong)]",
            ]}
            style={`--reveal-delay: ${i * 70}ms`}
          >
            {item.highlighted && (
              <span class="absolute -top-3 left-6 inline-flex w-fit rounded-full border border-[color:var(--border-strong)] bg-[var(--brand)] px-3 py-1 font-mono text-[10px] uppercase tracking-[0.16em] text-white shadow-[0_10px_30px_-12px_var(--halo-card-strong)]">
                {t.pricing.popular}
              </span>
            )}
            <h3 class="text-lg font-bold leading-snug text-[var(--text)]">
              {item.name}
            </h3>
            <p class="mt-4 flex items-baseline gap-1.5">
              {item.pricePrefix && (
                <span class="text-xs font-medium text-[var(--muted)]">
                  {item.pricePrefix}
                </span>
              )}
              <span class="text-3xl font-bold tracking-tight text-[var(--text)]">
                ${item.price}
              </span>
              <span class="text-xs font-medium text-[var(--muted)]">
                {item.currency}
              </span>
            </p>
            <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--muted)]">
              {item.priceNote}
            </p>
            <p class="mt-4 text-sm leading-7 text-[var(--muted)]">
              {item.description}
            </p>
            <ul class="mt-5 grid flex-1 gap-2.5 border-t border-[color:var(--border)] pt-5">
              {item.features.map((f) => (
                <li class="flex items-start gap-2.5 text-[13px] leading-6 text-[var(--text)]/85">
                  <span class="mt-1 flex h-4 w-4 flex-none items-center justify-center rounded bg-[var(--brand)]/15 text-[var(--accent)]">
                    <Icon name="check" class="h-2.5 w-2.5" strokeWidth={3} />
                  </span>
                  {f}
                </li>
              ))}
            </ul>

            <a
              href="#solicitar"
              data-plan={`${item.name} — $${item.price} ${item.currency}`}
              data-cta={`paquete-${item.name}`}
              class:list={[
                "mt-6 inline-flex items-center justify-between gap-2 rounded-xl px-5 py-3 text-sm font-bold transition",
                item.highlighted
                  ? "bg-[var(--brand)] text-white hover:bg-[var(--brand-strong)]"
                  : "border border-[color:var(--border-strong)] bg-[var(--tint)] text-[var(--text)] hover:bg-[var(--brand)]/12",
              ]}
            >
              {p.itemCta}
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </article>
        ))
      }
    </div>

    <p class="reveal mx-auto mt-8 max-w-3xl text-center text-sm leading-7 text-[var(--muted)]">
      {p.note}
    </p>

    {/* Lo que NO está en la comparación y por qué. En marketing el plan de
        mantenimiento de $79 estaba junto a los planes de captación y hacía
        parecer que competían: no captan lo mismo, ni siquiera captan. */}
    {
      p.aside && (
        <div class="reveal mx-auto mt-8 flex max-w-3xl flex-col gap-3 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--bg-2)]/60 p-6 sm:flex-row sm:items-start sm:gap-5">
          <span class="flex h-9 w-9 flex-none items-center justify-center rounded-xl bg-[var(--brand)]/12 text-[var(--accent)]">
            <Icon name="info" class="h-4 w-4" />
          </span>
          <div>
            <p class="text-sm font-bold text-[var(--text)]">{p.aside.title}</p>
            <p class="mt-2 text-sm leading-7 text-[var(--muted)]">{p.aside.body}</p>
            <a
              href={PAGES.pricing[lang]}
              data-cta="paquetes-soporte-web"
              class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-[var(--accent)] transition hover:underline"
            >
              {p.aside.cta}
              <Icon name="arrow-right" class="h-3.5 w-3.5" />
            </a>
          </div>
        </div>
      )
    }

    <div class="reveal mt-7 flex flex-wrap justify-center gap-3">
      <a
        href={PAGES.pricing[lang]}
        class="inline-flex items-center gap-2 rounded-xl border border-[color:var(--border-strong)] bg-[var(--tint)] px-6 py-3.5 text-sm font-bold text-[var(--text)] transition hover:-translate-y-0.5 hover:bg-[var(--brand)]/12"
      >
        {p.cta}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <a
        href={`https://wa.me/${CONTACT.whatsapp}`}
        target="_blank"
        rel="noopener noreferrer"
        data-cta="servicio-whatsapp"
        class="inline-flex items-center gap-2 rounded-xl border border-[color:var(--border-strong)] bg-[var(--tint)] px-6 py-3.5 text-sm font-bold text-[var(--text)] transition hover:-translate-y-0.5 hover:bg-[var(--brand)]/12"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        {t.common.ctaWhatsapp}
      </a>
    </div>
  </div>
</section>
