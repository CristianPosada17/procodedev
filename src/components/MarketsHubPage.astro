---
/*
  Hub de mercados: /diseno-web-estados-unidos/ y /en/web-design-united-states/.
  Presenta los tres estados y resuelve la objeción de fondo —contratar a
  alguien que no está en tu ciudad— que es la que frena la conversión de
  todo este eje. Sigue el orden común de las landings (sep 2026).
*/
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import LandingHero from "./LandingHero.astro";
import VisualMarketsHub from "./hero-visuals/VisualMarketsHub.astro";
import ServiceIntro from "./ServiceIntro.astro";
import MarketCards from "./MarketCards.astro";
import ServiceStandards from "./ServiceStandards.astro";
import Founder from "./Founder.astro";
import ProofStrip from "./ProofStrip.astro";
import FAQ from "./FAQ.astro";
import PriceAnchor from "./PriceAnchor.astro";
import Testimonials from "./Testimonials.astro";
import LandingConversion from "./LandingConversion.astro";
import Footer from "./Footer.astro";
import { translations, PAGES, type Lang } from "../i18n/ui";
import { marketsHub, markets, US_STATE_KEYS } from "../i18n/markets";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;
const t = translations[lang];
const hub = marketsHub[lang];

const itemList = US_STATE_KEYS.map((key) => ({
  name: markets[lang][key].name,
  description: markets[lang][key].navHint,
  url: PAGES[key][lang],
}));
---

<Layout
  lang={lang}
  page="markets"
  title={hub.meta.title}
  description={hub.meta.description}
  keywords={hub.meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.markets, path: PAGES.markets[lang] },
  ]}
  serviceName={hub.meta.heroTitleA}
  areaServed="United States"
  itemList={itemList}
  offerCatalog={hub.how.items.map((i) => ({
    title: i.title,
    description: i.description,
  }))}
  includeFaq={true}
  faqItems={hub.faq.items}
>
  <Header lang={lang} page="markets" />
  <main>
    {/* 1 · Hero: los tres estados como visual, cada uno con su color. */}
    <LandingHero
      lang={lang}
      page="markets"
      eyebrow={t.nav.markets}
      icon="globe"
      titleA={hub.meta.heroTitleA}
      highlight={hub.meta.heroHighlight}
      subtitle={hub.meta.heroSubtitle}
      lead={hub.meta.description}
      stats={[{
        label: t.priceAnchor.fromLabel,
        value: `$${t.priceAnchor.amount}`,
        note: `${t.priceAnchor.currency} · ${t.priceAnchor.amountNote}`,
      }]}
    >
      <VisualMarketsHub slot="visual" lang={lang} />
    </LandingHero>

    {/* 2 · Beneficios */}
    <ServiceIntro lang={lang} intro={hub.intro} icon="globe" />

    {/* 3 · Así es como se trabaja en remoto + proyectos reales */}
    <ServiceStandards lang={lang} standards={hub.how} id="en-remoto" />
    <ProofStrip lang={lang} />

    {/* 4 · Testimonios publicados */}
    <Testimonials lang={lang} />

    {/* 5 · Para quién es: los tres estados que atiendo */}
    <MarketCards lang={lang} />

    {/* 6 · El desarrollador y fundador */}
    <Founder lang={lang} page="markets" />

    {/* 7 · Información práctica: precios base publicados */}
    <PriceAnchor lang={lang} />

    {/* 8 · Preguntas frecuentes */}
    <FAQ lang={lang} data={hub.faq} id="dudas-remoto" />

    {/* 9 · Cierre: agenda y formulario (Nombre + Email) en esta página */}
    <LandingConversion lang={lang} page="markets" close={{ title: hub.meta.heroSubtitle }} />
  </main>
  <Footer lang={lang} />
</Layout>
