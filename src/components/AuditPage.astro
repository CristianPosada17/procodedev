---
/*
  Landing completa de la Auditoría Estratégica Integral (ES y EN comparten
  esta composición; el contenido vive en src/i18n/audit.ts).

  Orden común de las landings (septiembre de 2026):
  1 hero con el informe real como visual · 2 qué recibes · 3 cómo funciona ·
  4 testimonios · 5 gratis vs. de pago y filtro honesto · 6 fundador ·
  7 qué se audita · 8 dudas · 9 cierre con agenda y formulario.

  La comparación gratis/de pago va en el bloque «para quién es» porque es
  la objeción número uno: el sitio ya regala la Revisión Express, y si esta
  página no dice en qué se diferencia, o no vende o vende un malentendido.

  Reutiliza `ServiceCapabilities`, `ServiceStandards`, `ServiceFit` y `FAQ`:
  los bloques ya existían con la forma exacta que necesita esta página.
*/
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import LandingHero from "./LandingHero.astro";
import AuditVersus from "./AuditVersus.astro";
import AuditProcess from "./AuditProcess.astro";
import AuditCross from "./AuditCross.astro";
import ServiceCapabilities from "./ServiceCapabilities.astro";
import ServiceStandards from "./ServiceStandards.astro";
import ServiceFit from "./ServiceFit.astro";
import Testimonials from "./Testimonials.astro";
import Founder from "./Founder.astro";
import LandingConversion from "./LandingConversion.astro";
import ServiceShot from "./ServiceShot.astro";
import FAQ from "./FAQ.astro";
import Footer from "./Footer.astro";
import { translations, PAGES, type Lang } from "../i18n/ui";
import { audit } from "../i18n/audit";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props as Props;
const t = translations[lang];
const a = audit[lang];

// Las doce áreas y los cuatro entregables, para que un buscador con IA pueda
// contestar «qué incluye la auditoría» sin interpretar el diseño.
const offerCatalog = [
  ...a.areas.items.map((i) => ({ title: i.title, description: i.description })),
  ...a.deliverables.items.map((i) => ({
    title: i.title,
    description: i.description,
  })),
];
---

<Layout
  lang={lang}
  page="audit"
  title={a.meta.title}
  description={a.meta.description}
  keywords={a.meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.services, path: PAGES.services[lang] },
    { name: a.navLabel, path: PAGES.audit[lang] },
  ]}
  serviceName={a.navLabel}
  offerCatalog={offerCatalog}
  offerPrice={a.price}
  offerUrl={PAGES.audit[lang]}
  includeFaq={true}
  faqItems={a.faq.items}
>
  <Header lang={lang} page="audit" />
  <main>
    {/* 1 · Hero: el informe real de la auditoría es el visual. Precio a
        cotizar y plazo como cifras, y los dos CTAs. */}
    <LandingHero
      lang={lang}
      page="audit"
      eyebrow={a.badge}
      icon="clipboard-check"
      titleA={a.meta.heroTitleA}
      highlight={a.meta.heroHighlight}
      subtitle={a.meta.heroSubtitle}
      lead={a.navHint}
      stats={[
        { label: a.priceLabel, value: a.priceQuote, note: a.priceNote },
        { label: a.timelineLabel, value: a.timeline },
      ]}
      extraLink={{ label: a.areas.title, href: "#que-se-audita" }}
    >
      <div slot="visual" class="relative">
        <ServiceShot
          base={a.shot.imageBase}
          alt={a.shot.imageAlt}
          eager={true}
          class="lt-panel"
          sizes="(min-width: 1024px) 48vw, 92vw"
        />
        <p class="lt-panel lt-float absolute -top-6 right-4 z-20 hidden items-center gap-3 rounded-2xl px-4 py-3 sm:flex">
          <span class="lt-soft flex h-10 w-10 items-center justify-center rounded-xl font-mono text-base font-bold">
            {a.areas.items.length}
          </span>
          <span class="text-xs font-semibold leading-snug text-[var(--text)]">
            {lang === "es" ? "áreas del negocio revisadas" : "business areas reviewed"}
          </span>
        </p>
        <p class="mt-4 text-center text-xs leading-6 text-[var(--muted)]">{a.shot.caption}</p>
      </div>
    </LandingHero>

    {/* 2 · Beneficios: qué recibes (el informe ya se ve en el hero). */}
    <ServiceStandards
      lang={lang}
      standards={a.deliverables}
      id="que-recibes"
    />

    {/* 3 · Así es como se trabaja: las tres fases y los accesos */}
    <AuditProcess lang={lang} />

    {/* 4 · Testimonios publicados */}
    <Testimonials lang={lang} />

    {/* 5 · Para quién es: gratis vs. de pago (la objeción número uno) y el
        filtro honesto — aquí pesa más: se pide dinero por adelantado. */}
    <AuditVersus lang={lang} />
    <ServiceFit lang={lang} fit={a.fit} />

    {/* 6 · El desarrollador y fundador */}
    <Founder lang={lang} page="audit" />

    {/* 7 · Información práctica: las doce áreas que se auditan */}
    <ServiceCapabilities
      lang={lang}
      heading={{
        eyebrow: a.areas.eyebrow,
        title: a.areas.title,
        subtitle: a.areas.subtitle,
      }}
      items={a.areas.items}
      id="que-se-audita"
    />

    {/* 8 · Preguntas frecuentes */}
    <FAQ lang={lang} data={a.faq} id="dudas-auditoria" />
    <AuditCross lang={lang} />

    {/* 9 · Cierre: agenda y formulario (Nombre + Email) en esta página */}
    <LandingConversion
      lang={lang}
      page="audit"
      close={{ eyebrow: `// ${a.navLabel}`, title: a.meta.heroSubtitle }}
      formHeading={a.form}
      service={a.navLabel}
    />
  </main>
  <Footer lang={lang} />
</Layout>
