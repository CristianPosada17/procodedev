---
import { translations, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import CardRail from "./CardRail.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const sys = t.system;
---

{/*
  El recorrido del cliente en cinco etapas. Cada tarjeta se quedó con lo
  mínimo —icono, nombre y una línea— porque el detalle de qué se construye
  en cada etapa ya vive en /servicios y en las páginas de giro.
*/}
<section id="sistema" class="relative py-12 lg:py-20">
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <SectionHeading eyebrow={sys.eyebrow}>
      <Fragment slot="title">
        {sys.titleA}{" "}<span class="grad-text">{sys.titleHighlight}</span>
      </Fragment>
      <Fragment slot="subtitle">{sys.subtitle}</Fragment>
    </SectionHeading>

    <CardRail class="mt-10 lg:mt-14" grid="md:grid-cols-3 lg:grid-cols-5" peek="normal">
      {
        sys.stages.map((stage, i) => (
          <div
            class="reveal relative flex flex-col items-center rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-6 text-center backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)]"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--muted)]">
              {stage.step}
            </span>
            <span class="mt-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-[var(--brand)]/12 text-[var(--accent)] ring-1 ring-[color:var(--border-strong)]">
              <Icon name={stage.icon as any} class="h-7 w-7" />
            </span>
            <h3 class="mt-4 text-lg font-bold leading-snug text-[var(--text)]">
              {stage.name}
            </h3>
            <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
              {stage.summary}
            </p>
          </div>
        ))
      }
    </CardRail>
  </div>
</section>
