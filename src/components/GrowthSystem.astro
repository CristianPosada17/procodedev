---
import { translations, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import MiniUI from "./MiniUI.astro";
import CardRail from "./CardRail.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const sys = t.system;
---

{/*
  El recorrido del cliente en cinco etapas. Cada tarjeta se quedó con lo
  mínimo —icono, nombre y una línea— porque el detalle de qué se construye
  en cada etapa ya vive en /servicios y en las páginas de giro.
*/}
<section id="sistema" class="relative py-12 lg:py-20">
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <SectionHeading eyebrow={sys.eyebrow}>
      <Fragment slot="title">
        {sys.titleA}{" "}<span class="grad-text">{sys.titleHighlight}</span>
      </Fragment>
      <Fragment slot="subtitle">{sys.subtitle}</Fragment>
    </SectionHeading>

    {/* Nov 2026: cada etapa enseña un trocito de producto en movimiento
        (MiniUI) en lugar de un icono, unidas por una línea de recorrido. */}
    <div class="relative mt-10 lg:mt-16">
      <div class="pointer-events-none absolute inset-x-[10%] top-[1.15rem] hidden h-px bg-[color:var(--border)] lg:block" aria-hidden="true">
        <span class="draw-x reveal absolute inset-0 bg-gradient-to-r from-[var(--brand)] via-[var(--accent)] to-[var(--brand)]"></span>
        <span class="flow-line absolute inset-0"></span>
      </div>
      <CardRail grid="md:grid-cols-3 lg:grid-cols-5" peek="normal">
        {
          sys.stages.map((stage, i) => (
            <div class="reveal flex flex-col" style={`--reveal-delay: ${i * 90}ms`}>
              <span class="relative z-10 mx-auto hidden h-9 w-9 items-center justify-center rounded-full border border-[color:var(--border-strong)] bg-[var(--bg)] font-mono text-[11px] font-bold text-[var(--accent)] shadow-[0_0_0_6px_var(--bg)] lg:flex">
                {stage.step}
              </span>
              <div class="card-pro mt-0 flex flex-1 flex-col rounded-[var(--radius)] p-4 lg:mt-5">
                <MiniUI kind={stage.icon} />
                <div class="mt-5 flex items-baseline gap-2.5 px-1">
                  <span class="num-mark text-2xl lg:hidden">{stage.step}</span>
                  <h3 class="text-lg font-bold leading-snug text-[var(--text)]">
                    {stage.name}
                  </h3>
                </div>
                <p class="mt-2 px-1 pb-1 text-sm leading-6 text-[var(--muted)]">
                  {stage.summary}
                </p>
              </div>
            </div>
          ))
        }
      </CardRail>
    </div>
  </div>
</section>
