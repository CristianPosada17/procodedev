---
import { translations, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const sys = t.system;
---

{/*
  El recorrido del cliente de una firma fiscal, en cinco etapas.
  Es la sección que sostiene el posicionamiento nuevo: sin ella, «sistemas
  digitales de crecimiento» es una frase de marketing; con ella, es una
  descripción de qué se construye y en qué orden.
*/}
<section id="sistema" class="relative py-12 lg:py-20">
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <SectionHeading eyebrow={sys.eyebrow}>
      <Fragment slot="title">
        {sys.titleA}{" "}<span class="grad-text">{sys.titleHighlight}</span>
      </Fragment>
      <Fragment slot="subtitle">{sys.subtitle}</Fragment>
    </SectionHeading>

    <ol class="mt-10 grid gap-4 lg:mt-14 lg:grid-cols-5">
      {
        sys.stages.map((stage, i) => (
          <li
            class="reveal relative flex flex-col rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-6 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[color:var(--border-strong)]"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <div class="flex items-center justify-between">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--brand)]/10 text-[var(--accent)]">
                <Icon name={stage.icon as any} class="h-6 w-6" />
              </span>
              <span class="font-mono text-[10px] uppercase tracking-widest text-[var(--muted)]">
                {stage.step}
              </span>
            </div>

            <h3 class="mt-5 text-lg font-bold leading-snug text-[var(--text)]">
              {stage.name}
            </h3>
            <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--accent)]">
              {stage.summary}
            </p>
            <p class="mt-3 text-sm leading-6 text-[var(--muted)]">
              {stage.description}
            </p>

            <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--muted)]">
              {sys.buildLabel}
            </p>
            <ul class="mt-3 grid gap-2">
              {stage.build.map((b) => (
                <li class="flex items-start gap-2.5 text-xs leading-5 text-[var(--text)]/85">
                  <span class="mt-0.5 flex h-4 w-4 flex-none items-center justify-center rounded bg-[var(--brand)]/15 text-[var(--accent)]">
                    <Icon name="check" class="h-3 w-3" strokeWidth={2.6} />
                  </span>
                  {b}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div
      class="reveal mt-8 flex flex-col gap-3 rounded-[var(--radius)] border border-[color:var(--border-strong)] bg-[var(--brand)]/[0.06] p-7 lg:flex-row lg:items-center lg:gap-8 lg:p-8"
    >
      <p
        class="flex-none font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]"
      >
        {sys.closingTitle}
      </p>
      <p class="text-sm leading-7 text-[var(--text)]/90">{sys.closingBody}</p>
    </div>
  </div>
</section>
