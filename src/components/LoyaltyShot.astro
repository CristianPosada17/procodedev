---
/*
  Visual del producto ProCode Loyalty (noviembre de 2026): un celular con
  la tarjeta de fidelidad en el Wallet. Hecho en HTML/CSS, sin imagen:
  los sellos se marcan uno a uno, una línea de escaneo pasa por el QR y
  aparece el aviso de visita registrada. Estilos en global.css →
  «TARJETA DE FIDELIDAD».
*/
import type { LoyaltyLine } from "../i18n/services";
import Icon from "./Icon.astro";

interface Props {
  card: LoyaltyLine["card"];
}
const { card } = Astro.props as Props;

// Patrón fijo de QR decorativo (15×15) con los tres «ojos» de un QR real:
// anillo de 5×5, hueco y punto central de 1×1.
const N = 15;
const qr = Array.from({ length: N * N }, (_, i) => {
  const r = Math.floor(i / N);
  const c = i % N;
  for (const [er, ec] of [[0, 0], [0, N - 5], [N - 5, 0]]) {
    const y = r - er;
    const x = c - ec;
    if (y >= -1 && y <= 5 && x >= -1 && x <= 5) {
      if (y < 0 || y > 4 || x < 0 || x > 4) return false; // margen del ojo
      const ring = y === 0 || y === 4 || x === 0 || x === 4;
      return ring || (y === 2 && x === 2);
    }
  }
  return ((r * 7 + c * 13 + r * c) % 5) < 2;
});
const stamps = 6;
const filled = 4;
---

<div
  class="ly-stage relative isolate aspect-[4/3] overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] sm:aspect-[16/11]"
  role="img"
  aria-label={`${card.kind} · ${card.reward}`}
>
  <div class="bg-hex-light hex-drift pointer-events-none absolute -z-10" aria-hidden="true"></div>

  <div class="absolute inset-0 flex items-center justify-center gap-6 px-5 sm:gap-10">
    {/* Celular con la tarjeta */}
    <div class="ly-phone lt-float relative w-[52%] max-w-[14.5rem] rounded-[2rem] p-2.5 sm:w-[36%]">
      <div class="flex items-center justify-between px-2 pb-2 pt-1 text-[9px] font-semibold text-white/70">
        <span>9:41</span>
        <span class="h-3.5 w-14 rounded-full bg-black"></span>
        <span>100%</span>
      </div>
      <p class="px-2 text-[11px] font-bold text-white">Wallet</p>

      <div class="ly-card mt-2 rounded-2xl p-3 text-white">
        <div class="flex items-center gap-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/15 ring-1 ring-white/25">
            <Icon name="star" class="h-3.5 w-3.5" />
          </span>
          <div class="min-w-0">
            <p class="truncate text-[11px] font-bold leading-tight">{card.business}</p>
            <p class="text-[8px] uppercase leading-tight tracking-[0.1em] text-white/60">{card.kind}</p>
          </div>
        </div>

        <p class="mt-3 text-[8px] uppercase tracking-[0.14em] text-white/55">{card.customer}</p>
        <div class="mt-1.5 grid grid-cols-6 gap-1.5">
          {
            Array.from({ length: stamps }, (_, i) => (
              <span
                class:list={["ly-stamp aspect-square rounded-full", i < filled && "is-on"]}
                style={`--d:${i * 0.45}s`}
              />
            ))
          }
        </div>
        <p class="mt-2 text-[9px] font-semibold text-white/80">{card.reward}</p>

        <div class="relative mx-auto mb-1 mt-2.5 w-[50%] overflow-hidden rounded-lg bg-white p-1.5">
          <div class="grid grid-cols-[repeat(15,1fr)]" aria-hidden="true">
            {qr.map((on) => <i class:list={["aspect-square", on ? "bg-slate-900" : "bg-white"]} />)}
          </div>
          <span class="ly-scan absolute inset-x-1 top-1.5 h-0.5 rounded-full" aria-hidden="true"></span>
        </div>
      </div>
    </div>

    {/* Lado derecho: aviso y wallets */}
    <div class="hidden w-[38%] max-w-[15rem] flex-col gap-3 sm:flex">
      <span class="ly-toast inline-flex items-center gap-2 self-start rounded-full bg-white px-3 py-1.5 text-[11px] font-bold text-slate-900 shadow-[0_14px_30px_-12px_rgba(0,0,0,0.6)]">
        <span class="flex h-4 w-4 items-center justify-center rounded-full bg-emerald-500 text-white">
          <Icon name="check" class="h-2.5 w-2.5" strokeWidth={3} />
        </span>
        {card.toast}
      </span>
      <div class="lt-float-2 rounded-2xl border border-white/12 bg-white/[0.07] p-3 backdrop-blur">
        <div class="grid gap-2">
          <span class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-black px-2 py-2 text-[10px] font-semibold text-white ring-1 ring-white/15">
            <Icon name="smartphone" class="h-3 w-3" /> Apple Wallet
          </span>
          <span class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-white px-2 py-2 text-[10px] font-semibold text-slate-900">
            <Icon name="google" class="h-3 w-3" /> Google Wallet
          </span>
        </div>
        <div class="mt-3 grid grid-cols-3 gap-1.5" aria-hidden="true">
          <span class="h-1.5 rounded-full bg-cyan-300/70"></span>
          <span class="h-1.5 rounded-full bg-white/20"></span>
          <span class="h-1.5 rounded-full bg-white/20"></span>
        </div>
      </div>
      <div class="lt-float-3 flex items-center gap-2.5 rounded-2xl border border-white/12 bg-white/[0.07] p-3 backdrop-blur">
        <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-amber-300 to-yellow-500 text-slate-900">
          <Icon name="star" class="h-4 w-4" />
        </span>
        <span class="min-w-0">
          <span class="block h-2 w-20 rounded-full bg-white/60"></span>
          <span class="mt-1.5 block h-1.5 w-14 rounded-full bg-white/25"></span>
        </span>
      </div>
    </div>
  </div>
</div>
