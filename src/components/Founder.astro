---
import { translations, CONTACT, conversionHref, type Lang, type PageKey } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  lang?: Lang;
  /** Página que lo contiene: decide si la agenda está aquí o en /contacto/. */
  page?: PageKey;
}
const { lang = "es", page } = Astro.props as Props;
const t = translations[lang];
const f = t.founder;

// Hallazgos #11 y #16: el copy alternaba entre «diseñamos / nosotros»
// (agencia) y «analizo / yo la mantengo» (persona). Para un negocio local, la
// cara y el nombre convierten más que la palabra «agencia».
const initials = f.name
  .split(" ")
  .map((w) => w[0])
  .slice(0, 2)
  .join("");

// Redes confirmadas en CONTACT (src/i18n/ui.ts). Se muestran sin enlace:
// mientras siga vigente la regla de enlaces externos, solo el footer enlaza
// a redes. El usuario de cada red sale de su propia URL, no se escribe a mano.
const handle = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?[^/]+\//, "").replace(/\/$/, "").replace(/^in\//, "");
const socials = [
  { label: "LinkedIn", icon: "linkedin" as const, handle: handle(CONTACT.linkedin) },
  { label: "Instagram", icon: "instagram" as const, handle: `@${handle(CONTACT.instagram)}` },
  { label: "Facebook", icon: "facebook" as const, handle: handle(CONTACT.facebook) },
];
---

<section id="quien" class="relative py-10 lg:py-16">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    {/* La foto ocupa toda la columna izquierda de la tarjeta, de arriba a
        abajo (en móvil va arriba, a todo el ancho). Antes era un recuadro
        de 144–280 px que se perdía junto a un texto mucho más alto. */}
    <div
      class="reveal mx-auto grid max-w-6xl overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--border)] bg-[var(--surface)]/60 text-center backdrop-blur-xl md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:text-left"
    >
      <div
        class="relative aspect-[4/5] w-full overflow-hidden bg-[var(--brand)]/10 sm:aspect-[4/3] md:aspect-auto md:min-h-full"
      >
        <span
          class="absolute inset-0 flex items-center justify-center font-mono text-6xl font-bold text-[var(--accent)]"
          aria-hidden="true"
        >
          {initials}
        </span>
        <picture>
          <source
            type="image/avif"
            sizes="(min-width: 768px) 42vw, 100vw"
            srcset="/images/cristian-posada-retrato-400.avif 400w, /images/cristian-posada-retrato-795.avif 795w"
          />
          <source
            type="image/webp"
            sizes="(min-width: 768px) 42vw, 100vw"
            srcset="/images/cristian-posada-retrato-400.webp 400w, /images/cristian-posada-retrato-795.webp 795w"
          />
          <img
            src="/images/cristian-posada-retrato-795.webp"
            alt={`${f.name} — ${f.role}`}
            loading="lazy"
            decoding="async"
            width="795"
            height="1067"
            class="absolute inset-0 h-full w-full object-cover object-[50%_15%] md:object-[45%_top]"
            onerror="this.remove()"
          />
        </picture>
        {/* Degradado hacia la tarjeta para que la foto no termine en seco. */}
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[var(--surface)]/70 to-transparent md:inset-y-0 md:left-auto md:right-0 md:h-full md:w-1/4 md:bg-gradient-to-l"
          aria-hidden="true"
        >
        </div>
      </div>

      <div class="flex flex-col items-center p-8 md:items-start lg:p-12">
        {f.eyebrow && <span class="eyebrow mb-3">{f.eyebrow}</span>}
        <h2
          class="text-2xl font-bold leading-tight tracking-tight text-[var(--text)] sm:text-3xl lg:text-4xl"
        >
          {f.title}
        </h2>

        <p class="mt-3 text-base font-bold text-[var(--text)]">{f.name}</p>
        <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--accent)]">
          {f.role}
        </p>

        <p
          class="mt-5 max-w-xl text-base leading-8 text-[var(--muted)] lg:text-lg lg:leading-9"
        >
          {f.body}
        </p>

        <dl class="mt-6 grid w-full max-w-xl grid-cols-2 gap-3 text-left">
          {
            f.highlights.map((h) => (
              <div class="rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--bg-2)]/60 px-4 py-3">
                <dt class="text-lg font-bold tracking-tight text-[var(--text)]">{h.value}</dt>
                <dd class="mt-0.5 text-xs leading-5 text-[var(--muted)]">{h.label}</dd>
              </div>
            ))
          }
        </dl>

        <ul
          class="mt-6 flex flex-wrap justify-center gap-2 md:justify-start"
          aria-label={lang === "es" ? "Redes sociales" : "Social profiles"}
        >
          {
            socials.map((s) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border)] bg-[var(--tint)] px-3 py-1.5 text-xs text-[var(--muted)]">
                <Icon name={s.icon} class="h-3.5 w-3.5 text-[var(--accent)]" />
                <span class="font-semibold text-[var(--text)]">{s.label}</span>
                <span class="font-mono text-[11px]">{s.handle}</span>
              </li>
            ))
          }
        </ul>

        <a
          href={conversionHref(page ?? "blog", lang, "book")}
          data-cta="fundador-agendar"
          class="btn-cta mt-8 self-center"
        >
          {f.cta} <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</section>
