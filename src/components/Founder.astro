---
import { translations, PAGES, CONTACT, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const f = t.founder;

// Hallazgos #11 y #16: el copy alternaba entre «diseñamos / nosotros»
// (agencia) y «analizo / yo la mantengo» (persona). Para un negocio local, la
// cara y el nombre convierten más que la palabra «agencia».
const initials = f.name
  .split(" ")
  .map((w) => w[0])
  .slice(0, 2)
  .join("");
---

<section id="quien" class="relative py-10 lg:py-16">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    {/* En móvil todo va centrado en una sola columna —foto, titular, nombre,
        frase y botón— porque la foto pequeña arriba a la izquierda con el
        texto desalineado debajo se veía desbalanceada. A partir de sm vuelve
        la fila con la foto en su propia columna. */}
    <div
      class="reveal mx-auto grid max-w-6xl gap-7 rounded-[var(--radius-lg)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-8 text-center backdrop-blur-xl sm:grid-cols-[auto_1fr] sm:items-center sm:gap-10 sm:text-left lg:grid-cols-[minmax(0,280px)_1fr] lg:gap-14 lg:p-12"
    >
      <div
        class="relative mx-auto h-36 w-36 flex-none overflow-hidden rounded-[var(--radius)] border border-[color:var(--border-strong)] bg-[var(--brand)]/10 shadow-[0_20px_60px_-30px_var(--halo-card-strong)] sm:mx-0 sm:h-44 sm:w-44 lg:h-auto lg:w-full lg:flex-auto"
      >
        <span
          class="absolute inset-0 flex items-center justify-center font-mono text-3xl font-bold text-[var(--accent)] lg:text-6xl"
          aria-hidden="true"
        >
          {initials}
        </span>
        <picture>
          {/* La foto se muestra a 144 px en movil y ~300 px en escritorio;
              el original de 600x600 y 37 KB era mas de lo necesario. */}
          <source
            type="image/avif"
            sizes="(min-width: 1024px) 300px, 176px"
            srcset="/images/cristian-posada-300.avif 300w, /images/cristian-posada-600.avif 600w"
          />
          <source
            type="image/webp"
            sizes="(min-width: 1024px) 300px, 176px"
            srcset="/images/cristian-posada-300.webp 300w, /images/cristian-posada-600.webp 600w"
          />
          <img
            src="/images/cristian-posada-600.webp"
            alt={`${f.name} — ${f.role}`}
            loading="lazy"
            decoding="async"
            width="600"
            height="600"
            class="relative h-full w-full object-cover lg:aspect-square lg:h-auto"
            onerror="this.remove()"
          />
        </picture>
      </div>

      <div class="flex flex-col items-center sm:items-start">
        <h2
          class="text-2xl font-bold leading-tight tracking-tight text-[var(--text)] sm:text-3xl lg:text-4xl"
        >
          {f.title}
        </h2>

        <p class="mt-3 text-base font-bold text-[var(--text)]">{f.name}</p>
        <p class="mt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--accent)]">
          {f.role}
        </p>

        <p
          class="mt-5 max-w-xl text-base leading-8 text-[var(--muted)] lg:text-lg lg:leading-9"
        >
          {f.body}
        </p>

        <a
          href={PAGES.contact[lang]}
          class="mt-7 inline-flex items-center justify-center rounded-xl border border-[color:var(--border-strong)] bg-[var(--brand)]/10 px-6 py-3.5 text-sm font-bold text-[var(--text)] transition hover:bg-[var(--brand)]/20"
        >
          {f.cta} <Icon name="arrow-right" class="ml-2 h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</section>
