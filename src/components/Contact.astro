---
import Icon from "./Icon.astro";
import { translations, CONTACT, waHref, type Lang } from "../i18n/ui";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const c = t.contact;

// Script del formulario construido como cadena en el frontmatter (evita que
// las llaves / ${} de un template literal rompan el parser de Astro).
const contactScript = `
  (function(){
    var form = document.getElementById('contact-form');
    var status = document.getElementById('contact-status');
    var btn = document.getElementById('contact-submit');
    if(!form) return;
    var SENDING = ${JSON.stringify(c.sending)};
    var OK = ${JSON.stringify(c.success)};
    var FAIL = ${JSON.stringify(c.error)};
    var LABEL = ${JSON.stringify(c.submit)};
    function show(msg, ok){
      if(!status) return;
      status.textContent = msg;
      status.classList.remove('hidden');
      status.style.color = ok ? 'var(--ok)' : 'var(--err)';
    }
    form.addEventListener('submit', async function(e){
      e.preventDefault();
      if(btn){ btn.disabled = true; btn.textContent = SENDING; }
      try {
        if(window.pcdFillAttribution) window.pcdFillAttribution(form);
        var data = Object.fromEntries(new FormData(form));
        var res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data)
        });
        var result = await res.json();
        if(result.success){
          show(OK, true);
          form.reset();
          if(window.pcdTrack){
            var lead = window.pcdAttribution ? window.pcdAttribution() : {};
            lead.form_name = 'contacto';
            lead.lead_type = 'formulario';
            lead.project_type = data.project_type || '';
            lead.value = 1;
            lead.currency = 'USD';
            window.pcdTrack('generate_lead', lead, {
              event: 'Lead',
              params: { content_name: 'Formulario de contacto', content_category: 'contacto', value: 1, currency: 'USD' }
            });
          } else {
            if(window.fbq) window.fbq('track','Lead');
            if(window.gtag) window.gtag('event','generate_lead',{ origen:'formulario_contacto' });
          }
        } else {
          show(FAIL, false);
          if(window.pcdTrack) window.pcdTrack('form_error', { form_name:'contacto', error_type:'rechazado' });
        }
      } catch(err){
        show(FAIL, false);
        if(window.pcdTrack) window.pcdTrack('form_error', { form_name:'contacto', error_type:'red' });
      }
      finally { if(btn){ btn.disabled = false; btn.textContent = LABEL; } }
    });
  })();
`;

const inputClass =
  "rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)]/70 focus:border-[color:var(--border-strong)]";
---

{/*
  Hallazgo #2 (agosto): todos los CTAs del sitio prometían «agendar», así
  que el calendario pasó a ir primero y este bloque quedó colapsado debajo.

  Septiembre de 2026: eso dejó al visitante que apenas compara proveedores
  con el camino más caro delante —elegir horario y comprometer 20 minutos—
  y el barato escondido tras un `<details>`. El formulario vuelve a estar
  abierto y va primero; el calendario queda debajo para quien prefiera
  hablar. Si alguna vez vuelve a colapsarse, ha vuelto el problema.

  Hallazgo #3: `message` era obligatorio (redacción libre, el campo más caro)
  y `phone` opcional — justo al revés de lo que conviene. Invertido.
*/}
<section id="contacto" class="relative pb-14 pt-4">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div
      class="reveal mx-auto max-w-5xl overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/50 backdrop-blur-xl"
    >
      <div class="grid gap-10 p-6 lg:grid-cols-[0.85fr_1.15fr] lg:p-9">
        <div>
          <h2 class="text-2xl font-bold leading-[1.15] tracking-tight text-[var(--text)]">
            {c.titleA}{" "}<span class="grad-text">{c.titleHighlight}</span>
          </h2>
          <p class="mt-4 text-sm leading-7 text-[var(--muted)]">{c.subtitle}</p>

          <ul class="mt-6 grid gap-3">
            {
              c.perks.map((perk) => (
                <li class="flex items-start gap-3 text-sm text-[var(--text)]/90">
                  <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-md bg-[var(--brand)]/15 text-xs text-[var(--accent)]">
                    <Icon name="check" class="h-3 w-3" strokeWidth={2.6} />
                  </span>
                  {perk}
                </li>
              ))
            }
          </ul>

          <div class="mt-7 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--bg-2)]/60 p-5">
            <p class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]">
              {c.directTitle}
            </p>
            <div class="mt-4 flex flex-col gap-3 text-sm">
              <a
                href={waHref("contact", lang)}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-[var(--text)] transition hover:text-[var(--accent)]"
              >
                <Icon name="whatsapp" class="h-4 w-4 text-emerald-400" />
                WhatsApp · {CONTACT.whatsappDisplay}
              </a>
              <a
                href={`mailto:${CONTACT.email}`}
                class="inline-flex items-center gap-2 text-[var(--text)] transition hover:text-[var(--accent)]"
              >
                <Icon name="mail" class="h-4 w-4 text-[var(--accent)]" />
                {CONTACT.email}
              </a>
            </div>
          </div>
        </div>

        <form
          id="contact-form"
          data-form="contacto"
          class="rounded-[var(--radius)] border border-[color:var(--border-strong)] bg-[var(--surface)]/70 p-6 lg:p-7"
        >
          <input type="hidden" name="access_key" value={CONTACT.web3formsKey} />
          {/* Origen del lead: lo rellena el motor de medición justo antes de
              enviar, para que el correo ya diga de dónde vino sin abrir GA4. */}
          <input type="hidden" name="lead_origen" value="" />
          <input type="hidden" name="lead_campana" value="" />
          <input type="hidden" name="lead_pagina" value="" />
          <input type="hidden" name="lead_landing" value="" />
          <input type="hidden" name="lead_primer_contacto" value="" />
          <input
            type="hidden"
            name="subject"
            value="Nuevo contacto desde procodedev.com"
          />
          <input type="hidden" name="from_name" value="ProCode Dev — Web" />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />

          <div class="grid gap-5">
            <label class="grid gap-2">
              <span class="text-sm font-medium text-[var(--text)]">{c.fieldName}</span>
              <input
                type="text"
                name="name"
                required
                autocomplete="name"
                placeholder={c.phName}
                class={inputClass}
              />
            </label>

            <div class="grid gap-5 sm:grid-cols-2">
              <label class="grid gap-2">
                {/* `phone` pasa a requerido: es el dato con el que se cierra. */}
                <span class="text-sm font-medium text-[var(--text)]">{c.fieldPhone}</span>
                <input
                  type="tel"
                  name="phone"
                  required
                  autocomplete="tel"
                  placeholder={c.phPhone}
                  class={inputClass}
                />
              </label>
              <label class="grid gap-2">
                <span class="text-sm font-medium text-[var(--text)]">{c.fieldEmail}</span>
                <input
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder={c.phEmail}
                  class={inputClass}
                />
              </label>
            </div>

            <label class="grid gap-2">
              <span class="text-sm font-medium text-[var(--text)]">{c.fieldType}</span>
              <select
                name="project_type"
                class="rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-sm text-[var(--text)] outline-none transition focus:border-[color:var(--border-strong)]"
              >
                {c.types.map((ty) => <option value={ty}>{ty}</option>)}
              </select>
            </label>

            <label class="grid gap-2">
              {/* `message` deja de ser obligatorio: redacción libre es el
                  campo de mayor costo cognitivo del formulario. */}
              <span class="flex items-center gap-2 text-sm font-medium text-[var(--text)]">
                {c.fieldMessage}
                <span class="rounded-full border border-[color:var(--border)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[var(--muted)]">
                  {c.optionalTag}
                </span>
              </span>
              <textarea
                name="message"
                rows="3"
                placeholder={c.phMessage}
                class:list={["resize-none", inputClass]}></textarea>
            </label>

            <button
              id="contact-submit"
              type="submit"
              class="inline-flex items-center justify-center rounded-xl bg-[var(--brand)] px-6 py-4 text-sm font-bold text-white transition hover:bg-[var(--brand-strong)] disabled:opacity-60"
            >
              {c.submit}
            </button>

            <p id="contact-status" class="hidden text-sm" role="status"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline set:html={contactScript}></script>
