---
import { translations, CONTACT, type Lang } from "../i18n/ui";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const c = t.contact;
const waMsg = encodeURIComponent(
  lang === "es"
    ? "Hola ProCode, quiero información para mi negocio."
    : "Hi ProCode, I'd like info for my business.",
);

// Script del formulario construido como cadena en el frontmatter (evita que
// las llaves / ${} de un template literal rompan el parser de Astro).
const contactScript = `
  (function(){
    var form = document.getElementById('contact-form');
    var status = document.getElementById('contact-status');
    var btn = document.getElementById('contact-submit');
    if(!form) return;
    var SENDING = ${JSON.stringify(c.sending)};
    var OK = ${JSON.stringify(c.success)};
    var FAIL = ${JSON.stringify(c.error)};
    var LABEL = ${JSON.stringify(c.submit)};
    function show(msg, ok){
      if(!status) return;
      status.textContent = msg;
      status.classList.remove('hidden');
      status.style.color = ok ? '#4ade80' : '#f87171';
    }
    form.addEventListener('submit', async function(e){
      e.preventDefault();
      if(btn){ btn.disabled = true; btn.textContent = SENDING; }
      try {
        var data = Object.fromEntries(new FormData(form));
        var res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data)
        });
        var result = await res.json();
        if(result.success){
          show(OK, true);
          form.reset();
          if(window.fbq) window.fbq('track','Lead');
          if(window.gtag) window.gtag('event','generate_lead',{ origen:'formulario_contacto' });
        } else { show(FAIL, false); }
      } catch(err){ show(FAIL, false); }
      finally { if(btn){ btn.disabled = false; btn.textContent = LABEL; } }
    });
  })();
`;
---

<section id="contacto" class="relative py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="reveal">
        <span class="eyebrow">{c.eyebrow}</span>
        <h2 class="mt-5 text-3xl font-bold leading-[1.1] tracking-tight text-[var(--text)] sm:text-4xl">
          {c.titleA}{" "}<span class="grad-text">{c.titleHighlight}</span>
        </h2>
        <p class="mt-5 text-base leading-8 text-[var(--muted)]">{c.subtitle}</p>

        <ul class="mt-8 grid gap-3">
          {
            c.perks.map((perk) => (
              <li class="flex items-start gap-3 text-sm text-[var(--text)]/90">
                <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-md bg-[var(--brand)]/15 text-xs text-[var(--accent)]">
                  ✓
                </span>
                {perk}
              </li>
            ))
          }
        </ul>

        <div class="mt-8 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-6">
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]">
            {c.directTitle}
          </p>
          <div class="mt-4 flex flex-col gap-3 text-sm">
            <a
              href={`https://wa.me/${CONTACT.whatsapp}?text=${waMsg}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-[var(--text)] transition hover:text-[var(--accent)]"
            >
              💬 WhatsApp · {CONTACT.whatsappDisplay}
            </a>
            <a
              href={`mailto:${CONTACT.email}`}
              class="inline-flex items-center gap-2 text-[var(--text)] transition hover:text-[var(--accent)]"
            >
              ✉️ {CONTACT.email}
            </a>
          </div>
        </div>
      </div>

      <div class="reveal reveal-right">
        <form
          id="contact-form"
          class="rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/70 p-7 backdrop-blur-xl lg:p-8"
        >
          <input type="hidden" name="access_key" value={CONTACT.web3formsKey} />
          <input
            type="hidden"
            name="subject"
            value="Nuevo contacto desde procodedev.com"
          />
          <input type="hidden" name="from_name" value="ProCode Dev — Web" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="grid gap-5">
            <label class="grid gap-2">
              <span class="text-sm font-medium text-[var(--text)]">{c.fieldName}</span>
              <input
                type="text"
                name="name"
                required
                class="rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[color:var(--border-strong)]"
              />
            </label>

            <div class="grid gap-5 sm:grid-cols-2">
              <label class="grid gap-2">
                <span class="text-sm font-medium text-[var(--text)]">{c.fieldEmail}</span>
                <input
                  type="email"
                  name="email"
                  required
                  class="rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[color:var(--border-strong)]"
                />
              </label>
              <label class="grid gap-2">
                <span class="text-sm font-medium text-[var(--text)]">{c.fieldPhone}</span>
                <input
                  type="tel"
                  name="phone"
                  class="rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[color:var(--border-strong)]"
                />
              </label>
            </div>

            <label class="grid gap-2">
              <span class="text-sm font-medium text-[var(--text)]">{c.fieldType}</span>
              <select
                name="project_type"
                class="rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-sm text-[var(--text)] outline-none transition focus:border-[color:var(--border-strong)]"
              >
                {c.types.map((ty) => <option value={ty}>{ty}</option>)}
              </select>
            </label>

            <label class="grid gap-2">
              <span class="text-sm font-medium text-[var(--text)]">{c.fieldMessage}</span>
              <textarea
                name="message"
                rows="4"
                required
                class="resize-none rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--muted)] focus:border-[color:var(--border-strong)]"
              ></textarea>
            </label>

            <button
              id="contact-submit"
              type="submit"
              class="inline-flex items-center justify-center rounded-xl bg-[var(--brand)] px-6 py-4 text-sm font-bold text-white transition hover:bg-[var(--brand-strong)] disabled:opacity-60"
            >
              {c.submit}
            </button>

            <p id="contact-status" class="hidden text-sm" role="status"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline set:html={contactScript}></script>
