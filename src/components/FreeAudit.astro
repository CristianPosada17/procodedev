---
// Oferta gancho de captación: "Auditoría web gratis".
// Baja la fricción del primer contacto (más fácil decir sí a algo gratis).
// Usa Web3Forms (misma clave pública del formulario de contacto).
const WEB3FORMS_ACCESS_KEY = "9659bbb8-915d-4842-8981-a261c0faf9ff";

const inputClass =
  "w-full rounded-xl border border-white/10 bg-white/[0.06] px-4 py-3 text-sm text-white placeholder:text-slate-500 outline-none transition focus:border-blue-300/50 focus:bg-white/[0.09]";
---

<section id="auditoria" class="relative py-16">
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <div
      class="relative overflow-hidden rounded-[2rem] border border-blue-400/25 bg-[#061126]/80 p-8 shadow-[0_0_90px_rgba(37,99,235,0.18)] backdrop-blur-xl lg:p-12"
    >
      <div
        class="absolute inset-0 bg-gradient-to-br from-blue-500/16 via-transparent to-cyan-400/10"
      >
      </div>
      <div
        class="absolute right-0 top-0 h-72 w-72 translate-x-1/3 -translate-y-1/3 rounded-full bg-blue-500/20 blur-[100px]"
      >
      </div>

      <div class="relative grid gap-10 lg:grid-cols-[1fr_0.9fr] lg:items-center">
        <div class="reveal reveal-left">
          <div
            class="mb-5 inline-flex items-center gap-2 rounded-full border border-blue-300/30 bg-blue-500/15 px-4 py-2 text-xs font-bold uppercase tracking-[0.22em] text-blue-200"
          >
            🎁 Gratis · sin compromiso
          </div>

          <h2
            class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl"
          >
            ¿Ya tienes web? Te decimos
            <span
              class="bg-gradient-to-r from-blue-400 via-blue-500 to-cyan-300 bg-clip-text text-transparent"
            >
              3 cosas
            </span>
            para que venda más.
          </h2>

          <p class="mt-5 max-w-xl text-base leading-8 text-slate-300 sm:text-lg">
            Revisamos tu sitio actual sin costo y te enviamos 3 mejoras
            concretas de diseño, velocidad o conversión que puedes aplicar de
            inmediato. Y si aún no tienes web, te decimos por dónde empezar.
          </p>

          <ul class="mt-6 grid gap-3 text-sm text-slate-200 sm:grid-cols-3">
            <li class="flex items-center gap-2">
              <span class="text-blue-300">✓</span> Sin costo
            </li>
            <li class="flex items-center gap-2">
              <span class="text-blue-300">✓</span> Sin compromiso
            </li>
            <li class="flex items-center gap-2">
              <span class="text-blue-300">✓</span> En 24–48 h
            </li>
          </ul>
        </div>

        <div
          class="reveal reveal-right rounded-3xl border border-white/10 bg-white/[0.04] p-6"
          style="--reveal-delay: 120ms"
        >
          <form id="audit-form" class="grid gap-4">
            <input
              type="hidden"
              name="access_key"
              value={WEB3FORMS_ACCESS_KEY}
            />
            <input
              type="hidden"
              name="subject"
              value="Solicitud de auditoría web gratis"
            />
            <input
              type="hidden"
              name="from_name"
              value="Auditoría gratis — ProCodeDev.com"
            />
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display:none"
              tabindex="-1"
              autocomplete="off"
            />

            <input
              type="text"
              name="name"
              required
              placeholder="Tu nombre"
              class={inputClass}
            />
            <input
              type="text"
              name="website"
              placeholder="Tu sitio web actual (o escribe: aún no tengo)"
              class={inputClass}
            />
            <input
              type="text"
              name="contact"
              required
              placeholder="WhatsApp o correo para enviarte la auditoría"
              class={inputClass}
            />

            <button
              type="submit"
              id="audit-submit"
              class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-6 py-4 text-sm font-bold text-white shadow-[0_0_45px_rgba(37,99,235,0.45)] transition hover:bg-blue-500 disabled:cursor-not-allowed disabled:opacity-60"
            >
              Quiero mi auditoría gratis
              <span class="ml-2">→</span>
            </button>

            <p
              id="audit-status"
              class="hidden rounded-xl px-4 py-3 text-sm font-semibold"
              role="status"
              aria-live="polite"
            >
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("audit-form") as HTMLFormElement | null;
  const status = document.getElementById("audit-status");
  const submitBtn = document.getElementById(
    "audit-submit"
  ) as HTMLButtonElement | null;

  const showStatus = (message: string, ok: boolean) => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove(
      "hidden",
      "bg-emerald-500/15",
      "text-emerald-300",
      "bg-red-500/15",
      "text-red-300"
    );
    status.classList.add(
      ok ? "bg-emerald-500/15" : "bg-red-500/15",
      ok ? "text-emerald-300" : "text-red-300"
    );
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";
    }

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await res.json();

      if (result.success) {
        showStatus(
          "¡Listo! Recibimos tu solicitud. Te enviamos tu auditoría en 24–48 horas.",
          true
        );
        // Registrar el lead en Meta Pixel y Google Analytics (si están activos)
        (window as any).fbq?.("track", "Lead");
        (window as any).gtag?.("event", "generate_lead", { origen: "auditoria_gratis" });
        form.reset();
      } else {
        showStatus(
          "Hubo un problema. Escríbenos por WhatsApp y lo resolvemos.",
          false
        );
      }
    } catch {
      showStatus(
        "No se pudo enviar. Revisa tu conexión o escríbenos por WhatsApp.",
        false
      );
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML =
          'Quiero mi auditoría gratis <span class="ml-2">→</span>';
      }
    }
  });
</script>
