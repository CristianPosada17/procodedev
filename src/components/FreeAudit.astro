---
import { translations, CONTACT, type Lang } from "../i18n/ui";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const fa = t.freeAudit;

const auditScript = `
  (function(){
    var form = document.getElementById('audit-form');
    var status = document.getElementById('audit-status');
    var btn = document.getElementById('audit-submit');
    if(!form) return;
    var SENDING = ${JSON.stringify(fa.sending)};
    var OK = ${JSON.stringify(fa.success)};
    var FAIL = ${JSON.stringify(fa.error)};
    var LABEL = ${JSON.stringify(fa.cta)};
    function show(msg, ok){
      if(!status) return;
      status.textContent = msg;
      status.classList.remove('hidden');
      status.style.color = ok ? '#4ade80' : '#f87171';
    }
    form.addEventListener('submit', async function(e){
      e.preventDefault();
      if(btn){ btn.disabled = true; btn.textContent = SENDING; }
      try {
        var res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form)))
        });
        var result = await res.json();
        if(result.success){
          show(OK, true);
          form.reset();
          if(window.fbq) window.fbq('track','Lead');
          if(window.gtag) window.gtag('event','generate_lead',{ origen:'auditoria_gratis' });
        } else { show(FAIL, false); }
      } catch(err){ show(FAIL, false); }
      finally { if(btn){ btn.disabled = false; btn.textContent = LABEL; } }
    });
  })();
`;
---

<section id="auditoria" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div
      class="reveal grid gap-8 rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/70 p-8 backdrop-blur-xl lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:p-12"
    >
      <div>
        <span class="inline-flex rounded-full border border-[color:var(--border-strong)] bg-[var(--brand)]/10 px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-[var(--accent)]">
          {fa.badge}
        </span>
        <h2 class="mt-5 text-3xl font-bold leading-[1.1] tracking-tight text-[var(--text)] sm:text-4xl">
          {fa.titleA} <span class="grad-text">{fa.titleHighlight}</span> {fa.titleB}
        </h2>
        <p class="mt-5 text-base leading-8 text-[var(--muted)]">{fa.subtitle}</p>
        <div class="mt-6 flex flex-wrap gap-4 text-sm text-[var(--text)]/90">
          {fa.bullets.map((b) => <span>{b}</span>)}
        </div>
      </div>

      <form
        id="audit-form"
        class="grid gap-4 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--bg-2)] p-6"
      >
        <input type="hidden" name="access_key" value={CONTACT.web3formsKey} />
        <input type="hidden" name="subject" value="Solicitud de auditoría gratuita — procodedev.com" />
        <input type="hidden" name="from_name" value="ProCode Dev — Auditoría" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

        <label class="grid gap-2">
          <span class="text-sm font-medium text-[var(--text)]">{fa.fieldName}</span>
          <input
            type="text"
            name="name"
            required
            class="rounded-xl border border-[color:var(--border)] bg-[var(--surface)] px-4 py-3 text-sm text-[var(--text)] outline-none transition focus:border-[color:var(--border-strong)]"
          />
        </label>
        <label class="grid gap-2">
          <span class="text-sm font-medium text-[var(--text)]">{fa.fieldWhatsapp}</span>
          <input
            type="tel"
            name="whatsapp"
            required
            class="rounded-xl border border-[color:var(--border)] bg-[var(--surface)] px-4 py-3 text-sm text-[var(--text)] outline-none transition focus:border-[color:var(--border-strong)]"
          />
        </label>
        <label class="grid gap-2">
          <span class="text-sm font-medium text-[var(--text)]">{fa.fieldSite}</span>
          <input
            type="text"
            name="website"
            class="rounded-xl border border-[color:var(--border)] bg-[var(--surface)] px-4 py-3 text-sm text-[var(--text)] outline-none transition focus:border-[color:var(--border-strong)]"
          />
        </label>
        <button
          id="audit-submit"
          type="submit"
          class="inline-flex items-center justify-center rounded-xl bg-[var(--brand)] px-6 py-4 text-sm font-bold text-white transition hover:bg-[var(--brand-strong)] disabled:opacity-60"
        >
          {fa.cta}
        </button>
        <p id="audit-status" class="hidden text-sm" role="status"></p>
      </form>
    </div>
  </div>
</section>

<script is:inline set:html={auditScript}></script>
