---
import { translations, PAGES, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const pa = t.priceAnchor;
---

{/* Hallazgo #10: el home nunca mencionaba un precio, aunque /precios es la
    página más fuerte del sitio. Sin ancla, el visitante asume «caro» y se va
    antes de llegar a la tabla. */}
<section id="inversion" class="relative py-10 lg:py-14">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <div
      class="band-brand reveal grid gap-10 rounded-[2rem] p-8 shadow-[0_60px_140px_-60px_rgba(24,64,116,0.9)] sm:p-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:p-16"
    >
      <div>
        <span class="eyebrow">{pa.eyebrow}</span>
        <h2 class="mt-5 text-balance text-3xl font-bold leading-[1.05] tracking-[-0.03em] text-white sm:text-4xl lg:text-5xl">
          {pa.title}
        </h2>
        <p class="mt-5 max-w-xl text-base leading-8 text-white/75 sm:text-lg">
          {pa.subtitle}
        </p>
      </div>

      <div
        class="relative rounded-[1.6rem] bg-white p-8 text-center text-slate-900 shadow-[0_40px_80px_-30px_rgba(0,0,0,0.55)] lt-float"
      >
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-500">
          {pa.fromLabel}
        </p>
        <p class="mt-2 flex items-end justify-center gap-1.5">
          <span class="font-head text-6xl font-bold tracking-[-0.04em] text-[#184074] sm:text-7xl">
            ${pa.amount}
          </span>
          <span class="mb-2 text-sm font-semibold text-slate-500">{pa.currency}</span>
        </p>
        <p class="mt-3 text-xs leading-5 text-slate-500">{pa.amountNote}</p>
        <a
          href={PAGES.pricing[lang]}
          class="mt-7 inline-flex w-full items-center justify-center rounded-xl bg-[#184074] px-6 py-4 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#1f4f86]"
        >
          {pa.cta} <Icon name="arrow-right" class="ml-2 h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</section>
