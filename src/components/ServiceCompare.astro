---
/*
  «¿Por dónde empiezo?» — tres caminos, no tres paquetes.

  Es el bloque que resuelve la única duda real de quien llega a /servicios
  con dos opciones delante. Además es contenido propio y útil, que es lo
  que un buscador premia frente a una rejilla de tarjetas genéricas.
*/
import { translations, PAGES, type Lang } from "../i18n/ui";
import { servicesHub } from "../i18n/services";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const c = servicesHub[lang].compare;
---

<section id="por-donde-empiezo" class="relative py-12 lg:py-20">
  <div class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]">
    <SectionHeading eyebrow={c.eyebrow} align="center" max="max-w-3xl">
      <Fragment slot="title">
        {c.titleA}{" "}<span class="grad-text">{c.titleHighlight}</span>
      </Fragment>
      <Fragment slot="subtitle">{c.subtitle}</Fragment>
    </SectionHeading>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {
        c.columns.map((col, i) => (
          <article
            class:list={[
              "reveal relative flex flex-col rounded-[var(--radius)] border bg-[var(--surface)]/60 p-7 backdrop-blur-xl transition duration-300 hover:-translate-y-1",
              col.highlighted
                ? "border-[color:var(--border-strong)] shadow-[0_30px_90px_-50px_rgba(37,99,235,0.8)]"
                : "border-[color:var(--border)] hover:border-[color:var(--border-strong)]",
            ]}
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--accent)]">
              {col.badge}
            </span>
            <h3 class="mt-3 text-xl font-bold leading-snug text-[var(--text)]">
              {col.title}
            </h3>
            <p class="mt-4 flex-1 text-sm leading-7 text-[var(--muted)]">
              {col.body}
            </p>
            <p class="mt-5 rounded-xl border border-[color:var(--border)] bg-[var(--brand)]/[0.07] px-4 py-3 text-[13px] leading-6 text-[var(--text)]/90">
              {col.forWho}
            </p>
            <p class="mt-4 font-mono text-xs uppercase tracking-[0.12em] text-[var(--muted)]">
              {col.price}
            </p>
            <a
              href={PAGES[col.href][lang]}
              data-cta={`camino-${col.href}`}
              class:list={[
                "mt-5 inline-flex items-center justify-between gap-2 rounded-xl px-5 py-3 text-sm font-bold transition",
                col.highlighted
                  ? "bg-[var(--brand)] text-white hover:bg-[var(--brand-strong)]"
                  : "border border-[color:var(--border-strong)] bg-white/[0.04] text-[var(--text)] hover:bg-[var(--brand)]/12",
              ]}
            >
              {col.cta}
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </article>
        ))
      }
    </div>

    <p class="reveal mx-auto mt-8 max-w-3xl text-center text-sm leading-7 text-[var(--muted)]">
      {c.note}
    </p>
    <div class="reveal mt-6 text-center">
      <a
        href={PAGES.contact[lang]}
        data-cta="comparativa-agendar"
        class="inline-flex items-center gap-2 rounded-xl bg-[var(--brand)] px-6 py-3.5 text-sm font-bold text-white shadow-[0_0_40px_rgba(37,99,235,0.3)] transition hover:-translate-y-0.5 hover:bg-[var(--brand-strong)]"
      >
        {t.common.ctaPrimary}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
