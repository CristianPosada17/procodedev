---
import { translations, conversionHref, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";
import OfferNote from "./OfferNote.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const h = t.hero;
---

{/*
  Hero del home (septiembre de 2026, 30): todo centrado sobre un fondo
  limpio de marca —degradados azul/cyan muy suaves y una rejilla que se
  desvanece— en lugar de la fotografía del lobby. El titular es el
  elemento más grande de la página y el primero que se lee; los dos CTAs
  van justo debajo del subtítulo.
  Sin fotografía, el LCP es el propio H1 (texto), que pinta al instante.
*/}
<section
  id="inicio"
  class="hero-clean relative isolate overflow-hidden"
>
  <div class="hero-clean-grid tech-grid pointer-events-none absolute inset-0 -z-10 opacity-80" aria-hidden="true"></div>

  <div
    class="relative mx-auto flex w-full max-w-[1480px] flex-col items-center px-4 pb-20 pt-16 text-center sm:px-6 sm:pt-20 lg:px-10 lg:pb-28 lg:pt-28 2xl:max-w-[1600px]"
  >
    {/* Above-the-fold: sin `.reveal`. Nada de lo que decide la conversión
        en el primer scroll debe esperar a que corra JS (hallazgo #14). */}
    <span
      class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border-strong)] bg-[var(--surface)]/70 px-4 py-1.5 backdrop-blur"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
      <span class="eyebrow">{h.eyebrow.replace(/^\/\/\s*/, "")}</span>
    </span>

    <h1
      class="mt-7 max-w-[18ch] text-balance text-[2.9rem] font-bold leading-[1.02] tracking-[-0.035em] text-[var(--text)] sm:text-[4.2rem] lg:max-w-[20ch] lg:text-[5.4rem] xl:text-[6.2rem]"
    >
      {h.titleA}{" "}
      <span class="grad-text">{h.titleHighlight}</span>{h.titleB && " " + h.titleB}
    </h1>

    <span class="hero-rule mt-8"></span>

    <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--muted)] sm:text-xl">
      {h.subtitle}
    </p>

    {/* Las dos opciones de conversión del sitio, con destino en esta
        misma página: agenda (#agendar) y formulario (#contacto). */}
    <div class="mt-10 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row sm:gap-4">
      <a
        href={conversionHref("home", lang, "book")}
        data-cta="hero-primario"
        class="btn-cta px-8 text-base"
      >
        {t.common.ctaPrimary}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <a
        href={conversionHref("home", lang, "info")}
        data-cta="hero-secundario"
        class="btn-secondary px-8 text-base backdrop-blur-sm"
      >
        {t.contact.ctaInfo}
      </a>
    </div>

    <OfferNote lang={lang} align="center" />

    <ul
      class="mt-10 flex flex-col items-center gap-3 text-sm text-[var(--muted)] sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-8"
    >
      {
        h.badges.map((b, i) => (
          <li class="flex items-center gap-2.5 whitespace-nowrap">
            <span class="flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-[var(--brand)]/12 text-[var(--accent)] ring-1 ring-[color:var(--border-strong)]">
              <Icon name={(["receipt", "lock", "globe"] as const)[i] ?? "check"} class="h-4 w-4" />
            </span>
            {b}
          </li>
        ))
      }
    </ul>
  </div>
</section>
