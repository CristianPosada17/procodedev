---
import { translations, PAGES, type Lang } from "../i18n/ui";
import Icon from "./Icon.astro";
import OfferNote from "./OfferNote.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const h = t.hero;
---

{/*
  La fotografía del lobby ES el fondo de la sección: ocupa el 100% del ancho
  y del alto. Encima va un panel navy sólido pegado al borde izquierdo que se
  disuelve hacia la derecha, así el texto se lee sobre imagen y la recepción
  con el logo queda limpia. No hay columna derecha ni mockup: el visual del
  hero es la foto.
*/}
<section
  id="inicio"
  class="hero-home relative isolate overflow-hidden lg:flex lg:min-h-[38rem] lg:items-center"
>
  {/* La posición y el recorte de la foto van en utilidades de Tailwind, no
     en clases propias: si el CSS global llega en caché vieja, el hero se ve
     sin velo pero nunca se descuadra. */}
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <picture>
      {/* La foto es el LCP del home. Antes se servia un solo archivo de
          1536 px y 145 KB a todo el mundo: en un movil de 412 px eso era
          122 KB tirados a la basura. Ahora el navegador elige ancho y
          formato (AVIF si puede, WebP si no). */}
      <source
        type="image/avif"
        sizes="100vw"
        srcset="/images/hero-lobby-640.avif 640w, /images/hero-lobby-960.avif 960w, /images/hero-lobby-1280.avif 1280w, /images/hero-lobby-1536.avif 1536w"
      />
      <source
        type="image/webp"
        sizes="100vw"
        srcset="/images/hero-lobby-640.webp 640w, /images/hero-lobby-960.webp 960w, /images/hero-lobby-1280.webp 1280w, /images/hero-lobby-1536.webp 1536w"
      />
      <img
        src="/images/hero-lobby-1280.webp"
        alt="Recepción de ProCode Dev con el logo iluminado y pantallas de proyectos"
        width="1536"
        height="864"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover object-[72%_34%] lg:object-[74%_center]"
      />
    </picture>
    <div class="hero-veil absolute inset-0"></div>
    <div class="hero-mesh tech-grid absolute inset-0"></div>
  </div>

  <div
    class="mx-auto w-full max-w-[1480px] px-4 py-14 sm:px-6 lg:px-10 lg:py-20 2xl:max-w-[1600px]"
  >
    {/* Above-the-fold: sin `.reveal`. Nada de lo que decide la conversión
        en el primer scroll debe esperar a que corra JS (hallazgo #14). */}
    <div class="max-w-xl lg:max-w-[40rem] xl:max-w-[50rem]">
      <span class="eyebrow">{h.eyebrow}</span>

      <h1
        class="mt-5 text-balance text-[2.6rem] font-bold leading-[1.04] tracking-tight text-[var(--text)] drop-shadow-[0_2px_24px_var(--veil-ink)] sm:text-[3.45rem] lg:text-[3.5rem] xl:text-[4.4rem]"
      >
        {h.titleA}{" "}
        <span class="grad-text">{h.titleHighlight}</span>{h.titleB && " " + h.titleB}
      </h1>

      <span class="hero-rule mt-7"></span>

      <p class="mt-6 max-w-xl text-base leading-8 text-[var(--text)]/80 sm:text-lg lg:max-w-[34rem]">
        {h.subtitle}
      </p>

      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <a
          href={PAGES.contact[lang]}
          data-cta="hero-primario"
          class="inline-flex items-center justify-center rounded-xl bg-[var(--brand)] px-6 py-4 text-sm font-bold text-white shadow-[0_0_40px_var(--halo-brand)] transition hover:-translate-y-0.5 hover:bg-[var(--brand-strong)]"
        >
          {t.common.ctaPrimary}
          <Icon name="arrow-right" class="ml-2 h-4 w-4" />
        </a>
        <a
          href={PAGES.services[lang]}
          data-cta="hero-secundario"
          class="inline-flex items-center justify-center rounded-xl border border-[color:var(--border-strong)] bg-[var(--tint)] px-6 py-4 text-sm font-bold text-[var(--text)] backdrop-blur-sm transition hover:-translate-y-0.5 hover:bg-[var(--brand)]/15"
        >
          {t.common.viewServices}
        </a>
      </div>

      <OfferNote lang={lang} />

    </div>

    {/* Los tres sellos viven fuera de la columna de texto: dentro no cabían
        los tres en una línea y quedaban dos arriba y uno abajo. */}
    <div
      class="mt-9 flex flex-col gap-4 text-sm text-[var(--muted)] sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6 lg:max-w-4xl lg:flex-nowrap lg:gap-x-8"
    >
      {
        h.badges.map((b, i) => (
          <div class="flex items-center gap-3 whitespace-nowrap">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-[var(--brand)]/12 text-[var(--accent)] ring-1 ring-[color:var(--border-strong)]">
              <Icon
                name={(["receipt", "lock", "globe"] as const)[i] ?? "check"}
                class="h-4.5 w-4.5"
              />
            </span>
            {b}
          </div>
        ))
      }
    </div>
  </div>
</section>
