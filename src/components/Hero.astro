---
import { translations, PAGES, CONTACT, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const h = t.hero;
const waMsg = encodeURIComponent(
  lang === "es"
    ? "Hola ProCode, quiero una propuesta para mi negocio."
    : "Hi ProCode, I'd like a proposal for my business.",
);
---

<section id="inicio" class="relative overflow-hidden pt-10 pb-16 lg:pt-16 lg:pb-24">
  <div
    class="mx-auto grid w-full max-w-[1480px] items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_0.92fr] lg:px-10 2xl:max-w-[1600px]"
  >
    <div>
      {/* Above-the-fold: sin `.reveal`. Nada de lo que decide la conversión
          en el primer scroll debe esperar a que corra JS (hallazgo #14). */}
      <div>
        <span class="eyebrow">{h.eyebrow}</span>
      </div>

      <h1
        class="mt-5 max-w-4xl text-4xl font-bold leading-[1.05] tracking-tight text-[var(--text)] sm:text-5xl lg:text-6xl xl:text-7xl"
      >
        {h.titleA}{" "}
        <span class="grad-text">{h.titleHighlight}</span>{" "}
        {h.titleB}
      </h1>

      <p
        class="mt-6 max-w-2xl text-base leading-8 text-[var(--muted)] sm:text-lg"
      >
        {h.subtitle}
      </p>

      <div
        class="mt-9 flex flex-col gap-4 sm:flex-row"
      >
        <a
          href={PAGES.contact[lang]}
          class="inline-flex items-center justify-center rounded-xl bg-[var(--brand)] px-6 py-4 text-sm font-bold text-white shadow-[0_0_40px_rgba(37,99,235,0.4)] transition hover:-translate-y-0.5 hover:bg-[var(--brand-strong)]"
        >
          {t.common.ctaPrimary}
          <span class="ml-2">→</span>
        </a>
        <a
          href={PAGES.services[lang]}
          class="inline-flex items-center justify-center rounded-xl border border-[color:var(--border)] bg-white/5 px-6 py-4 text-sm font-bold text-[var(--text)] transition hover:-translate-y-0.5 hover:border-[color:var(--border-strong)] hover:bg-[var(--brand)]/10"
        >
          {t.common.viewServices}
        </a>
      </div>

      <div
        class="mt-10 grid gap-4 text-sm text-[var(--muted)] sm:grid-cols-3"
      >
        {
          h.badges.map((b, i) => (
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[var(--brand)]/10 text-[var(--accent)]">
                {["✦", "↗", "✓"][i]}
              </span>
              {b}
            </div>
          ))
        }
      </div>
    </div>

    <div class="reveal reveal-right relative" style="--reveal-delay: 200ms">
      <div class="absolute -inset-6 rounded-[2rem] bg-[var(--brand)]/10 blur-3xl"></div>

      <div
        class="relative rounded-[var(--radius-lg)] border border-[color:var(--border-strong)] bg-[var(--surface)]/80 p-4 shadow-[0_0_80px_rgba(37,99,235,0.18)] backdrop-blur-xl"
      >
        <div class="rounded-[1.5rem] border border-[color:var(--border)] bg-[var(--bg-2)] p-4">
          <div class="mb-4 flex items-center justify-between border-b border-[color:var(--border)] pb-4">
            <div class="flex gap-2">
              <span class="h-3 w-3 rounded-full bg-red-400/80"></span>
              <span class="h-3 w-3 rounded-full bg-yellow-400/80"></span>
              <span class="h-3 w-3 rounded-full bg-green-400/80"></span>
            </div>
            <div class="font-mono text-[10px] tracking-widest text-[var(--muted)]">
              procodedev.com
            </div>
          </div>

          <div class="grid gap-4 lg:grid-cols-[1.2fr_0.8fr]">
            <div
              class="rounded-2xl border border-[color:var(--border-strong)] bg-gradient-to-br from-[var(--brand)]/20 to-transparent p-6"
            >
              <span class="eyebrow">{h.cardLabel}</span>
              <h3 class="mt-4 text-2xl font-bold text-[var(--text)]">
                {h.cardTitle}
              </h3>
              <p class="mt-3 text-sm leading-6 text-[var(--muted)]">
                {h.cardText}
              </p>
              <a
                href={`https://wa.me/${CONTACT.whatsapp}?text=${waMsg}`}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex rounded-lg bg-[var(--brand)] px-4 py-3 text-sm font-bold text-white transition hover:bg-[var(--brand-strong)]"
              >
                {h.cardCta}
              </a>
            </div>

            {/* Antes aquí había dos cifras inventadas («+248% leads», «9.8%
                conversión estimada»). Sin cliente al que atribuirlas, restaban
                credibilidad en vez de sumarla (hallazgo #8). */}
            <div class="rounded-2xl border border-[color:var(--border)] bg-white/[0.04] p-4">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--accent)]">
                {h.panelTitle}
              </p>
              <ul class="mt-4 grid gap-3">
                {
                  h.panelItems.map((item) => (
                    <li class="flex items-start gap-2.5 text-xs leading-5 text-[var(--muted)]">
                      <span class="mt-0.5 flex h-4 w-4 flex-none items-center justify-center rounded bg-[var(--brand)]/15 text-[9px] text-[var(--accent)]">
                        ✓
                      </span>
                      {item}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {
              h.chips.map((c) => (
                <div class="rounded-xl border border-[color:var(--border)] bg-white/[0.03] p-4 font-mono text-xs text-[var(--muted)]">
                  {c}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
