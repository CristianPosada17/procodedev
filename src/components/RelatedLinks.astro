---
/*
  Bloque de enlazado interno (septiembre de 2026).

  Sale de la matriz SEO del keyword research: cada página comercial tiene
  una lista corta de URLs a las que debe enlazar para repartir autoridad y
  dejar clara la jerarquía (hub → hija → subservicio → precios). Antes esos
  enlaces solo existían en el menú, que Google trata como plantilla.
*/
import Icon from "./Icon.astro";

export interface RelatedBlock {
  eyebrow: string;
  title: string;
  body: string;
  items: readonly { label: string; href: string; hint: string }[];
}

interface Props {
  data: RelatedBlock;
}
const { data } = Astro.props as Props;
---

<section class="relative py-12 lg:py-20">
  <div
    class="mx-auto w-full max-w-[1480px] px-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <div
      class="reveal rounded-3xl border border-[color:var(--border)] bg-[var(--surface)] p-8 lg:p-12"
    >
      <p class="eyebrow text-[var(--accent)]">{data.eyebrow}</p>
      <h2
        class="mt-3 text-2xl font-extrabold tracking-tight text-[var(--text)] sm:text-3xl"
      >
        {data.title}
      </h2>
      <p class="mt-3 max-w-2xl text-base leading-8 text-[var(--muted)]">
        {data.body}
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          data.items.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex h-full flex-col gap-2 rounded-2xl border border-[color:var(--border)] bg-[var(--bg-2)] p-5 transition hover:border-[color:var(--border-strong)]"
              >
                <span class="flex items-center gap-2 text-sm font-bold text-[var(--text)]">
                  {item.label}
                  <Icon
                    name="arrow-up-right"
                    class="h-4 w-4 shrink-0 text-[var(--accent)]"
                  />
                </span>
                <span class="text-sm leading-6 text-[var(--muted)]">
                  {item.hint}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
