---
import {
  translations,
  PAGES,
  SEGMENT_KEYS,
  getAltPath,
  type Lang,
  type PageKey,
} from "../i18n/ui";
import { segments } from "../i18n/segments";
import Icon from "./Icon.astro";

interface Props {
  lang?: Lang;
  page?: PageKey;
}
const { lang = "es", page = "home" } = Astro.props as Props;
const t = translations[lang];

// El nicho creció de una landing a un hub con seis páginas de oficio. Meterlas
// todas en la barra dejaría trece enlaces en una sola línea, así que viven en
// un desplegable colgando de «Firmas fiscales» — que sigue siendo un enlace
// real al hub, no solo un disparador de menú.
const segmentItems = SEGMENT_KEYS.map((key) => ({
  key,
  href: PAGES[key][lang],
  label: segments[lang][key].navLabel,
  hint: segments[lang][key].navHint,
  icon: segments[lang][key].icon,
}));

const segmentKeys = SEGMENT_KEYS as readonly string[];
const sectorsActive = page === "sectors" || segmentKeys.includes(page);

const navItems = [
  { label: t.nav.home, href: PAGES.home[lang], key: "home" },
  { label: t.nav.services, href: PAGES.services[lang], key: "services" },
  { label: t.nav.portfolio, href: PAGES.portfolio[lang], key: "portfolio" },
  { label: t.nav.pricing, href: PAGES.pricing[lang], key: "pricing" },
  { label: t.nav.blog, href: "/blog", key: "blog" },
  { label: t.nav.contact, href: PAGES.contact[lang], key: "contact" },
];

const altHref = getAltPath(page, lang);
const otherLang = lang === "es" ? "EN" : "ES";
---

<header
  class="sticky top-0 z-50 border-b border-[color:var(--border)] bg-[var(--bg)]/80 backdrop-blur-xl"
>
  <div
    class="mx-auto flex w-full max-w-[1480px] items-center justify-between px-4 py-4 sm:px-6 lg:px-10 2xl:max-w-[1600px]"
  >
    <a
      href={PAGES.home[lang]}
      class="flex items-center gap-3"
      aria-label="ProCode Dev"
    >
      <div class="flex h-12 w-12 items-center justify-center">
        <img
          src="/Logo.webp"
          alt="Logotipo de ProCode Dev"
          width="48"
          height="48"
          class="h-full w-full object-contain"
        />
      </div>
      <span class="text-lg font-bold tracking-tight text-[var(--text)]">
        ProCode <span class="text-[var(--accent)]">Dev</span>
      </span>
    </a>

    <nav
      class="hidden items-center gap-7 lg:flex"
      aria-label="Navegación principal"
    >
      <a
        href={navItems[0].href}
        aria-current={navItems[0].key === page ? "page" : undefined}
        class:list={[
          "text-sm font-medium transition hover:text-[var(--accent)]",
          navItems[0].key === page
            ? "text-[var(--accent)]"
            : "text-[var(--muted)]",
        ]}
      >
        {navItems[0].label}
      </a>

      {/* ── Desplegable del nicho ── */}
      <div class="nav-dropdown relative">
        <a
          href={PAGES.sectors[lang]}
          aria-haspopup="true"
          aria-expanded="false"
          class:list={[
            "nav-dropdown-trigger inline-flex items-center gap-1.5 text-sm font-medium transition hover:text-[var(--accent)]",
            sectorsActive ? "text-[var(--accent)]" : "text-[var(--muted)]",
          ]}
        >
          {t.nav.sectors}
          <Icon name="arrow-right" class="h-3.5 w-3.5 rotate-90" />
        </a>

        <div
          class="nav-dropdown-panel invisible absolute left-1/2 top-full z-50 w-[min(92vw,560px)] -translate-x-1/2 pt-4 opacity-0 transition"
        >
          <div
            class="rounded-[var(--radius)] border border-[color:var(--border-strong)] bg-[var(--surface)]/95 p-3 shadow-[0_30px_80px_-30px_rgba(0,0,0,0.8)] backdrop-blur-xl"
          >
            <p
              class="px-3 pb-2 pt-1 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]"
            >
              {t.nav.sectorsMenuNote}
            </p>
            <div class="grid gap-1 sm:grid-cols-2">
              {
                segmentItems.map((item) => (
                  <a
                    href={item.href}
                    class:list={[
                      "flex items-start gap-3 rounded-xl px-3 py-2.5 transition hover:bg-white/[0.06]",
                      item.key === page ? "bg-white/[0.06]" : "",
                    ]}
                  >
                    <span class="mt-0.5 flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-[var(--brand)]/10 text-[var(--accent)]">
                      <Icon name={item.icon as any} class="h-4 w-4" />
                    </span>
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold text-[var(--text)]">
                        {item.label}
                      </span>
                      <span class="block text-xs leading-5 text-[var(--muted)]">
                        {item.hint}
                      </span>
                    </span>
                  </a>
                ))
              }
            </div>
            <a
              href={PAGES.sectors[lang]}
              class="mt-2 flex items-center justify-between rounded-xl border border-[color:var(--border)] px-3 py-2.5 text-sm font-semibold text-[var(--accent)] transition hover:bg-[var(--brand)]/10"
            >
              {t.nav.sectorsOverview}
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>

      {
        navItems.slice(1).map((item) => (
          <a
            href={item.href}
            aria-current={item.key === page ? "page" : undefined}
            class:list={[
              "text-sm font-medium transition hover:text-[var(--accent)]",
              item.key === page
                ? "text-[var(--accent)]"
                : "text-[var(--muted)]",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a
        href={altHref}
        class="inline-flex items-center gap-1.5 rounded-lg border border-[color:var(--border)] bg-white/[0.03] px-3 py-2 font-mono text-xs font-medium text-[var(--muted)] transition hover:border-[color:var(--border-strong)] hover:text-[var(--accent)]"
        aria-label="Change language"
      >
        <Icon name="globe" class="h-3.5 w-3.5" />
        {otherLang}
      </a>
      <a
        href={PAGES.contact[lang]}
        data-cta="header-agendar"
        class="inline-flex rounded-xl bg-[var(--brand)] px-5 py-3 text-sm font-bold text-white shadow-[0_0_35px_rgba(37,99,235,0.28)] transition hover:-translate-y-0.5 hover:bg-[var(--brand-strong)]"
      >
        {t.nav.cta}
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[color:var(--border)] bg-white/5 text-[var(--text)] lg:hidden"
    >
      <Icon name="menu" id="menu-icon-open" class="h-5 w-5" />
      <Icon name="close" id="menu-icon-close" class="hidden h-5 w-5" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden max-h-[calc(100vh-5rem)] overflow-y-auto border-t border-[color:var(--border)] bg-[var(--bg)]/95 backdrop-blur-xl lg:hidden"
  >
    <nav
      class="mx-auto flex w-full max-w-[1480px] flex-col gap-1 px-4 py-4 sm:px-6"
      aria-label="Navegación móvil"
    >
      <a
        href={navItems[0].href}
        class="rounded-lg px-2 py-3 text-sm font-medium text-[var(--muted)] transition hover:bg-white/5 hover:text-[var(--accent)]"
      >
        {navItems[0].label}
      </a>

      {/* En móvil el desplegable es un <details>: no necesita JS y no puede
          quedarse abierto por accidente al navegar. */}
      <details class="group rounded-lg" open={sectorsActive}>
        <summary
          class="flex cursor-pointer items-center justify-between rounded-lg px-2 py-3 text-sm font-medium text-[var(--muted)] marker:content-[''] hover:text-[var(--accent)]"
        >
          {t.nav.sectors}
          <Icon
            name="arrow-right"
            class="h-4 w-4 rotate-90 transition group-open:-rotate-90"
          />
        </summary>
        <div class="mb-2 ml-2 grid gap-0.5 border-l border-[color:var(--border)] pl-3">
          <a
            href={PAGES.sectors[lang]}
            class="rounded-lg px-2 py-2.5 text-sm text-[var(--accent)] transition hover:bg-white/5"
          >
            {t.nav.sectorsOverview}
          </a>
          {
            segmentItems.map((item) => (
              <a
                href={item.href}
                class="rounded-lg px-2 py-2.5 text-sm text-[var(--muted)] transition hover:bg-white/5 hover:text-[var(--accent)]"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </details>

      {
        navItems.slice(1).map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-2 py-3 text-sm font-medium text-[var(--muted)] transition hover:bg-white/5 hover:text-[var(--accent)]"
          >
            {item.label}
          </a>
        ))
      }
      <div
        class="mt-2 flex items-center gap-3 border-t border-[color:var(--border)] pt-4"
      >
        <a
          href={altHref}
          class="inline-flex items-center gap-1.5 rounded-lg border border-[color:var(--border)] bg-white/[0.03] px-3 py-2.5 font-mono text-xs font-medium text-[var(--muted)]"
        >
          <Icon name="globe" class="h-3.5 w-3.5" />
          {otherLang}
        </a>
        <a
          href={PAGES.contact[lang]}
          data-cta="menu-movil-agendar"
          class="inline-flex flex-1 items-center justify-center rounded-xl bg-[var(--brand)] px-5 py-3 text-sm font-bold text-white"
        >
          {t.nav.cta}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* El desplegable se abre con hover en escritorio y con foco de teclado.
     El `pt-4` del panel mantiene el puente entre disparador y menú para que
     el puntero no lo cierre al bajar. */
  .nav-dropdown:hover .nav-dropdown-panel,
  .nav-dropdown:focus-within .nav-dropdown-panel {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  });
</script>
