---
/*
  Diálogo de confirmación de envío (septiembre de 2026).

  Por qué existe: la confirmación era una línea de texto debajo del botón.
  En un teléfono, después de enviar, esa línea suele quedar fuera de la
  pantalla, así que el visitante no sabía si había pasado algo y muchos
  reenviaban el formulario.

  Septiembre de 2026 (30): el atajo de WhatsApp salía del sitio. Ahora el
  siguiente paso es la agenda de la Revisión Express, dentro de la misma
  página cuando la tiene (#agendar) o en /contacto/ cuando no.

  Se renderiza dentro de LeadForm. Expone `window.pcdFormSuccess()`, que es
  lo que llama el script de envío cuando Hostinger Reach responde que sí.

  El marcado se monta una sola vez aunque hubiera dos formularios en la
  misma página: el script comprueba el id antes de registrarse.
*/
import Icon from "./Icon.astro";
import { formSuccess, conversionHref, type Lang, type PageKey } from "../i18n/ui";

interface Props {
  lang?: Lang;
  /** Para decidir si la agenda está en esta página o en /contacto/. */
  page: PageKey | "blog";
}
const { lang = "es", page } = Astro.props as Props;
const c = formSuccess[lang];
const bookHref = conversionHref(page, lang, "book");

const script = `
  (function(){
    var overlay = document.getElementById('pcd-success');
    if(!overlay || overlay.dataset.pcdReady === '1') return;
    overlay.dataset.pcdReady = '1';
    var card = overlay.querySelector('[data-card]');
    var closeBtn = overlay.querySelector('[data-close]');
    var bookBtn = overlay.querySelector('[data-book]');
    var lastFocus = null;

    function close(restore){
      overlay.hidden = true;
      document.documentElement.style.overflow = '';
      if(restore !== false && lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
    }

    function open(){
      lastFocus = document.activeElement;
      overlay.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      setTimeout(function(){ if(closeBtn) closeBtn.focus({ preventScroll: true }); }, 60);
    }

    window.pcdFormSuccess = open;

    overlay.addEventListener('click', function(e){ if(e.target === overlay) close(); });
    if(closeBtn) closeBtn.addEventListener('click', function(){ close(); });
    // El ancla de la agenda está debajo del diálogo: hay que cerrarlo (y
    // soltar el bloqueo de scroll) para que el salto se vea.
    if(bookBtn) bookBtn.addEventListener('click', function(){ close(false); });
    document.addEventListener('keydown', function(e){
      if(e.key === 'Escape' && !overlay.hidden) close();
    });
    // Trampa de foco mínima: con dos botones no hace falta más.
    if(card) card.addEventListener('keydown', function(e){
      if(e.key !== 'Tab') return;
      var f = card.querySelectorAll('a[href], button:not([disabled])');
      if(!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if(e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
      else if(!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
    });
  })();
`;
---

<div
  id="pcd-success"
  hidden
  class="fixed inset-0 z-[100] flex items-end justify-center bg-black/70 p-4 backdrop-blur-sm sm:items-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pcd-success-title"
  aria-label={c.ariaLabel}
>
  <div
    data-card
    class="pcd-success-card w-full max-w-md rounded-3xl border border-[color:var(--border-strong)] bg-[var(--surface)] p-7 text-center shadow-2xl sm:p-9"
  >
    <div
      class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-[color:var(--border-strong)] bg-[var(--brand)]/10"
    >
      <Icon name="check" class="h-8 w-8 text-[var(--ok)]" />
    </div>

    <h2
      id="pcd-success-title"
      class="mt-5 text-2xl font-extrabold tracking-tight text-[var(--text)]"
    >
      {c.title}
    </h2>
    <p class="mt-3 text-base leading-7 text-[var(--muted)]">{c.body}</p>

    <p
      class="mt-4 rounded-xl border border-[color:var(--border)] bg-[var(--bg-2)] px-4 py-3 text-sm font-semibold text-[var(--text)]"
    >
      {c.guarantee}
    </p>

    <p class="mt-5 text-sm text-[var(--muted)]">{c.bookHint}</p>

    <a
      href={bookHref}
      data-book
      data-cta="modal-agendar"
      class="btn-cta mt-3 w-full"
    >
      <Icon name="calendar" class="h-4 w-4" />
      {c.bookLabel}
    </a>

    <button
      type="button"
      data-close
      class="mt-3 min-h-[48px] w-full rounded-xl border border-[color:var(--border)] px-5 py-3 text-sm font-semibold text-[var(--muted)] transition hover:border-[color:var(--border-strong)] hover:text-[var(--text)]"
    >
      {c.close}
    </button>
  </div>
</div>

<style>
  .pcd-success-card {
    animation: pcd-pop 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
  }
  @keyframes pcd-pop {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pcd-success-card {
      animation: none;
    }
  }
</style>

<script is:inline set:html={script} />
