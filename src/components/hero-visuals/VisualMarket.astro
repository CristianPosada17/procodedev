---
/*
  Visual del hero de una página de estado: el estado y sus ciudades (las
  mismas de `cities` en markets.ts, con su nota), unidas como una ruta. La
  sigla del estado va de fondo en grande: Texas no se parece a Florida.
*/
import { translations, type Lang } from "../../i18n/ui";
import type { Market } from "../../i18n/markets";
import Icon from "../Icon.astro";

interface Props {
  lang: Lang;
  market: Market;
  tag: string;
}
const { lang, market, tag } = Astro.props as Props;
const remote = lang === "es" ? "Atención remota en español" : "Remote service, in Spanish or English";
const t = translations[lang];
---

<div class="relative mx-auto max-w-xl" aria-hidden="true">
  <div class="lt-panel relative overflow-hidden rounded-[var(--radius-lg)] p-6 sm:p-8">
    <span
      class="grad-text pointer-events-none absolute -right-4 -top-8 select-none font-mono text-[9rem] font-bold leading-none opacity-20 sm:text-[11rem]"
    >
      {tag}
    </span>
    <div class="tech-grid pointer-events-none absolute inset-0 opacity-40"></div>

    <div class="relative flex items-center gap-3">
      <span class="lt-soft flex h-11 w-11 items-center justify-center rounded-xl">
        <Icon name="map-pin" class="h-5 w-5" />
      </span>
      <div>
        <p class="text-2xl font-bold tracking-tight text-[var(--text)]">{market.name}</p>
        <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]">{t.nav.markets}</p>
      </div>
    </div>

    <ol class="relative mt-7 grid gap-0">
      {
        market.cities.map((c, i) => (
          <li class="relative flex gap-4 pb-5 last:pb-0">
            {i < market.cities.length - 1 && (
              <span class="absolute left-[11px] top-7 h-[calc(100%-1.25rem)] w-px bg-[color:var(--border-strong)]"></span>
            )}
            <span class="lt-dot relative mt-1 flex h-6 w-6 flex-none items-center justify-center rounded-full text-[var(--bg)]">
              <span class="h-2 w-2 rounded-full bg-[var(--bg)]"></span>
            </span>
            <div class="min-w-0">
              <p class="text-sm font-bold text-[var(--text)]">{c.name}</p>
              <p class="mt-0.5 line-clamp-2 text-xs leading-5 text-[var(--muted)]">{c.note}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="relative mt-6 inline-flex items-center gap-2 rounded-full border border-[color:var(--border-strong)] px-3 py-1.5 text-xs font-semibold text-[var(--accent)]">
      <Icon name="globe" class="h-3.5 w-3.5" />
      {remote}
    </p>
  </div>
</div>
