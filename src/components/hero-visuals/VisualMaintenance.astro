---
/*
  Visual del hero de /servicios/mantenimiento-web/: un panel de estado del
  sitio con las tareas reales del plan (los títulos de «qué cubre»). Sin
  porcentajes de disponibilidad ni tiempos de respuesta: no hay un dato
  publicado que los respalde.
*/
import type { Lang } from "../../i18n/ui";
import Icon from "../Icon.astro";

interface Props {
  lang: Lang;
  pieces: readonly { title: string; icon: string }[];
}
const { lang, pieces } = Astro.props as Props;
const domain = lang === "es" ? "tunegocio.com" : "yourbusiness.com";
const online = lang === "es" ? "En línea" : "Online";
const done = lang === "es" ? "Al día" : "Up to date";
const monthly = lang === "es" ? "Plan mensual" : "Monthly plan";
---

<div class="relative mx-auto max-w-xl" aria-hidden="true">
  <div class="lt-panel overflow-hidden rounded-[var(--radius-lg)]">
    <div class="flex items-center gap-3 border-b border-[color:var(--border)] px-5 py-4">
      <span class="lt-soft flex h-9 w-9 items-center justify-center rounded-xl">
        <Icon name="shield" class="h-4.5 w-4.5" />
      </span>
      <div class="min-w-0">
        <p class="truncate font-mono text-xs text-[var(--text)]">{domain}</p>
        <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]">{monthly}</p>
      </div>
      <span class="ml-auto inline-flex items-center gap-2 rounded-full border border-[color:var(--border-strong)] px-3 py-1 text-xs font-bold text-[var(--accent)]">
        <span class="relative flex h-2 w-2">
          <span class="lt-dot absolute inline-flex h-full w-full animate-ping rounded-full opacity-60 motion-reduce:animate-none"></span>
          <span class="lt-dot relative inline-flex h-2 w-2 rounded-full"></span>
        </span>
        {online}
      </span>
    </div>

    <ul class="grid gap-2 p-4 sm:grid-cols-2">
      {
        pieces.slice(0, 6).map((p) => (
          <li class="flex items-center gap-3 rounded-xl bg-[var(--bg-2)]/70 px-3 py-3">
            <span class="lt-soft flex h-8 w-8 flex-none items-center justify-center rounded-lg">
              <Icon name={p.icon as any} class="h-4 w-4" />
            </span>
            <span class="min-w-0">
              <span class="block truncate text-xs font-semibold text-[var(--text)]">{p.title}</span>
              <span class="mt-0.5 inline-flex items-center gap-1 text-[10px] text-[var(--muted)]">
                <Icon name="check" class="h-3 w-3 text-[var(--accent)]" strokeWidth={2.6} />
                {done}
              </span>
            </span>
          </li>
        ))
      }
    </ul>

    {/* Línea de actividad decorativa: barras de igual altura, sin cifras. */}
    <div class="flex items-end gap-1.5 border-t border-[color:var(--border)] px-5 py-4">
      {Array.from({ length: 24 }).map(() => (
        <span class="lt-dot h-6 flex-1 rounded-sm opacity-70"></span>
      ))}
    </div>
  </div>
</div>
