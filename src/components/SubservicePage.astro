---
/*
  Página de subservicio (septiembre de 2026).

  Tres URLs comerciales que salieron del keyword research de arquitectura
  —landing pages, servicio de SEO y mantenimiento web— y que no podían
  rankear desde dentro de /servicios/desarrollo-web/.

  Sigue el orden común de las landings: hero → beneficios → cómo se
  trabaja → testimonios → para quién → fundador → qué incluye y precio →
  dudas (+ enlaces de vuelta a la página madre y a /precios/, que pide la
  matriz SEO) → cierre con agenda y formulario en la misma página.

  El contenido vive en src/i18n/subservices.ts.
*/
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import LandingHero from "./LandingHero.astro";
import VisualLanding from "./hero-visuals/VisualLanding.astro";
import VisualSeo from "./hero-visuals/VisualSeo.astro";
import VisualMaintenance from "./hero-visuals/VisualMaintenance.astro";
import ServiceIntro from "./ServiceIntro.astro";
import ServiceCapabilities from "./ServiceCapabilities.astro";
import ServicePackages from "./ServicePackages.astro";
import ServiceFit from "./ServiceFit.astro";
import Process from "./Process.astro";
import ProofStrip from "./ProofStrip.astro";
import Testimonials from "./Testimonials.astro";
import Founder from "./Founder.astro";
import FAQ from "./FAQ.astro";
import LandingConversion from "./LandingConversion.astro";
import Footer from "./Footer.astro";
import RelatedLinks from "./RelatedLinks.astro";
import { translations, PAGES, type Lang } from "../i18n/ui";
import { subservices, type SubserviceKey } from "../i18n/subservices";

interface Props {
  lang: Lang;
  service: SubserviceKey;
}
const { lang, service } = Astro.props as Props;
const t = translations[lang];
const d = subservices[lang][service];
// El mantenimiento se cobra al mes; el resto de precios publicados son de
// pago único. La periodicidad viaja al JSON-LD para que coincida con la
// tarjeta visible.
const isMonthly = (note: string) => /\bmes\b|month|\/mo\b/i.test(note);

const offerCatalog = [
  ...d.capabilities.items.map((c) => ({
    title: c.title,
    description: c.description,
  })),
  ...d.packages.items.map((p) => ({
    // Un paquete con `quoteLabel` no tiene cifra: escribir `$ ` aquí emitía
    // «SEO mensual — $ » en el JSON-LD (ver procode-planes-sin-precio).
    title: p.quoteLabel
      ? `${p.name} — ${p.quoteLabel}`
      : `${p.name} — ${p.pricePrefix ? p.pricePrefix + " " : ""}$${p.price} ${p.currency}`,
    description: p.description,
    ...(p.quoteLabel || !p.price
      ? {}
      : { minPrice: p.price, unit: isMonthly(p.priceNote) ? ("month" as const) : ("one-time" as const) }),
  })),
];

// El `price` del nodo Offer sale del primer paquete CON cifra de esta misma
// página; si ninguno la tiene, se emite sin precio en vez de heredar $349.
const pricedPackage = d.packages.items.find((p) => !p.quoteLabel && p.price);
const offerPrice = pricedPackage ? pricedPackage.price.replace(/,/g, "") : "";
const offerUnit = pricedPackage && isMonthly(pricedPackage.priceNote) ? "month" : "one-time";

// Cifra del hero: la del primer paquete publicado, tal cual sale en su
// tarjeta; si no hay ninguna con precio (SEO), su «cotización a medida».
const firstPkg = d.packages.items[0];
const heroStats = pricedPackage
  ? [{
      label: t.priceAnchor.fromLabel,
      value: `$${pricedPackage.price}`,
      note: `${pricedPackage.currency} · ${pricedPackage.priceNote}`,
    }]
  : firstPkg?.quoteLabel
    ? [{ label: lang === "es" ? "Inversión" : "Investment", value: firstPkg.quoteLabel }]
    : [];
// Búsqueda que se dibuja en el visual de SEO: la primera palabra clave de
// la propia página.
const heroQuery = d.meta.keywords.split(",")[0].trim();
---

<Layout
  lang={lang}
  page={service}
  title={d.meta.title}
  description={d.meta.description}
  keywords={d.meta.keywords}
  breadcrumbs={[
    { name: t.nav.home, path: PAGES.home[lang] },
    { name: t.nav.services, path: PAGES.services[lang] },
    { name: d.serviceName, path: PAGES[service][lang] },
  ]}
  serviceName={d.serviceName}
  audience={d.audience}
  offerCatalog={offerCatalog}
  offerPrice={offerPrice}
  offerUnit={offerUnit}
  includeFaq={true}
  faqItems={d.faq.items}
>
  <Header lang={lang} page={service} />
  <main>
    {/* 1 · Hero: propuesta, para quién es, precio publicado y los dos CTAs.
        El visual es propio de cada subservicio (
        hero-visuals/): anatomía de una landing, resultado de Google o
        panel de estado del sitio. */}
    <LandingHero
      lang={lang}
      page={service}
      eyebrow={d.badge}
      icon={d.icon}
      titleA={d.meta.heroTitleA}
      highlight={d.meta.heroHighlight}
      subtitle={d.meta.heroSubtitle}
      lead={`${d.audience}.`}
      stats={heroStats}
      extraLink={{ label: lang === "es" ? "Ver paquetes" : "See packages", href: "#paquetes" }}
    >
      <Fragment slot="visual">
        {service === "landingPages" && <VisualLanding lang={lang} pieces={d.capabilities.items} />}
        {service === "seo" && <VisualSeo lang={lang} query={heroQuery} pieces={d.capabilities.items} />}
        {service === "maintenance" && <VisualMaintenance lang={lang} pieces={d.capabilities.items} />}
      </Fragment>
    </LandingHero>

    {/* 2 · Beneficios: por qué así */}
    <ServiceIntro lang={lang} intro={d.intro} icon={d.icon} />

    {/* 3 · Así es como se trabaja. Los cinco pasos del sitio describen un
        proyecto de construcción, así que solo van en landing pages. SEO y
        mantenimiento no tienen un proceso propio publicado (PENDIENTE de
        definir); ahí esta posición la ocupan los proyectos reales. */}
    {service === "landingPages" && <Process lang={lang} />}
    <ProofStrip lang={lang} />

    {/* 4 · Testimonios publicados */}
    <Testimonials lang={lang} />

    {/* 5 · Para quién es y para quién no */}
    <ServiceFit lang={lang} fit={d.fit} />

    {/* 6 · El desarrollador y fundador */}
    <Founder lang={lang} page={service} />

    {/* 7 · Información práctica: qué incluye y precio publicado */}
    <ServiceCapabilities
      lang={lang}
      heading={{
        eyebrow: d.capabilities.eyebrow,
        title: d.capabilities.title,
        subtitle: d.capabilities.subtitle,
      }}
      items={d.capabilities.items}
    />
    <ServicePackages lang={lang} packages={d.packages} />

    {/* 8 · Preguntas frecuentes */}
    <FAQ lang={lang} data={d.faq} id="dudas-servicio" />
    <RelatedLinks data={d.related} />

    {/* 9 · Cierre: agenda y formulario (Nombre + Email) en esta página */}
    <LandingConversion
      lang={lang}
      page={service}
      close={{ eyebrow: `// ${d.navLabel}`, title: d.meta.heroSubtitle }}
      formHeading={d.form}
      service={d.serviceName}
    />
  </main>
  <Footer lang={lang} />
</Layout>
