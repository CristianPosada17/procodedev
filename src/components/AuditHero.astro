---
/*
  Portada de la Auditoría Digital.

  A diferencia del hero de una línea de servicio, aquí el precio es cerrado
  ($250, no «desde») y va acompañado de la nota de que NO se acredita: es la
  objeción número uno y esconderla hasta la FAQ solo la retrasa.
*/
import { translations, PAGES, type Lang } from "../i18n/ui";
import { audit } from "../i18n/audit";
import Icon from "./Icon.astro";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const a = audit[lang];

const stats = [
  { label: a.priceLabel, value: `$${a.price}`, note: a.priceNote },
  { label: a.timelineLabel, value: a.timeline, note: "" },
];

// Columna decorativa con las nueve áreas, igual que `PageHero`. Las otras
// páginas de servicio llenan ese hueco con el mockup del servicio; la
// auditoría no tiene captura que enseñar, y su argumento ES el alcance, así
// que el alcance hace de imagen. Se duplica para el bucle, va `aria-hidden`
// y con `<p>` en vez de encabezados: si fueran <h3> el esquema saltaría de
// h1 a h3 y las nueve frases se contarían dos veces.
const seq = [...a.areas.items, ...a.areas.items];
---

<section class="relative overflow-hidden pb-10 pt-8 lg:pb-16 lg:pt-16">
  <div
    class="mx-auto grid w-full max-w-[1480px] items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.08fr_0.92fr] lg:px-10 2xl:max-w-[1600px]"
  >
    {/* Arriba del pliegue: sin `.reveal`, no debe depender de JS. */}
    <div class="max-w-2xl">
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={PAGES.services[lang]}
          class="inline-flex items-center gap-1.5 rounded-full border border-[color:var(--border)] bg-[var(--tint)] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)] transition hover:border-[color:var(--border-strong)] hover:text-[var(--accent)]"
        >
          <Icon name="arrow-right" class="h-3 w-3 rotate-180" />
          {t.nav.services}
        </a>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-[color:var(--border-strong)] bg-[var(--brand)]/15 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--accent)]"
        >
          <Icon name="clipboard-check" class="h-3.5 w-3.5" />
          {a.badge}
        </span>
      </div>

      <h1
        class="mt-6 text-[2.5rem] font-bold leading-[1.06] tracking-tight text-[var(--text)] sm:text-[3.3rem] lg:text-[3.9rem]"
      >
        {a.meta.heroTitleA}{" "}<span class="grad-text">{a.meta.heroHighlight}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-[var(--muted)] sm:text-lg">
        {a.meta.heroSubtitle}
      </p>

      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-5">
        {
          stats.map((stat) => (
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--muted)]">
                {stat.label}
              </dt>
              <dd class="mt-1.5 text-2xl font-bold tracking-tight text-[var(--text)]">
                {stat.value}
                {stat.note && (
                  <span class="ml-2 align-middle text-xs font-medium text-[var(--muted)]">
                    {stat.note}
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#solicitar"
          data-cta="hero-auditoria-solicitar"
          class="inline-flex items-center gap-2 rounded-xl bg-[var(--brand)] px-6 py-4 text-sm font-bold text-white shadow-[0_0_45px_var(--halo-brand)] transition hover:-translate-y-0.5 hover:bg-[var(--brand-strong)]"
        >
          {a.ctaPrimary}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a
          href="#que-se-audita"
          class="inline-flex items-center gap-2 rounded-xl border border-[color:var(--border-strong)] bg-[var(--tint)] px-6 py-4 text-sm font-bold text-[var(--text)] transition hover:-translate-y-0.5 hover:bg-[var(--brand)]/12"
        >
          {a.areas.title}
        </a>
      </div>
    </div>

    <div
      class="marquee-y reveal reveal-right relative hidden h-[460px] overflow-hidden lg:block"
      style="--marquee-duration: 34s"
      aria-hidden="true"
    >
      <div class="absolute -inset-6 rounded-[2rem] bg-[var(--brand)]/5 blur-3xl"></div>
      <div class="marquee-track-y relative flex flex-col gap-4">
        {
          seq.map((area) => (
            <div class="flex items-start gap-4 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-5 backdrop-blur-xl">
              <span class="flex h-11 w-11 flex-none items-center justify-center rounded-xl bg-[var(--brand)]/10 text-[var(--accent)]">
                <Icon name={area.icon as any} class="h-5 w-5" />
              </span>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--accent)]">
                  {a.navLabel}
                </p>
                <p class="mt-1 text-sm font-bold leading-snug text-[var(--text)]">
                  {area.title}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
