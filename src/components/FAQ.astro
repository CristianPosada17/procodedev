---
import { translations, PAGES, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
const t = translations[lang];
const f = t.faq;
---

<section id="faq" class="relative py-20">
  <div class="mx-auto w-full max-w-[900px] px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow={f.eyebrow} align="center" max="max-w-2xl">
      <Fragment slot="title">
        {f.titleA}{" "}<span class="grad-text">{f.titleHighlight}</span>
      </Fragment>
      <Fragment slot="subtitle">{f.subtitle}</Fragment>
    </SectionHeading>

    <div class="mt-10 grid gap-3">
      {
        f.items.map((item, i) => (
          <details
            class="reveal group rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-5 backdrop-blur-xl transition hover:border-[color:var(--border-strong)] open:border-[color:var(--border-strong)]"
            style={`--reveal-delay: ${i * 50}ms`}
          >
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-semibold text-[var(--text)] marker:content-['']">
              {item.question}
              <span class="flex-none text-[var(--accent)] transition group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{item.answer}</p>
          </details>
        ))
      }
    </div>

    <div class="reveal mt-8 text-center text-sm text-[var(--muted)]">
      {f.moreQuestion}{" "}
      <a href={PAGES.contact[lang]} class="font-semibold text-[var(--accent)] hover:underline">
        {t.nav.contact} →
      </a>
    </div>
  </div>
</section>
