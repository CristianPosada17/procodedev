---
import { translations, PAGES, type Lang } from "../i18n/ui";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
interface FaqData {
  eyebrow: string;
  titleA: string;
  titleHighlight: string;
  subtitle: string;
  items: readonly { question: string; answer: string }[];
}
interface Props {
  lang?: Lang;
  /**
   * "full"  → el FAQ completo de /precios.
   * "home"  → 4 objeciones justo antes del CTA final del home (hallazgo #18):
   *           el home y /contacto son donde se decide y no respondían nada.
   */
  variant?: "full" | "home";
  /** FAQ propia de la página (servicios). Tiene prioridad sobre `variant`.
   *  El JSON-LD FAQPage tiene que recibir exactamente estas mismas
   *  preguntas por la prop `faqItems` del Layout. */
  data?: FaqData;
  /** Id del <section>, para no repetir "faq" si conviven dos en una página. */
  id?: string;
}
const { lang = "es", variant = "full", data, id } = Astro.props as Props;
const t = translations[lang];
const f = data ?? (variant === "home" ? t.homeFaq : t.faq);
const items = f.items;
---

<section
  id={id ?? (variant === "home" ? "dudas" : "faq")}
  class:list={[
    variant === "home" ? "py-16 lg:py-24" : "py-16 lg:py-24",
    "band-mist relative",
  ]}
>
  <div class="mx-auto w-full max-w-[900px] px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow={f.eyebrow} align="center" max="max-w-2xl">
      <Fragment slot="title">
        {f.titleA}{" "}<span class="grad-text">{f.titleHighlight}</span>
      </Fragment>
      <Fragment slot="subtitle">{f.subtitle}</Fragment>
    </SectionHeading>

    <div class="mt-10 grid gap-3">
      {
        items.map((item, i) => (
          <details
            class="reveal group rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/75 px-6 py-5 backdrop-blur-xl transition duration-300 hover:border-[color:var(--border-strong)] open:border-[color:var(--border-strong)] open:shadow-[0_30px_70px_-45px_var(--halo-card-strong)]"
            style={`--reveal-delay: ${i * 50}ms`}
          >
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-[15px] font-semibold text-[var(--text)] marker:content-['']">
              <span class="flex items-baseline gap-4">
                <span class="num-mark w-7 flex-none font-mono text-sm" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span>{item.question}</span>
              </span>
              <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full border border-[color:var(--border-strong)] text-[var(--accent)] transition duration-300 group-open:rotate-45 group-open:bg-[var(--brand)] group-open:text-white">
                <Icon name="plus" class="h-4 w-4" strokeWidth={2.2} />
              </span>
            </summary>
            <p class="mt-3 pl-11 text-sm leading-7 text-[var(--muted)]">{item.answer}</p>
          </details>
        ))
      }
    </div>

    {
      variant === "full" && !data && (
        <div class="reveal mt-8 text-center text-sm text-[var(--muted)]">
          {t.faq.moreQuestion}{" "}
          <a
            href={PAGES.contact[lang]}
            class="font-semibold text-[var(--accent)] hover:underline"
          >
            {t.nav.contact}
          </a>
        </div>
      )
    }
  </div>
</section>
