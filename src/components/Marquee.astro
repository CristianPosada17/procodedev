---
import { type Lang } from "../i18n/ui";
import { serviceLines, SERVICE_KEYS } from "../i18n/services";
import Icon from "./Icon.astro";
interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props as Props;
// Etiquetas para la tira: el nombre de cada servicio y sus capacidades.
// Se duplican para un loop continuo.
const items = SERVICE_KEYS.flatMap((key) => {
  const line = serviceLines[lang][key];
  return [line.title, ...line.capabilities.map((c) => c.title)];
});
const seq = [...items, ...items];
---

<section class="relative pb-6 pt-2 lg:pb-8 lg:pt-3" aria-hidden="true">
  <div class="marquee-x relative overflow-hidden">
    <div class="marquee-track-x flex w-max items-center gap-4 pr-4">
      {
        seq.map((label) => (
          <span class="flex items-center gap-3 whitespace-nowrap rounded-full border border-[color:var(--border)] bg-[var(--surface)]/50 px-5 py-2.5 text-sm text-[var(--muted)] backdrop-blur-sm">
            <Icon name="diamond" class="h-3 w-3 text-[var(--accent)]" />
            {label}
          </span>
        ))
      }
    </div>
  </div>
</section>
