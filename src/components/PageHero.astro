---
import { translations, type Lang } from "../i18n/ui";
import { serviceLines, SERVICE_KEYS } from "../i18n/services";
import Icon from "./Icon.astro";

interface Props {
  eyebrow: string;
  titleA: string;
  highlight: string;
  subtitle: string;
  lang?: Lang;
  /** Botón principal del hero. En /servicios apunta al formulario de la
      misma página: antes el bloque de entrada explicaba la oferta y no
      ofrecía ninguna forma de pedir ayuda sin navegar a otra URL. */
  ctaLabel?: string;
  ctaHref?: string;
  ctaId?: string;
  /** Segunda opción, para quien prefiere hablar antes de escribir. */
  ctaSecondaryLabel?: string;
  ctaSecondaryHref?: string;
}
const {
  eyebrow,
  titleA,
  highlight,
  subtitle,
  lang = "es",
  ctaLabel,
  ctaHref,
  ctaId,
  ctaSecondaryLabel,
  ctaSecondaryHref,
} = Astro.props as Props;
const t = translations[lang];
// Columna vertical que se desplaza sola (llena el espacio a la derecha del
// título). Desde la especialización en dos servicios las tarjetas salen de
// las capacidades de cada línea: doce en vez de seis, y siguen etiquetadas
// con el servicio al que pertenecen.
const cards = SERVICE_KEYS.flatMap((key) => {
  const line = serviceLines[lang][key];
  return line.capabilities.map((cap) => ({
    icon: cap.icon,
    category: line.title,
    title: cap.title,
  }));
});
const seq = [...cards, ...cards];
---

<section class="relative overflow-hidden pb-8 pt-8 lg:pb-14 lg:pt-20">
  <div
    class="mx-auto grid w-full max-w-[1480px] items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-10 2xl:max-w-[1600px]"
  >
    {/* Above-the-fold sin `.reveal`: el H1 y el subtítulo no deben depender
        de JS para ser visibles (hallazgo #14). */}
    <div class="max-w-2xl">
      <span class="eyebrow">{eyebrow}</span>
      <h1
        class="mt-5 text-[2.6rem] font-bold leading-[1.06] tracking-tight text-[var(--text)] sm:text-[3.45rem] lg:text-[4.3rem]"
      >
        {titleA}{" "}<span class="grad-text">{highlight}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-[var(--muted)] sm:text-lg">
        {subtitle}
      </p>

      {
        ctaLabel && ctaHref && (
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={ctaHref}
              data-cta={ctaId || "pagehero-cta"}
              class="inline-flex items-center gap-2 rounded-xl bg-[var(--brand)] px-6 py-4 text-sm font-bold text-white shadow-[0_0_45px_var(--halo-brand)] transition hover:-translate-y-0.5 hover:bg-[var(--brand-strong)]"
            >
              {ctaLabel}
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
            {ctaSecondaryLabel && ctaSecondaryHref && (
              <a
                href={ctaSecondaryHref}
                data-cta={`${ctaId || "pagehero"}-secundario`}
                class="inline-flex items-center gap-2 rounded-xl border border-[color:var(--border-strong)] bg-[var(--tint)] px-6 py-4 text-sm font-bold text-[var(--text)] transition hover:-translate-y-0.5 hover:bg-[var(--brand)]/12"
              >
                {ctaSecondaryLabel}
              </a>
            )}
          </div>
        )
      }
    </div>

    {/* Columna decorativa: se duplica para el loop, así que va marcada como
        aria-hidden y sin encabezados — si fueran <h3> el esquema de la página
        saltaría de h1 a h3 y las mismas seis frases aparecerían dos veces. */}
    <div
      class="marquee-y reveal reveal-right relative hidden h-[440px] overflow-hidden lg:block"
      style="--marquee-duration: 30s"
      aria-hidden="true"
    >
      <div class="absolute -inset-6 rounded-[2rem] bg-[var(--brand)]/5 blur-3xl"></div>
      <div class="marquee-track-y relative flex flex-col gap-4">
        {
          seq.map((card) => (
            <div class="flex items-start gap-4 rounded-[var(--radius)] border border-[color:var(--border)] bg-[var(--surface)]/60 p-5 backdrop-blur-xl">
              <span class="flex h-11 w-11 flex-none items-center justify-center rounded-xl bg-[var(--brand)]/10 text-[var(--accent)]">
                <Icon name={card.icon as any} class="h-5 w-5" />
              </span>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--accent)]">
                  {card.category}
                </p>
                <p class="mt-1 text-sm font-bold leading-snug text-[var(--text)]">
                  {card.title}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
