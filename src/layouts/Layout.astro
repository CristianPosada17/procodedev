---
import "../styles/global.css";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import MobileCTABar from "../components/MobileCTABar.astro";
import {
  translations,
  PAGES,
  type Lang,
  type PageKey,
} from "../i18n/ui";

// ====== IDs DE MEDICIÓN (rellena cuando los tengas; si quedan vacíos, no cargan) ======
const GA_MEASUREMENT_ID = "G-LPJ6DT1WZZ";
const META_PIXEL_ID = "1741784446953946";
const GSC_VERIFICATION = "";

// Scripts de medición como cadenas (se arman aquí; quedan vacías si no hay IDs).
const gaSnippet = GA_MEASUREMENT_ID
  ? `var gse=document.createElement('script');gse.async=true;gse.src='https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}';document.head.appendChild(gse);window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_MEASUREMENT_ID}');`
  : "";
const pixelSnippet = META_PIXEL_ID
  ? `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${META_PIXEL_ID}');fbq('track','PageView');`
  : "";
const analyticsBootstrap = [gaSnippet, pixelSnippet].filter(Boolean).join("\n");
const pixelNoscript = META_PIXEL_ID
  ? `<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1"/>`
  : "";

interface Props {
  lang?: Lang;
  page?: PageKey;
  /** Contexto del botón flotante de WhatsApp (hallazgo #17). El blog no es
   *  una PageKey —no tiene equivalente hreflang— pero sí necesita su mensaje. */
  waPage?: PageKey | "blog";
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  includeFaq?: boolean;
  /** Qué set de preguntas emitir en el JSON-LD. Debe coincidir con el
   *  `variant` del componente FAQ que renderiza la página: Google exige que el
   *  marcado de FAQPage corresponda al contenido visible. */
  faqVariant?: "full" | "home";
}

const {
  lang = "es",
  page = "home",
  waPage,
  title,
  description,
  image = "/og-image.jpg",
  noindex = false,
  includeFaq = false,
  faqVariant = "full",
} = Astro.props as Props;

const t = translations[lang];
const htmlLang = lang === "es" ? "es" : "en";
const ogLocale = lang === "es" ? "es_US" : "en_US";

const metaTitle = title ?? t.pageMeta.home.title;
const metaDescription = description ?? t.pageMeta.home.description;

// URLs canónicas y alternas para hreflang.
const siteUrl = Astro.site ?? new URL("https://procodedev.com");
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL(image, siteUrl);
const esAltURL = new URL(PAGES[page].es, siteUrl);
const enAltURL = new URL(PAGES[page].en, siteUrl);

// Datos estructurados (JSON-LD)
const orgNode = {
  "@type": "ProfessionalService",
  "@id": `${siteUrl}#organization`,
  name: "ProCode Dev",
  url: siteUrl.toString(),
  image: socialImage.toString(),
  description: metaDescription,
  email: "info@procodedev.com",
  telephone: "+52-614-241-4255",
  priceRange: "$349-$1499",
  founder: { "@type": "Person", name: "Cristian Posada" },
  // El mercado principal es el negocio de servicios latino en EE. UU.
  // (análisis de mercado de agosto de 2026). El servicio se presta en remoto,
  // así que no se declara una dirección física de atención al público.
  areaServed: [
    { "@type": "Country", name: "United States" },
    { "@type": "Country", name: "México" },
  ],
  serviceType: [
    "Website design for tax preparers",
    "Google Business Profile management",
    "Review management",
    "Local SEO",
  ],
  audience: {
    "@type": "Audience",
    audienceType:
      "Tax preparers, bookkeepers, enrolled agents and CPAs in the United States",
  },
  availableLanguage: ["Spanish", "English"],
  sameAs: [
    "https://www.instagram.com/procode.systems/",
    "https://www.linkedin.com/in/cristian-posada-891401291/",
    "https://www.facebook.com/ProCodeSystems",
  ],
};

const websiteNode = {
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  url: siteUrl.toString(),
  name: "ProCode Dev",
  description: metaDescription,
  publisher: { "@id": `${siteUrl}#organization` },
  inLanguage: lang === "es" ? "es-US" : "en-US",
};

const faqSource = faqVariant === "home" ? t.homeFaq : t.faq;

const faqNode = includeFaq
  ? {
      "@type": "FAQPage",
      "@id": `${canonicalURL}#faq`,
      mainEntity: faqSource.items.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    }
  : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [orgNode, websiteNode, ...(faqNode ? [faqNode] : [])],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#060b18" />
    {GSC_VERIFICATION && (
      <meta name="google-site-verification" content={GSC_VERIFICATION} />
    )}

    <!-- ============ SEO PRINCIPAL ============ -->
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta
      name="keywords"
      content="paginas web para preparadores de impuestos, website for tax preparers, bookkeeper website, tax office website, paginas web en español, perfil de empresa en google, google business profile, gestión de reseñas, SEO local, landing pages, ProCode Dev"
    />
    <meta name="author" content="ProCode Dev" />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="geo.region" content="US" />
    <meta name="geo.placename" content="United States" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esAltURL} />
    <link rel="alternate" hreflang="en" href={enAltURL} />
    <link rel="alternate" hreflang="x-default" href={esAltURL} />

    <!-- ============ OPEN GRAPH ============ -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ProCode Dev" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ProCode Dev — Desarrollo web estratégico" />

    <!-- ============ TWITTER / X ============ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />

    <!-- ============ ICONOS ============ -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="ProCode Dev" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- ============ FUENTES ============ -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- ============ DATOS ESTRUCTURADOS (JSON-LD) ============ -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <noscript>
      <style>
        .reveal,
        .reveal-left,
        .reveal-right,
        .reveal-scale {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <!-- ============ MEDICIÓN (Google Analytics 4 + Meta Pixel) ============ -->
    <script is:inline set:html={analyticsBootstrap}></script>
    <noscript set:html={pixelNoscript}></noscript>
  </head>

  <!-- pb-24 en móvil deja aire para la barra CTA fija; en lg+ no existe. -->
  <body
    class="min-h-screen bg-[var(--bg)] pb-24 text-[var(--text)] antialiased lg:pb-0"
  >
    <div class="fixed inset-0 -z-10 overflow-hidden bg-[var(--bg)]">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(37,99,235,0.16),transparent_38%),radial-gradient(circle_at_top_right,rgba(56,189,248,0.12),transparent_32%),linear-gradient(180deg,#060b18_0%,#0a1224_45%,#060b18_100%)]"
      >
      </div>

      <div class="tech-grid absolute inset-0 opacity-40"></div>

      <div
        class="absolute left-1/2 top-0 h-[520px] w-[520px] -translate-x-1/2 rounded-full bg-blue-500/10 blur-[130px]"
      >
      </div>
    </div>

    <slot />

    <WhatsAppFloat lang={lang} page={waPage ?? page} />
    <MobileCTABar lang={lang} page={waPage ?? page} />

    <!-- ============ ANIMACIONES (reveal al hacer scroll) ============ -->
    <script>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // El contador animado de [data-count] se retiró junto con las cifras
      // sin fuente del hero (+248% leads / 9.8% conversión estimada), que la
      // auditoría marcó como bandera roja de credibilidad (hallazgo #8).
    </script>
  </body>
</html>
