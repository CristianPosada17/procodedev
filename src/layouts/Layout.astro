---
import "../styles/global.css";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import MobileCTABar from "../components/MobileCTABar.astro";
import Analytics from "../components/Analytics.astro";
import AnalyticsEvents from "../components/AnalyticsEvents.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import { MEASUREMENT } from "../lib/measurement";
import {
  translations,
  PAGES,
  type Lang,
  type PageKey,
} from "../i18n/ui";

// Los IDs de medición y toda la lógica de GA4 / Pixel / Consent Mode viven
// en src/lib/measurement.ts y en los componentes Analytics*, no aquí.

interface Props {
  lang?: Lang;
  page?: PageKey;
  /** Contexto del botón flotante de WhatsApp (hallazgo #17). El blog no es
   *  una PageKey —no tiene equivalente hreflang— pero sí necesita su mensaje. */
  waPage?: PageKey | "blog";
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  includeFaq?: boolean;
  /** Qué set de preguntas emitir en el JSON-LD. Debe coincidir con el
   *  `variant` del componente FAQ que renderiza la página: Google exige que el
   *  marcado de FAQPage corresponda al contenido visible. */
  faqVariant?: "full" | "home";
  /** FAQ propia de la página (segmentos). Tiene prioridad sobre `faqVariant`. */
  faqItems?: readonly { question: string; answer: string }[];
  /** Migas de pan para el JSON-LD; el `name` es el texto visible en la página. */
  breadcrumbs?: { name: string; path: string }[];
  /** Servicio concreto que describe la página, para el nodo Service. */
  serviceName?: string;
  /** Palabras clave propias de la página. Sin esto todas heredaban las del
   *  home, que es exactamente la señal de contenido duplicado que hay que
   *  evitar cuando hay cinco páginas de giro parecidas entre sí. */
  keywords?: string;
  /** Catálogo de lo que incluye el servicio de esta página (nodo Service →
   *  hasOfferCatalog). Es lo que permite a un buscador con IA responder «qué
   *  incluye» sin tener que interpretar el HTML. */
  offerCatalog?: readonly { title: string; description: string }[];
  /** Lista de páginas hijas, para el hub de giros (nodo ItemList). */
  itemList?: readonly { name: string; description: string; url: string }[];
  /** Público concreto de la página, para el nodo Service. */
  audience?: string;
}

const {
  lang = "es",
  page = "home",
  waPage,
  title,
  description,
  image = "/og-image.jpg",
  noindex = false,
  includeFaq = false,
  faqVariant = "full",
  faqItems,
  breadcrumbs,
  serviceName,
  keywords,
  offerCatalog,
  itemList,
  audience,
} = Astro.props as Props;

const t = translations[lang];
const htmlLang = lang === "es" ? "es" : "en";
// Fecha de la última revisión editorial del sitio. Se emite en el JSON-LD y
// en Open Graph: una página sin señal de frescura compite en desventaja.
const CONTENT_REVIEWED = "2026-08-25";
const ogLocale = lang === "es" ? "es_US" : "en_US";

const metaTitle = title ?? t.pageMeta.home.title;
const metaDescription = description ?? t.pageMeta.home.description;

// URLs canónicas y alternas para hreflang.
const siteUrl = Astro.site ?? new URL("https://procodedev.com");
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL(image, siteUrl);
// La canónica sale de `Astro.url.pathname`, que en build estático siempre
// lleva barra final. Los hreflang salen de PAGES, que no la lleva. Dos formas
// distintas de la misma URL en la misma página es exactamente la señal
// contradictoria que hay que evitar, así que se normalizan aquí.
const withSlash = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const esAltURL = new URL(withSlash(PAGES[page].es), siteUrl);
const enAltURL = new URL(withSlash(PAGES[page].en), siteUrl);

// Datos estructurados (JSON-LD)
const orgNode = {
  "@type": "ProfessionalService",
  "@id": `${siteUrl}#organization`,
  name: "ProCode Dev",
  url: siteUrl.toString(),
  image: socialImage.toString(),
  description: metaDescription,
  email: "info@procodedev.com",
  telephone: "+52-614-241-4255",
  priceRange: "$349-$1499",
  founder: { "@type": "Person", name: "Cristian Posada" },
  // El mercado principal es el negocio de servicios latino en EE. UU.
  // (análisis de mercado de agosto de 2026). El servicio se presta en remoto,
  // así que no se declara una dirección física de atención al público.
  areaServed: [
    { "@type": "Country", name: "United States" },
    { "@type": "Country", name: "México" },
  ],
  slogan: "Digital Growth Systems for Small Businesses",
  serviceType: [
    "Website design for small businesses",
    "Client acquisition and local SEO",
    "Client intake and document collection",
    "Marketing automation and follow-up",
    "Google Business Profile management",
    "Review management",
    "Marketing analytics and reporting",
  ],
  knowsAbout: [
    "Contractors and construction companies",
    "Clinics and private practices",
    "Professional services",
    "Real estate agents",
    "Accounting and tax practices",
    "Small business marketing",
  ],
  audience: {
    "@type": "Audience",
    audienceType:
      "Small business owners in the United States and Mexico: contractors, clinics and private practices, professional services, real estate agents and accounting practices",
  },
  availableLanguage: ["Spanish", "English"],
  sameAs: [
    "https://www.instagram.com/procode.systems/",
    "https://www.linkedin.com/in/cristian-posada-891401291/",
    "https://www.facebook.com/ProCodeSystems",
  ],
};

const websiteNode = {
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  url: siteUrl.toString(),
  name: "ProCode Dev",
  description: metaDescription,
  publisher: { "@id": `${siteUrl}#organization` },
  inLanguage: lang === "es" ? "es-US" : "en-US",
};

// Nodo de la página. Sin él, el grafo describe la organización y el servicio
// pero no la página concreta que se está sirviendo, que es justo lo que un
// buscador necesita para decidir qué mostrar en el resultado.
const webPageNode = {
  "@type": "WebPage",
  "@id": `${canonicalURL}#webpage`,
  url: canonicalURL.toString(),
  name: metaTitle,
  description: metaDescription,
  inLanguage: lang === "es" ? "es-US" : "en-US",
  isPartOf: { "@id": `${siteUrl}#website` },
  about: { "@id": `${siteUrl}#organization` },
  primaryImageOfPage: socialImage.toString(),
  datePublished: "2026-07-31",
  dateModified: CONTENT_REVIEWED,
  ...(breadcrumbs?.length
    ? { breadcrumb: { "@id": `${canonicalURL}#breadcrumb` } }
    : {}),
  potentialAction: {
    "@type": "ReadAction",
    target: [canonicalURL.toString()],
  },
};

const faqSource = faqItems ?? (faqVariant === "home" ? t.homeFaq : t.faq).items;

const faqNode = includeFaq
  ? {
      "@type": "FAQPage",
      "@id": `${canonicalURL}#faq`,
      mainEntity: faqSource.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    }
  : null;

// Migas de pan: las páginas de oficio cuelgan del hub del nicho, y decírselo
// a Google explícitamente es lo que evita que las trate como seis landings
// sueltas compitiendo entre sí.
const breadcrumbNode = breadcrumbs?.length
  ? {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumb`,
      itemListElement: breadcrumbs.map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: new URL(b.path, siteUrl).toString(),
      })),
    }
  : null;

const serviceNode = serviceName
  ? {
      "@type": "Service",
      "@id": `${canonicalURL}#service`,
      name: serviceName,
      description: metaDescription,
      serviceType: "Digital growth systems for small businesses",
      provider: { "@id": `${siteUrl}#organization` },
      areaServed: [
        { "@type": "Country", name: "United States" },
        { "@type": "Country", name: "México" },
      ],
      availableLanguage: ["English", "Spanish"],
      ...(audience
        ? { audience: { "@type": "Audience", audienceType: audience } }
        : {}),
      offers: {
        "@type": "Offer",
        priceCurrency: "USD",
        price: "349",
        priceValidUntil: "2027-12-31",
        availability: "https://schema.org/InStock",
        url: new URL(PAGES.pricing[lang], siteUrl).toString(),
      },
      ...(offerCatalog?.length
        ? {
            hasOfferCatalog: {
              "@type": "OfferCatalog",
              name: serviceName,
              itemListElement: offerCatalog.map((o, i) => ({
                "@type": "Offer",
                position: i + 1,
                itemOffered: {
                  "@type": "Service",
                  name: o.title,
                  description: o.description,
                },
              })),
            },
          }
        : {}),
    }
  : null;

// Hub de giros: la lista explícita de páginas hijas es lo que hace que un
// buscador entienda /negocios como índice y no como una landing más.
const itemListNode = itemList?.length
  ? {
      "@type": "ItemList",
      "@id": `${canonicalURL}#itemlist`,
      itemListOrder: "https://schema.org/ItemListUnordered",
      numberOfItems: itemList.length,
      itemListElement: itemList.map((it, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: it.name,
        description: it.description,
        url: new URL(it.url, siteUrl).toString(),
      })),
    }
  : null;

// Palabras clave: propias de la página cuando las declara, y solo si no,
// las generales del sitio.
const DEFAULT_KEYWORDS =
  lang === "es"
    ? "páginas web para negocios, sitios web para pymes, página web para contratistas, página web para consultorios, página web para inmobiliarias, página web para despachos contables, perfil de empresa en google, SEO local, automatización de seguimiento, ProCode Dev"
    : "small business website, website for contractors, website for clinics, real estate agent website, accounting firm website, google business profile, local SEO, follow-up automation, bilingual website, ProCode Dev";
const pageKeywords = keywords ?? DEFAULT_KEYWORDS;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    orgNode,
    websiteNode,
    webPageNode,
    ...(breadcrumbNode ? [breadcrumbNode] : []),
    ...(serviceNode ? [serviceNode] : []),
    ...(itemListNode ? [itemListNode] : []),
    ...(faqNode ? [faqNode] : []),
  ],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#060b18" />
    {MEASUREMENT.gscVerification && (
      <meta
        name="google-site-verification"
        content={MEASUREMENT.gscVerification}
      />
    )}

    <!-- ============ SEO PRINCIPAL ============ -->
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="ProCode Dev" />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="geo.region" content="US" />
    <meta name="geo.placename" content="United States" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esAltURL} />
    <link rel="alternate" hreflang="en" href={enAltURL} />
    <link rel="alternate" hreflang="x-default" href={esAltURL} />

    <!-- ============ OPEN GRAPH ============ -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ProCode Dev" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={metaTitle} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="article:modified_time" content={CONTENT_REVIEWED} />

    <!-- ============ TWITTER / X ============ -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />

    <!-- ============ ICONOS ============ -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="ProCode Dev" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- ============ FUENTES ============ -->
    {/* La foto del hero es el LCP del home: se precarga para que pinte antes
        que cualquier otro recurso. */}
    {page === "home" && (
      <link rel="preload" as="image" href="/images/hero-lobby.webp" fetchpriority="high" />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- ============ DATOS ESTRUCTURADOS (JSON-LD) ============ -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <noscript>
      <style>
        .reveal,
        .reveal-left,
        .reveal-right,
        .reveal-scale {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <!-- ============ MEDICIÓN (Consent Mode v2 + GA4 + Meta Pixel) ============ -->
    <Analytics lang={lang} page={waPage ?? page} />
  </head>

  <!-- pb-24 en móvil deja aire para la barra CTA fija; en lg+ no existe. -->
  <body
    class="min-h-screen bg-[var(--bg)] pb-24 text-[var(--text)] antialiased lg:pb-0"
  >
    <div class="fixed inset-0 -z-10 overflow-hidden bg-[var(--bg)]">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(37,99,235,0.16),transparent_38%),radial-gradient(circle_at_top_right,rgba(56,189,248,0.12),transparent_32%),linear-gradient(180deg,#060b18_0%,#0a1224_45%,#060b18_100%)]"
      >
      </div>

      <div class="tech-grid absolute inset-0 opacity-40"></div>

      <div
        class="absolute left-1/2 top-0 h-[520px] w-[520px] -translate-x-1/2 rounded-full bg-blue-500/10 blur-[130px]"
      >
      </div>
    </div>

    <slot />

    <WhatsAppFloat lang={lang} page={waPage ?? page} />
    <MobileCTABar lang={lang} page={waPage ?? page} />

    <!-- ============ MEDICIÓN: eventos y consentimiento ============ -->
    <AnalyticsEvents lang={lang} page={waPage ?? page} />
    <ConsentBanner lang={lang} />

    <!-- ============ ANIMACIONES (reveal al hacer scroll) ============ -->
    <script>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // El contador animado de [data-count] se retiró junto con las cifras
      // sin fuente del hero (+248% leads / 9.8% conversión estimada), que la
      // auditoría marcó como bandera roja de credibilidad (hallazgo #8).

      // ── Carruseles de tarjetas (solo móvil) ──────────────────
      // En escritorio los puntos quedan ocultos por CSS; el JS solo los
      // construye y sincroniza con el scroll horizontal.
      document.querySelectorAll<HTMLElement>("[data-rail]").forEach((rail) => {
        const track = rail.querySelector<HTMLElement>(".card-rail-track");
        const dots = rail.querySelector<HTMLElement>("[data-rail-dots]");
        if (!track || !dots) return;
        const cards = Array.from(track.children) as HTMLElement[];
        if (cards.length < 2) return;

        cards.forEach((_, i) => {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "card-rail-dot";
          dot.setAttribute("aria-label", String(i + 1));
          dot.addEventListener("click", () => {
            track.scrollTo({
              left: cards[i].offsetLeft - (track.clientWidth - cards[i].offsetWidth) / 2,
              behavior: "smooth",
            });
          });
          dots.appendChild(dot);
        });

        const dotEls = Array.from(dots.children) as HTMLElement[];
        let ticking = false;
        const sync = () => {
          ticking = false;
          const center = track.scrollLeft + track.clientWidth / 2;
          let best = 0;
          let bestDist = Infinity;
          cards.forEach((card, i) => {
            const dist = Math.abs(card.offsetLeft + card.offsetWidth / 2 - center);
            if (dist < bestDist) {
              bestDist = dist;
              best = i;
            }
          });
          dotEls.forEach((d, i) => d.classList.toggle("is-active", i === best));
        };
        track.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(sync);
            }
          },
          { passive: true },
        );
        sync();
      });
    </script>
  </body>
</html>
